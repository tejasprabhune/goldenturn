---
import '../styles/global.css';
// Plain CSS rather than a Tailwind layer: its modifier classes are built by
// interpolation, so the content scanner cannot see them and purges them.
import '../styles/diff.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'default' | 'home';
  noFooter?: boolean;
}

const {
  title,
  description = 'An open-source curriculum and recordings index for college parliamentary debate.',
  variant = 'default',
  noFooter = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = variant === 'home';

const navLinks = [
  { href: '/curriculum', label: 'curriculum' },
  { href: '/recordings', label: 'recordings' },
  { href: '/lectures', label: 'lectures' },
  { href: '/search', label: 'search' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href="/fonts/PPEditorialNew-Ultralight.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NeueMontreal-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="the golden turn" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={new URL('/og-image.png', Astro.site ?? 'https://goldenturn.org')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class={isHome ? 'masthead masthead--home' : 'masthead'}>
      <div class="shell masthead-inner">
        <a href="/" class="masthead-mark" aria-label="the golden turn, home">
          <span class={isHome ? 'wordmark' : 'wordmark wordmark-sm'}>the golden turn</span>
        </a>

        <nav aria-label="Main navigation" class="masthead-nav">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class={isActive(href) ? 'masthead-link is-current' : 'masthead-link'}
            >
              {label}
            </a>
          ))}
          <a href="/admin" class="masthead-link masthead-auth js-nav-admin" hidden>admin</a>
          <a href="/me" class="masthead-link masthead-auth js-nav-account" hidden></a>
          <button class="masthead-link masthead-auth-btn js-nav-signin" type="button">sign in</button>
        </nav>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="masthead-toggle"
        >
          <span class="masthead-burger" aria-hidden="true"></span>
        </button>
      </div>

      <div id="mobile-menu" class="masthead-drawer" hidden>
        <nav aria-label="Mobile navigation" class="shell masthead-drawer-inner">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class={isActive(href) ? 'masthead-link is-current' : 'masthead-link'}
            >
              {label}
            </a>
          ))}
          <a href="/admin" class="masthead-link masthead-auth js-nav-admin" hidden>admin</a>
          <a href="/me" class="masthead-link masthead-auth js-nav-account" hidden></a>
          <button class="masthead-link masthead-auth-btn js-nav-signin" type="button">sign in</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {!noFooter && (
      <footer class="site-footer">
        <div class="shell site-footer-inner">
          <span class="wordmark footer-mark">npda</span>

          <div class="footer-grid">
            <div class="footer-col">
              <p class="label label-muted">maintained by</p>
              <p class="footer-line">Tejas Prabhune</p>
              <p class="footer-line">
                <a href="https://tejasprabhune.github.io" target="_blank" rel="noopener noreferrer" class="footer-link">tejasprabhune.github.io</a>
              </p>
              <p class="footer-line">
                <a href="mailto:prabhune@berkeley.edu" class="footer-link">prabhune@berkeley.edu</a>
              </p>
            </div>

            <div class="footer-col">
              <p class="label label-muted">sections</p>
              {navLinks.map(({ href, label }) => (
                <p class="footer-line"><a href={href} class="footer-link">{label}</a></p>
              ))}
            </div>

            <div class="footer-col">
              <p class="label label-muted">source</p>
              <p class="footer-line"><a href="/contribute" class="footer-link">contribute</a></p>
              <p class="footer-line">
                <a href="https://github.com/tejasprabhune/goldenturn" target="_blank" rel="noopener noreferrer" class="footer-link">github</a>
              </p>
            </div>
          </div>
        </div>
      </footer>
    )}

    <dialog class="signin" id="signin-dialog">
      <form method="dialog" class="signin-form" id="signin-form">
        <h2 class="signin-title" id="signin-title">Sign in</h2>

        <div id="signin-name-row" hidden>
          <label class="signin-label" for="signin-name">Display name</label>
          <input class="field" type="text" id="signin-name" maxlength="60" autocomplete="nickname" />
        </div>

        <label class="signin-label" for="signin-email">Email</label>
        <input class="field" type="email" id="signin-email" required autocomplete="email" />

        <label class="signin-label" for="signin-password">Password</label>
        <input class="field" type="password" id="signin-password" required minlength="8"
               autocomplete="current-password" />

        <p class="signin-error" id="signin-error" hidden></p>

        <p class="signin-switch">
          <span id="signin-switch-copy">New here?</span>
          <button type="button" class="link account-link" id="signin-switch">Create an account</button>
        </p>

        <!-- Cancel is deliberately not a submit button: as the first one in the
             form it would become the default, and Enter in a field would cancel
             the dialog instead of signing in. -->
        <div class="signin-actions">
          <button type="button" class="chip" id="signin-cancel">Cancel</button>
          <button type="submit" class="btn" id="signin-submit" value="ok">Sign in</button>
        </div>
      </form>
    </dialog>

    <div id="search-overlay" class="search-overlay" hidden>
      <div class="search-overlay-backdrop" data-close></div>
      <div class="search-overlay-panel" role="dialog" aria-modal="true" aria-label="Search">
        <input
          id="overlay-input"
          type="search"
          class="search-overlay-input"
          placeholder="search everything"
          autocomplete="off"
          aria-label="Search everything"
        />
        <p class="label label-muted search-overlay-hint">up and down to browse, enter to open, esc to close</p>
        <div id="overlay-results" class="search-overlay-results"></div>
      </div>
    </div>
  </body>
</html>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .masthead--home {
    background: var(--sky);
    border-bottom-color: var(--ink);
  }

  /* The wordmark sets the bar height; padding is only enough to clear the
     descenders. */
  .masthead-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 0.5rem;
    padding-bottom: 0.45rem;
  }

  /* On the home page the nav takes its own line above the mark so the wordmark
     can run the full measure without wrapping. */
  .masthead--home .masthead-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    padding-top: 0.85rem;
    padding-bottom: 1.5rem;
  }

  .masthead--home .masthead-mark {
    grid-row: 2;
    grid-column: 1 / -1;
    margin-top: 0.75rem;
  }

  @media (min-width: 900px) {
    .masthead--home .masthead-inner {
      padding-top: 1.25rem;
      padding-bottom: 2.5rem;
    }

    .masthead--home .masthead-mark {
      margin-top: 1.5rem;
    }
  }

  .masthead--home .masthead-nav {
    grid-row: 1;
    grid-column: 2;
    padding-bottom: 0;
  }

  .masthead-mark {
    text-decoration: none;
    min-width: 0;
  }

  .masthead-mark .wordmark {
    font-size: clamp(1.8rem, 5vw, 3.1rem);
  }

  .masthead--home .masthead-mark .wordmark {
    font-size: clamp(2.5rem, 13.5vw, 11rem);
  }

  /* Below the nav breakpoint the wordmark and the hamburger share one line and
     the wordmark is sized to fill what is left of the shell. "the golden turn"
     runs 5.25 times its font-size wide, so the fit is a division rather than a
     guessed vw coefficient. The glyphs overhang the line box by about 0.11em,
     so the vertical padding is in em too and scales with the fitted size. */
  @media (max-width: 899px) {
    .masthead-inner,
    .masthead--home .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-top: 0;
      padding-bottom: 0;
    }

    .masthead-mark {
      --mark-size: min(3.1rem, calc((100vw - 2 * var(--gutter) - 3rem) / 5.25));
      font-size: var(--mark-size);
      padding-block: 0.2em;
      margin-top: 0;
    }

    .masthead--home .masthead-mark {
      --mark-size: min(11rem, calc((100vw - 2 * var(--gutter) - 3rem) / 5.25));
      margin-top: 0;
    }

    .masthead-mark .wordmark,
    .masthead--home .masthead-mark .wordmark {
      font-size: 1em;
    }
  }

  .masthead-nav {
    display: none;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 0.35rem;
  }

  @media (min-width: 900px) {
    .masthead-nav {
      display: flex;
    }

    .masthead-toggle,
    .masthead-drawer {
      display: none;
    }
  }

  .masthead-link {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    color: rgba(23, 21, 15, 0.7);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.06s linear;
  }

  .masthead-link:hover {
    color: var(--ink);
  }

  .masthead-link.is-current {
    color: var(--ink);
    box-shadow: inset 0 -0.55em 0 var(--gold);
  }

  /* Chrome only. `font: inherit` here would out-rank .masthead-link's weight
     and leave "sign in" lighter than the links beside it. */
  .masthead-auth-btn {
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
  }

  .masthead-auth[hidden],
  .masthead-auth-btn[hidden] {
    display: none;
  }

  .masthead-toggle {
    background: none;
    border: none;
    padding: 0.6rem 0 0.6rem 0.5rem;
    flex: none;
    color: rgba(23, 21, 15, 0.62);
    cursor: pointer;
  }

  .masthead-toggle:hover {
    color: var(--ink);
  }

  .masthead-burger,
  .masthead-burger::before,
  .masthead-burger::after {
    display: block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 60ms linear, background-color 60ms linear;
  }

  .masthead-burger::before,
  .masthead-burger::after {
    content: '';
    position: relative;
  }

  .masthead-burger::before {
    top: -0.4rem;
  }

  .masthead-burger::after {
    top: 0.4rem;
  }

  .masthead-toggle[aria-expanded='true'] .masthead-burger {
    background: transparent;
  }

  .masthead-toggle[aria-expanded='true'] .masthead-burger::before {
    transform: translateY(0.4rem) rotate(45deg);
  }

  .masthead-toggle[aria-expanded='true'] .masthead-burger::after {
    transform: translateY(-0.4rem) rotate(-45deg);
  }

  .masthead-drawer {
    border-top: 1px solid var(--rule);
  }

  .masthead-drawer[hidden] {
    display: none;
  }

  .masthead-drawer-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    padding-top: 1rem;
    padding-bottom: 1.25rem;
  }

  .site-footer {
    margin-top: 7rem;
    border-top: 1px solid var(--ink);
    background: var(--sky);
  }

  .site-footer-inner {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-mark {
    font-size: clamp(4rem, 18vw, 14rem);
    margin-bottom: 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    border-top: 1px solid var(--ink);
    padding-top: 1.5rem;
  }

  @media (min-width: 700px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .footer-col p.label {
    margin-bottom: 0.75rem;
  }

  .footer-line {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0 0 0.2rem;
    color: var(--ink);
  }

  .footer-link {
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 -1px 0 rgba(23, 21, 15, 0.3);
    transition: box-shadow 0.06s linear, background-color 0.06s linear;
  }

  .footer-link:hover {
    background: var(--gold);
    box-shadow: inset 0 -1px 0 var(--ink);
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 21, 15, 0.35);
  }

  .search-overlay-panel {
    position: relative;
    width: min(42rem, calc(100vw - 2rem));
    max-height: 70vh;
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 1.25rem;
  }

  .search-overlay-input {
    width: 100%;
    font-family: 'PP Editorial New', Georgia, serif;
    font-weight: 300;
    font-size: 2rem;
    line-height: 1.1;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule);
    padding: 0 0 0.5rem;
    color: var(--ink);
    outline: none;
  }

  .search-overlay-input::placeholder {
    color: rgba(23, 21, 15, 0.3);
  }

  .search-overlay-hint {
    margin: 0.75rem 0 0;
  }

  .search-overlay-results {
    margin-top: 1rem;
  }
</style>

<script>
  import { algoliasearch } from 'algoliasearch';
  import { recordingHref } from '../lib/recordings';
  import { getUser, signIn, signUp, isAdmin, track } from '../lib/api';

  // Auth state is rendered on the client so pages stay static and cacheable.
  // The bar and the mobile drawer each carry a copy of these controls.
  const navAccounts = Array.from(document.querySelectorAll<HTMLAnchorElement>('.js-nav-account'));
  const navSignins = Array.from(document.querySelectorAll<HTMLElement>('.js-nav-signin'));
  const navAdmins = Array.from(document.querySelectorAll<HTMLElement>('.js-nav-admin'));
  const signinDialog = document.getElementById('signin-dialog') as HTMLDialogElement | null;

  function renderAuth() {
    const user = getUser();
    const admin = Boolean(user && isAdmin());
    navAccounts.forEach(el => {
      el.hidden = !user;
      el.textContent = user ? user.display_name : '';
    });
    navSignins.forEach(el => { el.hidden = Boolean(user); });
    navAdmins.forEach(el => { el.hidden = !admin; });
  }

  let signupMode = false;

  function setAuthMode(signup: boolean) {
    signupMode = signup;
    const nameRow = document.getElementById('signin-name-row')!;
    const nameInput = document.getElementById('signin-name') as HTMLInputElement;
    nameRow.hidden = !signup;
    nameInput.required = signup;
    document.getElementById('signin-title')!.textContent = signup ? 'Create an account' : 'Sign in';
    document.getElementById('signin-submit')!.textContent = signup ? 'Create account' : 'Sign in';
    document.getElementById('signin-switch-copy')!.textContent =
      signup ? 'Already have an account?' : 'New here?';
    document.getElementById('signin-switch')!.textContent = signup ? 'Sign in' : 'Create an account';
    (document.getElementById('signin-password') as HTMLInputElement).autocomplete =
      signup ? 'new-password' : 'current-password';
    document.getElementById('signin-error')!.hidden = true;
  }

  document.getElementById('signin-switch')?.addEventListener('click', () => setAuthMode(!signupMode));

  function openSignIn(signup = false) {
    setAuthMode(signup);
    signinDialog?.showModal();
  }

  navSignins.forEach(el => el.addEventListener('click', () => {
    closeDrawer();
    openSignIn(false);
  }));
  document.addEventListener('gt:open-signin', e => openSignIn(Boolean((e as CustomEvent).detail?.signup)));

  document.getElementById('signin-cancel')?.addEventListener('click', () => signinDialog?.close());

  document.getElementById('signin-form')?.addEventListener('submit', async e => {
    // Enter in a field submits with no submitter in some engines; the only
    // submit button left is the real one, so treat that as a sign in.
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    if (submitter && submitter.value !== 'ok') return;
    e.preventDefault();
    const email = (document.getElementById('signin-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('signin-password') as HTMLInputElement).value;
    const name = (document.getElementById('signin-name') as HTMLInputElement).value.trim();
    const err = document.getElementById('signin-error')!;
    try {
      if (signupMode) await signUp(email, password, name);
      else await signIn(email, password);
      err.hidden = true;
      signinDialog?.close();
      renderAuth();
      document.dispatchEvent(new CustomEvent('gt:signed-in'));
    } catch (ex: any) {
      err.textContent = ex.message ?? 'Could not sign in';
      err.hidden = false;
    }
  });

  renderAuth();

  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function setDrawer(open: boolean) {
    if (!mobileToggle || !mobileMenu) return;
    mobileMenu.toggleAttribute('hidden', !open);
    mobileToggle.setAttribute('aria-expanded', String(open));
    mobileToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  }

  function closeDrawer() {
    setDrawer(false);
  }

  mobileToggle?.addEventListener('click', () => {
    setDrawer(mobileMenu?.hasAttribute('hidden') ?? false);
  });

  const overlay = document.getElementById('search-overlay') as HTMLDivElement | null;
  const overlayInput = document.getElementById('overlay-input') as HTMLInputElement | null;
  const overlayResults = document.getElementById('overlay-results') as HTMLDivElement | null;

  const APP_ID = import.meta.env.PUBLIC_ALGOLIA_APP_ID as string;
  const SEARCH_KEY = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY as string;
  const client = APP_ID && SEARCH_KEY ? algoliasearch(APP_ID, SEARCH_KEY) : null;

  function escapeHtml(str: string): string {
    return (str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  interface Hit {
    objectID: string;
    type?: string;
    title?: string;
    name?: string;
    url?: string;
    link?: string;
    description?: string;
    resolution?: string;
    _isRecording?: boolean;
  }

  // Only sections that are live on the site.
  const LIVE_TYPES = ['curriculum', 'recording', 'lecture'];

  let debounce: ReturnType<typeof setTimeout> | undefined;
  let overlayLinks: HTMLAnchorElement[] = [];
  let focused = -1;

  function openOverlay() {
    if (!overlay || !overlayInput) return;
    overlay.removeAttribute('hidden');
    overlayInput.focus();
    overlayInput.select();
    focused = -1;
  }

  function closeOverlay() {
    if (!overlay) return;
    overlay.setAttribute('hidden', '');
  }

  async function runOverlaySearch(query: string) {
    if (!overlayResults) return;
    if (!query.trim() || !client) {
      overlayResults.innerHTML = '';
      overlayLinks = [];
      focused = -1;
      return;
    }

    const [contentHits, recordingHits] = await Promise.all([
      client
        .searchSingleIndex({ indexName: 'goldenturn_content', searchParams: { query, hitsPerPage: 6 } })
        .then(r => r.hits as Hit[])
        .catch(() => [] as Hit[]),
      client
        .searchSingleIndex({ indexName: 'all_rounds', searchParams: { query, hitsPerPage: 6 } })
        .then(r => (r.hits as Hit[]).map(h => ({ ...h, type: 'recording', _isRecording: true })))
        .catch(() => [] as Hit[]),
    ]);

    const hits = [...contentHits, ...recordingHits]
      .filter(h => LIVE_TYPES.includes(h.type ?? ''))
      .slice(0, 8);

    if (hits.length === 0) {
      overlayResults.innerHTML = `<p class="page-lede" style="margin-top: 0.5rem;">No results.</p>`;
      overlayLinks = [];
      focused = -1;
      return;
    }

    overlayResults.innerHTML = hits
      .map(hit => {
        const title = escapeHtml((hit.title ?? hit.name ?? '') as string);
        const url = escapeHtml(
          hit._isRecording
            ? recordingHref({ title: hit.title ?? '', objectID: hit.objectID })
            : (hit.url ?? '#')
        );
        const desc = escapeHtml(hit._isRecording ? (hit.resolution ?? '') : (hit.description ?? ''));
        return `<a class="result-link" href="${url}">
          <span class="result-title">${title}</span>
          ${desc ? `<span class="result-desc">${desc}</span>` : ''}
        </a>`;
      })
      .join('');

    overlayLinks = Array.from(overlayResults.querySelectorAll('a.result-link'));
    focused = -1;
  }

  function moveFocus(delta: number) {
    if (overlayLinks.length === 0) return;
    focused = focused + delta;
    if (focused < -1) focused = overlayLinks.length - 1;
    if (focused >= overlayLinks.length) focused = -1;
    overlayLinks.forEach((a, i) => a.classList.toggle('is-focused', i === focused));
    if (focused >= 0) overlayLinks[focused].scrollIntoView({ block: 'nearest' });
  }

  overlayInput?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      const q = overlayInput.value.trim();
      void runOverlaySearch(q);
      if (q.length > 2) track('search', undefined, { q, source: 'overlay' });
    }, 400);
  });

  overlayInput?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      moveFocus(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      moveFocus(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (focused >= 0 && overlayLinks[focused]) {
        window.location.href = overlayLinks[focused].href;
        return;
      }
      const q = overlayInput.value.trim();
      window.location.href = q ? `/search?q=${encodeURIComponent(q)}` : '/search';
    }
  });

  overlay?.querySelector('[data-close]')?.addEventListener('click', closeOverlay);

  document.addEventListener('keydown', (e) => {
    const tag = document.activeElement?.tagName;
    const typing = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';

    if (e.key === '/' && !typing) {
      e.preventDefault();
      openOverlay();
    } else if (e.key === 'Escape' && overlay && !overlay.hasAttribute('hidden')) {
      closeOverlay();
    }
  });
</script>
