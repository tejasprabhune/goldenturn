---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'curriculum'>;
  allArticles: CollectionEntry<'curriculum'>[];
  Content: any;
}

const { article, allArticles, Content } = Astro.props;

const SECTION_ORDER = ['goals', 'foundations'] as const;
const SECTION_LABELS: Record<string, string> = {
  goals: 'goals',
  foundations: 'foundations',
};

const grouped = SECTION_ORDER.reduce<Record<string, CollectionEntry<'curriculum'>[]>>((acc, section) => {
  acc[section] = allArticles
    .filter(a => a.data.section === section)
    .sort((a, b) => a.data.order - b.data.order);
  return acc;
}, {} as Record<string, CollectionEntry<'curriculum'>[]>);

function articleHref(entry: CollectionEntry<'curriculum'>) {
  const parts = entry.id.replace(/\.(mdx?|typ)$/, '').split('/');
  const section = parts[0];
  const slug = parts.slice(1).join('/');
  return `/curriculum/${section}/${slug}`;
}

const currentHref = articleHref(article);
const sectionLabel = SECTION_LABELS[article.data.section] ?? article.data.section;

const relatedArticles = article.data.related_articles
  .map(slug => allArticles.find(a => a.id.replace(/\.(mdx?|typ)$/, '') === slug))
  .filter((a): a is CollectionEntry<'curriculum'> => !!a);

// K and file sections are hidden while those parts of the site are offline.
const hasRelated =
  relatedArticles.length > 0 ||
  article.data.related_recordings_tags.length > 0;
---

<BaseLayout title={`${article.data.title} | Curriculum | the golden turn`}>
  <div class="shell article-grid">
    <aside class="article-aside">
      <div class="article-aside-inner">
        <a href="/learn" class="label label-muted aside-home">all articles</a>
        <nav aria-label="Article navigation">
          {SECTION_ORDER.map(section => {
            const articles = grouped[section];
            if (!articles || articles.length === 0) return null;
            return (
              <div class="aside-section">
                <p class="label label-muted aside-label">{SECTION_LABELS[section]}</p>
                <ul class="aside-list">
                  {articles.map(entry => {
                    const href = articleHref(entry);
                    const isCurrent = href === currentHref;
                    return (
                      <li>
                        <a
                          href={href}
                          aria-current={isCurrent ? 'page' : undefined}
                          class={isCurrent ? 'aside-link is-current' : 'aside-link'}
                        >
                          {entry.data.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </nav>
      </div>
    </aside>

    <main class="article-main">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/learn">learn</a>
        <span aria-hidden="true">/</span>
        <a href={`/curriculum#${article.data.section}`}>{sectionLabel}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{article.data.title}</span>
      </nav>

      <div class="article-toc-mobile">
        <button id="toc-toggle" type="button" class="chip" aria-expanded="false" aria-controls="toc-drawer">
          contents
        </button>
        <div id="toc-drawer" class="toc-drawer" hidden>
          <nav aria-label="Article navigation">
            {SECTION_ORDER.map(section => {
              const articles = grouped[section];
              if (!articles || articles.length === 0) return null;
              return (
                <div class="aside-section">
                  <p class="label label-muted aside-label">{SECTION_LABELS[section]}</p>
                  <ul class="aside-list">
                    {articles.map(entry => {
                      const href = articleHref(entry);
                      const isCurrent = href === currentHref;
                      return (
                        <li>
                          <a
                            href={href}
                            aria-current={isCurrent ? 'page' : undefined}
                            class={isCurrent ? 'aside-link is-current' : 'aside-link'}
                          >
                            {entry.data.title}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              );
            })}
          </nav>
        </div>
      </div>

      <h1 class="page-title article-title">{article.data.title}</h1>

      <div class="prose">
        <Content />
      </div>

      {hasRelated && (
        <section class="related" aria-label="Related">
          {relatedArticles.length > 0 && (
            <div>
              <p class="label label-muted">articles</p>
              <ul>
                {relatedArticles.map(a => (
                  <li><a href={articleHref(a)}>{a.data.title}</a></li>
                ))}
              </ul>
            </div>
          )}

          {article.data.related_recordings_tags.length > 0 && (
            <div>
              <p class="label label-muted">recordings</p>
              <ul>
                {article.data.related_recordings_tags.map(tag => (
                  <li><a href={`/recordings?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}
    </main>
  </div>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
  }

  .article-aside {
    display: none;
    border-right: 1px solid var(--rule-soft);
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: 14rem 1fr;
    }

    .article-aside {
      display: block;
    }

    .article-toc-mobile {
      display: none;
    }
  }

  .article-aside-inner {
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
    padding: 3.25rem 1.5rem 3rem 0;
  }

  .aside-home {
    display: block;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .aside-home:hover {
    color: var(--ink);
  }

  .aside-section {
    margin-bottom: 1.75rem;
  }

  .aside-label {
    margin-bottom: 0.6rem;
  }

  .aside-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aside-link {
    display: block;
    font-size: 0.875rem;
    line-height: 1.35;
    padding: 0.3rem 0;
    color: rgba(23, 21, 15, 0.55);
    text-decoration: none;
  }

  .aside-link:hover {
    color: var(--ink);
  }

  .aside-link.is-current {
    color: var(--ink);
    box-shadow: inset 0 -0.35em 0 var(--gold);
  }

  .article-main {
    padding-top: 3.25rem;
    padding-bottom: 5rem;
    min-width: 0;
  }

  .article-title {
    margin-bottom: 2.5rem;
  }

  .article-toc-mobile {
    margin-bottom: 2rem;
  }

  .toc-drawer {
    margin-top: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--rule);
  }

  .toc-drawer[hidden] {
    display: none;
  }
</style>

<script>
  const tocToggle = document.getElementById('toc-toggle');
  const tocDrawer = document.getElementById('toc-drawer');
  if (tocToggle && tocDrawer) {
    tocToggle.addEventListener('click', () => {
      const open = tocDrawer.hasAttribute('hidden');
      tocDrawer.toggleAttribute('hidden', !open);
      tocToggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
