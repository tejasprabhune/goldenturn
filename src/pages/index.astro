---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="the golden turn"
  description="An open archive for college parliamentary debate."
  variant="home"
>
  <section class="shell lead-block">
    <p class="lead">
      an open archive for college parliamentary debate, written and maintained by debaters.
    </p>
    <p class="lead-hint">
      press <kbd class="key">/</kbd> to search, e.g. cal mr
    </p>

    <p class="block-text">
      The site is open source on <a href="https://github.com/tejasprabhune/goldenturn" target="_blank" rel="noopener noreferrer" class="link">GitHub</a>.
      Written content is accepted as pull requests against the main branch. To submit a
      recording, use the <a href="/recordings/add" class="link">recording submission form</a>.
      Full instructions live on the <a href="/contribute" class="link">contribute page</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .lead-block {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .lead {
    font-family: 'PP Editorial New', Georgia, serif;
    font-weight: 300;
    font-size: clamp(1.75rem, 4.4vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    max-width: 22ch;
    margin: 0;
  }

  .lead-hint {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    margin: 2rem 0 0;
  }

  .key {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.8125rem;
    border: 1px solid var(--ink);
    background: var(--gold);
    padding: 0.05rem 0.4rem;
    color: var(--ink);
  }

  .block-text {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 56ch;
    margin: 1.75rem 0 0;
    color: var(--ink-muted);
  }
</style>
