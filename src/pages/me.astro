---
import BaseLayout from '../layouts/BaseLayout.astro';
// The stage marks the submissions list shares with the processing page.
import '../styles/pending.css';
---

<BaseLayout title="Your account | the golden turn" description="Your saved rounds, notes and tags.">
  <div class="shell page-head">
    <h1 class="page-title" id="me-title">Your account</h1>
    <p class="page-lede" id="me-lede">Loading.</p>
  </div>

  <div class="shell page-body" id="me-body" hidden>
    <div class="me-grid">
      <!-- Hidden until the list arrives, and for anyone who never submitted:
           most readers have nothing to show here. -->
      <section class="me-block me-block--wide" id="me-subs-block" hidden>
        <p class="section-head me-subs-head">
          <span>Rounds you submitted</span>
          <a class="me-subs-add" href="/recordings/add">Submit another</a>
        </p>
        <ul class="row-list me-subs" id="me-subs"></ul>
        <p class="me-empty" id="me-subs-error" hidden></p>
      </section>

      <section class="me-block me-block--wide">
        <p class="section-head">Saved rounds</p>
        <ul class="row-list" id="me-favorites"></ul>
        <p class="me-empty" id="me-favorites-empty" hidden>Nothing saved yet.</p>
      </section>

      <section class="me-block me-block--wide">
        <p class="section-head">Rounds you rated</p>
        <ul class="row-list" id="me-ratings"></ul>
        <p class="me-empty" id="me-ratings-empty" hidden>Nothing rated yet.</p>
      </section>

      <section class="me-block">
        <p class="section-head">Your tags</p>
        <div class="tag-list" id="me-tags"></div>
        <p class="me-empty" id="me-tags-empty" hidden>No tags yet.</p>
      </section>

      <section class="me-block">
        <p class="section-head">Your notes</p>
        <ul class="me-notes" id="me-notes"></ul>
        <p class="me-empty" id="me-notes-empty" hidden>No notes yet.</p>
      </section>
    </div>

    <p class="me-actions">
      <a class="chip" href="/admin" id="me-admin" hidden>Admin dashboard</a>
      <button class="chip" id="me-signout">Sign out</button>
    </p>
  </div>

  <div class="shell page-body" id="me-guest" hidden>
    <p class="page-lede">
      You are not signed in.
      <button class="link account-link" id="me-signin">Sign up or sign in</button>
      to save rounds, tag them, and keep notes.
    </p>
  </div>
</BaseLayout>

<style>
  .me-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .me-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    /* Lists of rounds run the full width; the short lists sit side by side. */
    .me-block--wide {
      grid-column: 1 / -1;
    }
  }

  /* An empty section says so quietly; it is a state, not a lede. */
  .me-empty {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    margin: 0.75rem 0 3rem;
  }

  .me-empty[hidden] {
    display: none;
  }

  .me-notes:empty {
    margin: 0;
  }

  .me-notes {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .me-notes li {
    border-bottom: 1px solid var(--rule-soft);
    padding: 0.6rem 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .me-note-meta {
    display: block;
    font-size: 0.75rem;
    color: rgba(23, 21, 15, 0.45);
    margin-top: 0.2rem;
  }

  .me-subs-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .me-subs-add {
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }

  .me-subs-add:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* The state column holds a mark and a few words, so it is given room and
     lined up rather than left to the auto track. */
  .me-subs :global(.row) {
    grid-template-columns: 2.5rem minmax(0, 1fr) 11rem;
  }

  @media (max-width: 640px) {
    .me-subs :global(.row) {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .me-subs :global(.row-meta) {
      grid-column: 2;
      margin-top: 0.3rem;
    }
  }

  .me-block[hidden] {
    display: none;
  }

  .me-actions {
    margin-top: 3rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
</style>

<script>
  import {
    getUser, signOut, listFavorites, listNotes, listTags, listMyRatings,
    isAdmin, NotSignedIn,
  } from '../lib/api';
  import { formatTime } from '../lib/waveform';
  import { listMySubmissions, getProgress, pendingHref, ago, STATUS_WORD } from '../lib/progress';
  import { followHref } from '../lib/progressview';
  import { ownStarsHtml } from '../lib/stars';

  const title = document.getElementById('me-title')!;
  const lede = document.getElementById('me-lede')!;
  const body = document.getElementById('me-body')!;
  const guest = document.getElementById('me-guest')!;

  function titleCase(slug: string) {
    return slug.replace(/-[a-z0-9]{6}$/, '').replace(/-/g, ' ');
  }

  async function render() {
    const user = getUser();
    if (!user) {
      title.textContent = 'Your account';
      lede.textContent = 'Reading is open to everyone; an account keeps your notes.';
      body.hidden = true;
      guest.hidden = false;
      return;
    }

    title.textContent = user.display_name;
    lede.textContent = `${user.rep} circuit rep`;
    guest.hidden = true;
    body.hidden = false;
    const adminLink = document.getElementById('me-admin');
    if (adminLink) adminLink.hidden = !isAdmin();

    void renderSubmissions();

    try {
      const [{ favorites }, { notes }, { tags }, { ratings }] = await Promise.all([
        listFavorites(), listNotes(), listTags(), listMyRatings(),
      ]);

      const favList = document.getElementById('me-favorites')!;
      favList.innerHTML = '';
      document.getElementById('me-favorites-empty')!.hidden = favorites.length > 0;
      favorites.forEach((f, i) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'row';
        a.href = f.kind === 'recording' ? `/recordings/${f.ref}` : `/${f.ref}`;
        const idx = document.createElement('span');
        idx.className = 'row-index';
        idx.textContent = String(i + 1).padStart(2, '0');
        const t = document.createElement('span');
        t.className = 'row-title';
        t.textContent = titleCase(f.ref);
        const meta = document.createElement('span');
        meta.className = 'row-meta';
        meta.textContent = f.kind;
        a.append(idx, t, meta);
        li.appendChild(a);
        favList.appendChild(li);
      });

      // Already ranked by the server, best first, because that is the question
      // this list answers.
      const ratedList = document.getElementById('me-ratings')!;
      ratedList.innerHTML = '';
      document.getElementById('me-ratings-empty')!.hidden = ratings.length > 0;
      ratings.forEach((r, i) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'row';
        a.href = `/recordings/${r.slug}`;
        const idx = document.createElement('span');
        idx.className = 'row-index';
        idx.textContent = String(i + 1).padStart(2, '0');
        const t = document.createElement('span');
        t.className = 'row-title';
        t.textContent = titleCase(r.slug);
        const meta = document.createElement('span');
        meta.className = 'row-meta';
        meta.innerHTML = ownStarsHtml(r.stars);
        a.append(idx, t, meta);
        li.appendChild(a);
        ratedList.appendChild(li);
      });

      const tagBox = document.getElementById('me-tags')!;
      tagBox.innerHTML = '';
      const byTag = new Map<string, number>();
      for (const t of tags) byTag.set(t.tag, (byTag.get(t.tag) ?? 0) + 1);
      document.getElementById('me-tags-empty')!.hidden = byTag.size > 0;
      for (const [tag, n] of [...byTag].sort((a, b) => b[1] - a[1])) {
        const a = document.createElement('a');
        a.className = 'tag';
        a.href = `/recordings?tag=${encodeURIComponent('#' + tag)}`;
        a.textContent = n > 1 ? `${tag} (${n})` : tag;
        tagBox.appendChild(a);
      }

      const noteList = document.getElementById('me-notes')!;
      noteList.innerHTML = '';
      document.getElementById('me-notes-empty')!.hidden = notes.length > 0;
      for (const n of notes) {
        const li = document.createElement('li');
        li.textContent = n.body;
        const meta = document.createElement('a');
        meta.className = 'me-note-meta';
        meta.href = `/recordings/${n.slug}?t=${Math.floor(n.at_s)}`;
        meta.textContent = `${titleCase(n.slug)} at ${formatTime(n.at_s)}`;
        li.appendChild(meta);
        noteList.appendChild(li);
      }
    } catch (e) {
      if (e instanceof NotSignedIn) { body.hidden = true; guest.hidden = false; }
    }
  }

  /**
   * The rounds this account submitted, newest first, each with how far it has
   * got. Until now a submitter who left the confirmation had no way back to a
   * round, and no way to learn that its ingest had failed.
   */
  async function renderSubmissions() {
    const block = document.getElementById('me-subs-block')!;
    const list = document.getElementById('me-subs')!;
    const error = document.getElementById('me-subs-error')!;
    let submissions;
    try {
      ({ submissions } = await listMySubmissions());
    } catch (e) {
      if (e instanceof NotSignedIn) return;
      block.hidden = false;
      list.innerHTML = '';
      error.hidden = false;
      error.textContent = 'Your submissions could not be loaded just now.';
      return;
    }
    error.hidden = true;
    list.innerHTML = '';
    block.hidden = submissions.length === 0;
    const now = Math.floor(Date.now() / 1000);

    submissions.forEach((s, i) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'row';
      // A published round has its page. Anything else is followed on its page
      // as soon as that exists, which shows its progress in place, and on the
      // pending page until then; a removal is explained there too.
      a.href = s.status === 'published' ? `/recordings/${s.slug}` : pendingHref(s.object_id);
      if (s.status !== 'published' && s.status !== 'removed') {
        void getProgress(s.object_id).then(p => { a.href = followHref(p); }).catch(() => {});
      }

      const idx = document.createElement('span');
      idx.className = 'row-index';
      idx.textContent = String(i + 1).padStart(2, '0');

      const t = document.createElement('span');
      t.className = 'row-title';
      t.textContent = s.title;
      const when = document.createElement('span');
      when.className = 'sub-when';
      when.textContent = [s.tournament, s.year, `submitted ${ago(s.created_at, now)}`]
        .filter(Boolean).join(', ');
      t.appendChild(when);
      if (s.status === 'failed' && s.reason) {
        const why = document.createElement('span');
        why.className = 'sub-reason';
        why.textContent = s.reason;
        t.appendChild(why);
      }

      const meta = document.createElement('span');
      meta.className = 'row-meta';
      const state = document.createElement('span');
      state.className = 'sub-state';
      state.dataset.status = s.status;
      state.textContent = STATUS_WORD[s.status] ?? s.status;
      meta.appendChild(state);

      a.append(idx, t, meta);
      li.appendChild(a);
      list.appendChild(li);
    });
  }

  document.getElementById('me-signin')?.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('gt:open-signin')));
  document.getElementById('me-signout')?.addEventListener('click', () => {
    signOut();
    location.reload();
  });
  document.addEventListener('gt:signed-in', render);

  void render();
</script>
