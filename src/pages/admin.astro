---
import BaseLayout from '../layouts/BaseLayout.astro';

const PANELS = [
  { id: 'searches', title: 'What people search for', accent: 'gold' },
  { id: 'rounds', title: 'Most opened rounds', accent: 'sky' },
  { id: 'tags', title: 'Tags in use', accent: 'sky' },
  { id: 'kinds', title: 'Events by kind', accent: 'gold' },
];
---

<BaseLayout title="Admin | the golden turn" description="Usage and contribution statistics.">
  <div class="shell page-head">
    <h1 class="page-title">admin</h1>
    <p class="page-lede" id="admin-lede">Checking access.</p>
  </div>

  <div class="shell page-body" id="admin-denied" hidden>
    <p class="page-lede">This page is limited to the site administrator.</p>
  </div>

  <div class="shell page-body" id="admin-body" hidden>
    <section class="admin-totals" id="admin-totals"></section>

    <section class="admin-panel">
      <div class="admin-panel-head">
        <p class="section-head">Activity</p>
        <select class="field admin-range" id="admin-days" aria-label="Time range">
          <option value="7">Last 7 days</option>
          <option value="30" selected>Last 30 days</option>
          <option value="90">Last 90 days</option>
          <option value="365">Last year</option>
        </select>
      </div>
      <div class="chart-wrap"><canvas class="admin-canvas admin-canvas--tall" id="chart-daily"></canvas></div>
    </section>

    <div class="admin-grid">
      {PANELS.map(p => (
        <section class="admin-panel">
          <p class="section-head">{p.title}</p>
          <div class="chart-wrap"><canvas class="admin-canvas" id={`chart-${p.id}`} data-accent={p.accent}></canvas></div>
          <p class="admin-empty" id={`empty-${p.id}`} hidden>none</p>
        </section>
      ))}
    </div>

    <section class="admin-panel">
      <div class="admin-panel-head">
        <p class="section-head">Proposed edits awaiting review</p>
        <span class="label label-muted" id="queue-count"></span>
      </div>
      <ul class="queue" id="admin-queue"></ul>
      <p class="admin-empty" id="queue-empty" hidden>none</p>
    </section>

    <section class="admin-panel">
      <div class="admin-panel-head">
        <p class="section-head">Submitted rounds</p>
        <span class="label label-muted" id="pending-count"></span>
      </div>
      <ul class="queue" id="admin-pending"></ul>
      <p class="admin-empty" id="pending-empty" hidden>none</p>
    </section>

    <section class="admin-panel">
      <div class="admin-panel-head">
        <p class="section-head">Live activity</p>
        <button class="chip" id="stream-toggle" aria-pressed="true">Live</button>
      </div>
      <ul class="stream" id="admin-stream"></ul>
    </section>

    <section class="admin-panel">
      <p class="section-head">Contributors</p>
      <table class="admin-table">
        <thead>
          <tr><th>Name</th><th>Rep</th><th>Proposals</th></tr>
        </thead>
        <tbody id="admin-contributors"></tbody>
      </table>
    </section>
  </div>
</BaseLayout>

<style>
  .admin-totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }

  .admin-panel {
    margin-bottom: 2.5rem;
  }

  .admin-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-panel-head .section-head {
    flex: 1;
  }

  .admin-range {
    padding: 0.3rem 0.4rem;
    font-size: 0.8125rem;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* The grid already spaces its cells; the panel's own margin doubled it, which
     showed up as a long gap under a short chart on a phone. The grid then owes
     the section after it the same space its cells get. */
  .admin-grid .admin-panel {
    margin-bottom: 0;
  }

  .admin-grid {
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .admin-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }

  .admin-canvas {
    display: block;
    width: 100%;
    height: 15rem;
    margin-top: 0.75rem;
  }

  /* display:block outranks the [hidden] default, so an empty panel kept its
     full canvas height and left a long blank between the heading and the
     line saying there was nothing to show. */
  .admin-canvas[hidden] {
    display: none;
  }

  .admin-canvas--tall {
    height: 11rem;
  }

  /* Sits directly under its heading, quiet enough to read as an absence
     rather than a message. */
  .admin-empty {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin: 0.5rem 0 0;
  }

  .admin-empty[hidden] {
    display: none;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  .admin-table th {
    text-align: left;
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(23, 21, 15, 0.45);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }
</style>

<script>
  import {
    adminStats, adminEvents, adminProposals, adminResolve, getUser,
    listSubmissions, confirmRecording, removeRecording,
    getRoundRecord, editRecording, FieldErrors,
    type AdminStats, type AdminEvent,
  } from '../lib/api';
  import { areaChart, barChart } from '../lib/chart';
  import { renderDiff, renderTimingDiff } from '../lib/diffview';
  import { playClip, stop, onClipChange } from '../lib/clip';
  import { parseSpan, type Span } from '../lib/speeches';
  import { formatTime } from '../lib/waveform';

  const lede = document.getElementById('admin-lede')!;
  const body = document.getElementById('admin-body')!;
  const denied = document.getElementById('admin-denied')!;

  const TOTAL_LABELS: Record<string, string> = {
    users: 'accounts', events: 'events', proposals: 'edits proposed',
    accepted: 'edits accepted', votes: 'votes', notes: 'notes', favorites: 'saved rounds',
  };

  let latest: AdminStats | null = null;

  function drawAll(stats: AdminStats) {
    const totals = document.getElementById('admin-totals')!;
    totals.innerHTML = '';
    for (const [key, label] of Object.entries(TOTAL_LABELS)) {
      const box = document.createElement('div');
      box.className = 'admin-stat';
      const v = document.createElement('span');
      v.className = 'admin-stat-value';
      v.textContent = String(stats.totals[key] ?? 0);
      const l = document.createElement('span');
      l.className = 'admin-stat-label';
      l.textContent = label;
      box.append(v, l);
      totals.appendChild(box);
    }

    // Days with no events still need a slot, or the curve misrepresents gaps.
    const byDay = new Map(stats.daily.map(d => [d.day, d.n]));
    const today = Math.floor(Date.now() / 86_400_000);
    const series: number[] = [];
    for (let d = today - stats.days + 1; d <= today; d++) series.push(byDay.get(d) ?? 0);
    areaChart(
      document.getElementById('chart-daily') as HTMLCanvasElement,
      series,
      [`${stats.days} days ago`, 'today'],
    );

    const panels: Array<[string, Array<{ label: string; value: number }>]> = [
      ['searches', stats.searches.map(s => ({ label: s.term, value: s.n }))],
      ['rounds', stats.rounds.map(r => ({ label: r.slug.replace(/-[a-z0-9]{6}$/, '').replace(/-/g, ' '), value: r.n }))],
      ['tags', stats.tags.map(t => ({ label: t.tag, value: t.n }))],
      ['kinds', stats.kinds.map(k => ({ label: k.kind, value: k.n }))],
    ];
    for (const [id, rows] of panels) {
      const canvas = document.getElementById(`chart-${id}`) as HTMLCanvasElement;
      const empty = document.getElementById(`empty-${id}`)!;
      empty.hidden = rows.length > 0;
      canvas.hidden = rows.length === 0;
      if (rows.length) {
        barChart(canvas, rows.slice(0, 10), canvas.dataset.accent === 'gold' ? 'gold' : 'sky');
      }
    }

    const tbody = document.getElementById('admin-contributors')!;
    tbody.innerHTML = '';
    for (const c of stats.contributors) {
      const tr = document.createElement('tr');
      for (const cell of [c.name, String(c.rep), String(c.proposals)]) {
        const td = document.createElement('td');
        td.textContent = cell;
        tr.appendChild(td);
      }
      tbody.appendChild(tr);
    }
  }

  async function load(days = 30) {
    const user = getUser();
    if (!user) {
      lede.textContent = 'Sign in as the administrator to view this page.';
      denied.hidden = false;
      return;
    }
    try {
      const stats = await adminStats(days);
      latest = stats;
      lede.textContent = `Signed in as ${user.display_name}. Last ${stats.days} days.`;
      denied.hidden = true;
      body.hidden = false;
      drawAll(stats);
      void pollEvents();
      void loadQueue();
      void loadPending();
      if (live && !timer) timer = setInterval(pollEvents, 5000);
    } catch (e: any) {
      lede.textContent = 'Access denied.';
      denied.hidden = false;
      body.hidden = true;
    }
  }

  // Live tail. Only rows newer than the last id are fetched, so the poll stays
  // cheap however long the page is left open.
  let lastEventId = 0;
  let live = true;
  let timer: ReturnType<typeof setInterval> | undefined;

  function describe(e: AdminEvent): string {
    let extra = '';
    try {
      const p = JSON.parse(e.payload || '{}');
      if (p.q) extra = `"${p.q}"`;
      else if (p.label) extra = p.label;
      else if (p.tag) extra = p.tag;
    } catch { /* payload is best effort */ }
    const where = e.slug ? e.slug.replace(/-[a-z0-9]{6}$/, '').replace(/-/g, ' ') : '';
    return [extra, where].filter(Boolean).join(' — ');
  }

  async function pollEvents() {
    try {
      const { events } = await adminEvents(lastEventId, 60);
      if (!events.length) return;
      const list = document.getElementById('admin-stream')!;
      // Ascending so the newest ends up on top after prepending.
      for (const e of [...events].reverse()) {
        if (e.id <= lastEventId) continue;
        lastEventId = Math.max(lastEventId, e.id);
        const li = document.createElement('li');
        if (lastEventId > 0) li.className = 'is-new';
        const at = document.createElement('span');
        at.className = 'stream-at';
        at.textContent = new Date(e.created_at * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const who = document.createElement('span');
        who.className = 'stream-who';
        who.textContent = e.who;
        const what = document.createElement('span');
        what.className = 'stream-what';
        what.textContent = `${e.kind} ${describe(e)}`.trim();
        li.append(at, who, what);
        list.prepend(li);
        setTimeout(() => li.classList.remove('is-new'), 2000);
      }
      while (list.children.length > 200) list.lastElementChild?.remove();
    } catch { /* keep polling */ }
  }

  async function loadQueue() {
    const list = document.getElementById('admin-queue')!;
    const empty = document.getElementById('queue-empty')!;
    const count = document.getElementById('queue-count')!;
    const { proposals } = await adminProposals().catch(() => ({ proposals: [] as any[] }));
    list.innerHTML = '';
    empty.hidden = proposals.length > 0;
    count.textContent = proposals.length ? `${proposals.length} open` : '';

    for (const p of proposals as any[]) {
      const li = document.createElement('li');
      li.dataset.proposal = p.id;

      const head = document.createElement('div');
      head.className = 'queue-head';
      const round = document.createElement('a');
      round.className = 'queue-round';
      round.href = `/recordings/${p.slug}`;
      round.textContent = p.slug.replace(/-[a-z0-9]{6}$/, '').replace(/-/g, ' ');
      const who = document.createElement('span');
      who.textContent = `${p.kind}   ${p.author}   score ${p.score}`;
      head.append(round, who);

      // A timing correction is a pair of times; a transcript correction is a
      // passage. Both read as a diff, but only one of them is prose.
      const span = p.kind === 'boundary' ? readSpans(p) : null;
      li.append(head, span
        ? renderTimingDiff(`${p.anchor}  ${describeSpan(span.from)}`, `${p.anchor}  ${describeSpan(span.to)}`)
        : renderDiff(p.original ?? '', p.proposed ?? ''));

      const actions = document.createElement('div');
      actions.className = 'queue-actions';

      // Reviewing means hearing it. The clip is the speech's opening for a
      // timing, and the moment around the passage for a transcript edit.
      const at = span ? span.to.start : (p.start_s ?? null);
      if (at !== null) {
        const listen = document.createElement('button');
        listen.className = 'chip clip-btn';
        listen.dataset.clip = p.id;
        listen.dataset.label = `Listen at ${formatTime(at)}`;
        listen.setAttribute('aria-pressed', 'false');
        listen.textContent = listen.dataset.label;
        listen.addEventListener('click', () => playClip(p.id, p.slug, Math.max(0, at - 2), {
          seconds: p.kind === 'boundary' ? 10 : 14,
        }));
        actions.appendChild(listen);
      }

      for (const action of ['accept', 'reject'] as const) {
        const b = document.createElement('button');
        b.className = 'chip';
        b.textContent = action === 'accept' ? 'Accept' : 'Reject';
        b.addEventListener('click', async () => {
          b.disabled = true;
          try {
            stop();
            await adminResolve(p.id, action);
            li.remove();
            void loadQueue();
          } catch { b.disabled = false; }
        });
        actions.appendChild(b);
      }

      li.append(actions);
      if (p.note) {
        const n = document.createElement('div');
        n.className = 'queue-note';
        n.textContent = p.note;
        li.appendChild(n);
      }
      list.appendChild(li);
    }
  }

  /**
   * Rounds that are in search but not yet playable. A submission is only half
   * arrived until the ingest run has pulled its audio, and this is the only
   * place that backlog is visible.
   */
  const STAGE: Record<string, string> = {
    pending: 'audio not pulled yet',
    ingested: 'audio in',
    failed: 'ingest failed',
  };

  async function loadPending() {
    const list = document.getElementById('admin-pending')!;
    const empty = document.getElementById('pending-empty')!;
    const count = document.getElementById('pending-count')!;
    const { submissions } = await listSubmissions().catch(() => ({ submissions: [] as any[] }));

    empty.hidden = submissions.length > 0;
    const unreviewed = submissions.filter((s: any) => s.review === 'unreviewed').length;
    count.textContent = unreviewed ? `${unreviewed} to look at` : '';
    list.innerHTML = '';

    for (const s of submissions) {
      const li = document.createElement('li');
      li.dataset.review = s.review;

      const head = document.createElement('div');
      head.className = 'queue-head';
      const round = document.createElement('a');
      round.className = 'queue-round';
      round.href = `/recordings/${s.slug}`;
      round.textContent = s.title;
      // Commas, and the submitter named as one. Three spaces between fields
      // collapse to one in HTML, which read "dev audio in": a display name and
      // an ingest stage running together as a phrase that means nothing.
      const meta = document.createElement('span');
      meta.textContent = [s.year, s.tournament, s.author && `submitted by ${s.author}`]
        .filter(Boolean).join(', ');
      head.append(round, meta);

      const src = document.createElement('div');
      src.className = 'queue-note';
      src.textContent = s.note ? `${s.link}   ${s.note}` : s.link;

      li.append(head, src);

      const actions = document.createElement('div');
      actions.className = 'queue-actions';

      const stage = document.createElement('span');
      stage.className = 'queue-stage';
      stage.dataset.status = s.status;
      stage.textContent = STAGE[s.status] ?? s.status;
      actions.append(stage);

      if (s.review === 'confirmed') {
        const kept = document.createElement('span');
        kept.className = 'submission-kept';
        kept.textContent = 'confirmed';
        actions.append(kept);
      } else {
        const keep = document.createElement('button');
        keep.className = 'chip';
        keep.textContent = 'Confirm';
        keep.addEventListener('click', async () => {
          keep.disabled = true;
          try { await confirmRecording(s.object_id); void loadPending(); }
          catch { keep.disabled = false; }
        });
        actions.append(keep);
      }

      const edit = document.createElement('button');
      edit.className = 'chip';
      edit.textContent = 'Edit';
      edit.setAttribute('aria-expanded', 'false');
      edit.addEventListener('click', () => {
        const open = edit.getAttribute('aria-expanded') === 'true';
        edit.setAttribute('aria-expanded', String(!open));
        if (open) { li.querySelector('.sub-edit')?.remove(); return; }
        void openEditor(li, s, edit);
      });
      actions.append(edit);

      // Removal deletes the media as well as the listing, so it asks first.
      const drop = document.createElement('button');
      drop.className = 'chip';
      drop.textContent = 'Remove';
      drop.addEventListener('click', async () => {
        const why = window.prompt(
          `Remove "${s.title}"?\n\nThis takes it out of search and deletes its `
          + `audio, transcript and speech timings. It cannot be undone.\n\n`
          + `Reason (optional):`);
        if (why === null) return;
        drop.disabled = true;
        try { await removeRecording(s.object_id, why || undefined); void loadPending(); }
        catch { drop.disabled = false; }
      });
      actions.append(drop);

      li.append(actions);
      list.appendChild(li);
    }
  }

  /**
   * Corrects what a submitted round says.
   *
   * Submitters describe a round in their own words, and a title with a typo
   * in it is a round nobody searching finds. The fields come from the record
   * itself rather than the queue, because the queue only knows the handful of
   * columns the database keeps.
   *
   * What cannot be edited here: the slug, which is the round's address and the
   * name its audio is filed under, and the link, because a different link is a
   * different recording and has to be probed and ingested rather than typed
   * over.
   */
  const EDIT_FIELDS: Array<{ name: string; label: string; kind?: 'select'; options?: Array<[string, string]> }> = [
    { name: 'title', label: 'Round title' },
    { name: 'resolution', label: 'Resolution' },
    { name: 'aff', label: 'Aff' },
    { name: 'neg', label: 'Neg' },
    { name: 'tags', label: 'Tags' },
    { name: 'decision', label: 'Decision' },
    { name: 'year', label: 'Year' },
    { name: 'tournament', label: 'Tournament' },
    { name: 'format', label: 'Format', kind: 'select', options: [['parli', 'parli'], ['policy', 'policy']] },
    { name: 'level', label: 'Level', kind: 'select', options: [['college', 'college'], ['hs', 'high school']] },
  ];

  async function openEditor(li: HTMLElement, s: any, edit: HTMLButtonElement) {
    const form = document.createElement('form');
    form.className = 'sub-edit';
    form.innerHTML = '<p class="queue-note">Reading the round.</p>';
    li.append(form);

    let record: any;
    try {
      ({ record } = await getRoundRecord(s.object_id));
    } catch (err) {
      form.innerHTML = '';
      const failed = document.createElement('p');
      failed.className = 'queue-note';
      failed.textContent = `Could not read the round: ${(err as Error).message}`;
      form.append(failed);
      return;
    }

    form.innerHTML = '';
    const grid = document.createElement('div');
    grid.className = 'sub-edit-grid';

    for (const f of EDIT_FIELDS) {
      const wrap = document.createElement('label');
      wrap.className = 'sub-edit-field';
      const name = document.createElement('span');
      name.className = 'label label-muted';
      name.textContent = f.label;

      let input: HTMLInputElement | HTMLSelectElement;
      if (f.kind === 'select') {
        input = document.createElement('select');
        input.className = 'field';
        for (const [value, text] of f.options!) {
          const opt = document.createElement('option');
          opt.value = value;
          opt.textContent = text;
          input.append(opt);
        }
        input.value = record[f.name] ?? '';
      } else {
        input = document.createElement('input');
        input.type = 'text';
        input.className = 'field';
        input.value = f.name === 'tags'
          ? (record._tags ?? []).join(', ')
          : (record[f.name] ?? '');
      }
      input.name = f.name;
      // The ones that hold a sentence get the whole row; a resolution or a neg
      // in a fifth of the width is a field you have to scroll to read.
      if (['title', 'resolution', 'aff', 'neg', 'tags'].includes(f.name)) {
        wrap.classList.add('sub-edit-wide');
      }
      // The two descriptions are filed in lower case, so the field shows what
      // will be filed rather than leaving the server to correct it quietly.
      if (f.name === 'aff' || f.name === 'neg') {
        input.addEventListener('blur', () => { input.value = input.value.trim().toLowerCase(); });
      }

      const hint = document.createElement('span');
      hint.className = 'sub-edit-hint';
      wrap.append(name, input, hint);
      grid.append(wrap);
    }

    const actions = document.createElement('div');
    actions.className = 'queue-actions';
    const save = document.createElement('button');
    save.className = 'chip';
    save.type = 'submit';
    save.textContent = 'Save';
    const cancel = document.createElement('button');
    cancel.className = 'chip';
    cancel.type = 'button';
    cancel.textContent = 'Cancel';
    cancel.addEventListener('click', () => { form.remove(); edit.setAttribute('aria-expanded', 'false'); });
    const status = document.createElement('span');
    status.className = 'label label-muted sub-edit-status';
    actions.append(save, cancel, status);

    form.append(grid, actions);

    form.addEventListener('submit', async e => {
      e.preventDefault();
      form.querySelectorAll<HTMLElement>('.sub-edit-hint').forEach(h => { h.textContent = ''; });
      status.textContent = '';

      const value = (name: string) =>
        (form.querySelector(`[name="${name}"]`) as HTMLInputElement).value.trim();
      const tags = value('tags').split(',').map(t => t.trim()).filter(Boolean);

      save.disabled = true;
      try {
        const saved = await editRecording(s.object_id, {
          title: value('title'),
          resolution: value('resolution'),
          aff: value('aff'),
          neg: value('neg'),
          decision: value('decision'),
          year: value('year'),
          tournament: value('tournament'),
          format: value('format'),
          level: value('level'),
          tags,
        });
        // Search has it already. Whether the round's own page has it depends on
        // a rebuild, so say which of the two happened rather than leaving the
        // admin to wonder why the page still reads the old way.
        status.textContent = saved.rebuilding
          ? 'Saved. The page is rebuilding.'
          : 'Saved. The page follows on the next deploy.';
        setTimeout(() => {
          form.remove();
          edit.setAttribute('aria-expanded', 'false');
          void loadPending();
        }, 1400);
      } catch (err) {
        save.disabled = false;
        if (err instanceof FieldErrors) {
          for (const [name, message] of Object.entries(err.fields)) {
            const field = form.querySelector(`[name="${name}"]`);
            const hint = field?.parentElement?.querySelector('.sub-edit-hint');
            if (hint) hint.textContent = message;
          }
          status.textContent = 'Not saved';
        } else {
          status.textContent = (err as Error).message;
        }
      }
    });
  }

  function readSpans(p: any): { from: Span; to: Span } | null {
    const to = parseSpan(p.proposed ?? '');
    const from = parseSpan(p.original ?? '', to ?? undefined);
    return from && to ? { from, to } : null;
  }

  function describeSpan(s: Span): string {
    return `${formatTime(s.start)} to ${formatTime(s.end)}`;
  }

  // One clip plays at a time, so every button reads the same signal.
  onClipChange(id => {
    document.querySelectorAll<HTMLElement>('[data-clip]').forEach(b => {
      const on = b.dataset.clip === id;
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? 'Stop' : b.dataset.label!;
    });
  });

  document.getElementById('stream-toggle')?.addEventListener('click', e => {
    live = !live;
    (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(live));
    (e.currentTarget as HTMLElement).textContent = live ? 'Live' : 'Paused';
    if (live) timer = setInterval(pollEvents, 5000);
    else clearInterval(timer);
  });

  document.getElementById('admin-days')?.addEventListener('change', e => {
    void load(Number((e.currentTarget as HTMLSelectElement).value));
  });
  window.addEventListener('resize', () => { if (latest) drawAll(latest); });
  document.addEventListener('gt:signed-in', () => void load());

  void load();
</script>
