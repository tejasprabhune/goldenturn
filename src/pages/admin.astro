---
/**
 * The admin console.
 *
 * One page with a sidebar of sections, one section showing at a time, chosen
 * by the address hash so each can be linked to: `/admin/#submissions`, and a
 * single record as `/admin/#submissions/<id>` or `/admin/#users/<id>`.
 * Everything is drawn in the browser from the Worker's admin endpoints; the
 * page itself is static and holds no data.
 *
 * The site's masthead is hidden here (see `src/styles/admin.css`): the
 * sidebar carries the mark, and the sign-in dialog the layout provides is
 * opened from the console's own prompt.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/admin/Sidebar.astro';
import { SECTIONS } from '../lib/admin/sections';
import '../styles/admin.css';
---

<BaseLayout title="Admin | the golden turn" description="Site administration." noFooter>
  <div class="adm" id="adm">
    <Sidebar />
    <div class="adm-sheet">
      <div class="adm-gate" id="adm-gate" role="status">
        <h1>Admin</h1>
        <p id="adm-gate-text">Checking access.</p>
        <pre class="adm-pre" id="adm-gate-detail" hidden></pre>
        <div class="adm-actions" id="adm-gate-actions"></div>
      </div>

      <p class="adm-banner" id="adm-banner" role="alert" hidden></p>

      {SECTIONS.map(s => (
        <section class="adm-view" id={`view-${s.id}`} data-view={s.id} aria-labelledby={`title-${s.id}`} hidden>
          <header class="adm-head">
            <h1 id={`title-${s.id}`}>{s.label}</h1>
            <div class="adm-head-tools" data-tools></div>
          </header>
          <div class="adm-view-body" data-body></div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { boot } from '../lib/admin/console';
  boot();
</script>
