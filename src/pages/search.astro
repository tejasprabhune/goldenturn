---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/reccard.css';
---

<BaseLayout title="Search | the golden turn">
  <div class="shell page-head">
    <h1 class="page-title">search</h1>
  </div>

  <div class="shell page-body search-page">
    <input
      id="search-input"
      type="search"
      placeholder="Search everything"
      autocomplete="off"
      autofocus
      class="field"
      style="width: 100%; margin-bottom: 2rem;"
    />

    <p id="results-count" class="label label-muted hidden" style="margin-bottom: 1.5rem;"></p>
    <div id="results"></div>

    <p id="empty-state" class="page-lede">
      Start typing to search across the curriculum, recordings, and lectures.
    </p>
  </div>
</BaseLayout>

<script>
  import { algoliasearch } from 'algoliasearch';
  import { renderRecordingCard, createCardList, hydrateRatings, escapeHtml } from '../lib/reccard';

  const APP_ID = import.meta.env.PUBLIC_ALGOLIA_APP_ID as string;
  const SEARCH_KEY = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY as string;

  const client = algoliasearch(APP_ID, SEARCH_KEY);

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('results') as HTMLDivElement;
  const resultsCount = document.getElementById('results-count') as HTMLParagraphElement;
  const emptyState = document.getElementById('empty-state') as HTMLParagraphElement;

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let focusedIndex = -1;
  let allLinks: HTMLAnchorElement[] = [];

  // Ks, files, and playbooks are offline, so their hits are dropped.
  const GROUP_ORDER = ['curriculum', 'recording', 'lecture'];
  const GROUP_LABELS: Record<string, string> = {
    curriculum: 'curriculum',
    recording: 'recordings',
    lecture: 'lectures',
  };

  /**
   * Rounds found here are the same cards as on the recordings list, wired the
   * same way. A tag leads to the list already filtered by it, since filtering
   * a mixed result set by a recordings-only facet would be strange.
   */
  const cards = createCardList(resultsEl, {
    onTag(tag) { window.location.href = `/recordings?tag=${encodeURIComponent(tag)}`; },
  });

  interface Hit {
    objectID: string;
    type?: string;
    title?: string;
    name?: string;
    url?: string;
    link?: string;
    description?: string;
    resolution?: string;
    _isRecording?: boolean;
  }

  async function runSearch(query: string) {
    if (!query.trim()) {
      resultsEl.innerHTML = '';
      resultsCount.classList.add('hidden');
      emptyState.classList.remove('hidden');
      focusedIndex = -1;
      allLinks = [];
      return;
    }

    emptyState.classList.add('hidden');

    const [contentHits, recordingHits] = await Promise.all([
      client
        .searchSingleIndex({ indexName: 'goldenturn_content', searchParams: { query, hitsPerPage: 40 } })
        .then(r => r.hits as Hit[])
        .catch(() => [] as Hit[]),
      client
        .searchSingleIndex({ indexName: 'all_rounds', searchParams: { query, hitsPerPage: 15 } })
        .then(r => (r.hits as Hit[]).map(h => ({ ...h, type: 'recording', _isRecording: true })))
        .catch(() => [] as Hit[]),
    ]);

    const all = [...contentHits, ...recordingHits].filter(h => GROUP_ORDER.includes(h.type ?? ''));
    const total = all.length;

    // Group by type
    const groups: Record<string, Hit[]> = {};
    for (const hit of all) {
      const type = hit.type ?? 'other';
      if (!groups[type]) groups[type] = [];
      groups[type].push(hit);
    }

    resultsCount.textContent = `${total} result${total === 1 ? '' : 's'}`;
    resultsCount.classList.toggle('hidden', total === 0);

    resultsEl.innerHTML = '';
    focusedIndex = -1;
    allLinks = [];

    const orderedTypes = [
      ...GROUP_ORDER.filter(t => groups[t]?.length),
      ...Object.keys(groups).filter(t => !GROUP_ORDER.includes(t) && groups[t]?.length),
    ];

    if (total === 0) {
      resultsEl.innerHTML = `<p class="page-lede">No results for "${escapeHtml(query)}".</p>`;
      return;
    }

    for (const type of orderedTypes) {
      const hits = groups[type];
      const label = GROUP_LABELS[type] ?? type;

      const section = document.createElement('div');
      section.className = 'result-group';
      section.innerHTML = `<p class="section-head">${escapeHtml(label)}</p>`;

      // Rounds get the recordings list's card; everything else is a plain link.
      if (type === 'recording') {
        const list = document.createElement('div');
        list.className = 'rec-results';
        list.innerHTML = hits.map(h => renderRecordingCard(h as Record<string, unknown>)).join('');
        section.appendChild(list);
        void hydrateRatings(list);
        list.querySelectorAll<HTMLAnchorElement>('.rec-card__link').forEach(a => {
          a.setAttribute('data-index', String(allLinks.length));
          allLinks.push(a);
        });
      } else {
        for (const hit of hits) {
          const a = document.createElement('a');
          a.href = escapeHtml(hit.url ?? '#');
          a.className = 'result-link';
          a.setAttribute('data-index', String(allLinks.length));
          a.innerHTML = `
            <span class="result-title">${escapeHtml((hit.title ?? hit.name ?? '') as string)}</span>
            ${hit.description ? `<span class="result-desc">${escapeHtml(hit.description)}</span>` : ''}
          `;
          section.appendChild(a);
          allLinks.push(a);
        }
      }

      resultsEl.appendChild(section);
    }
  }

  // Keyboard navigation through results
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      focusedIndex = Math.min(focusedIndex + 1, allLinks.length - 1);
      updateFocus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      focusedIndex = Math.max(focusedIndex - 1, -1);
      updateFocus();
    } else if (e.key === 'Enter' && focusedIndex >= 0 && allLinks[focusedIndex]) {
      allLinks[focusedIndex].click();
    }
  });

  function updateFocus() {
    allLinks.forEach((a, i) => {
      a.classList.toggle('is-focused', i === focusedIndex);
    });
    if (focusedIndex >= 0) allLinks[focusedIndex]?.scrollIntoView({ block: 'nearest' });
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => runSearch(searchInput.value.trim()), 150);
  });

  // Pre-fill from ?q= param
  const q = new URLSearchParams(window.location.search).get('q') ?? '';
  if (q) {
    searchInput.value = q;
    runSearch(q);
  }
</script>
