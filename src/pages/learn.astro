---
/**
 * Curriculum and lectures on one page.
 *
 * They were two nav entries for one thing: written explanations of how the
 * event works, and recorded ones. Splitting them made the nav longer and left
 * lectures as an entry that only ever said "coming soon".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const SECTION_ORDER = ['goals', 'foundations'] as const;
const SECTION_LABELS: Record<string, string> = {
  goals: 'goals',
  foundations: 'foundations',
};

const articles = await getCollection('curriculum', ({ data }) => !data.draft);
const lectures = await getCollection('lectures').catch(() => []);

const grouped = SECTION_ORDER.reduce<Record<string, CollectionEntry<'curriculum'>[]>>((acc, section) => {
  acc[section] = articles
    .filter(a => a.data.section === section)
    .sort((a, b) => a.data.order - b.data.order);
  return acc;
}, {} as Record<string, CollectionEntry<'curriculum'>[]>);

function articleHref(entry: CollectionEntry<'curriculum'>) {
  const parts = entry.id.replace(/\.(mdx?|typ)$/, '').split('/');
  return `/curriculum/${parts[0]}/${parts.slice(1).join('/')}`;
}
---

<BaseLayout
  title="Learn | the golden turn"
  description="A complete guide to college parliamentary debate, from first principles to advanced theory."
>
  <div class="shell page-head">
    <h1 class="page-title">learn</h1>
    <p class="page-lede">
      A complete guide to college parliamentary debate, from first principles to
      advanced theory.
    </p>
  </div>

  <div class="shell page-body">
    {SECTION_ORDER.map(section => {
      const sectionArticles = grouped[section];
      if (!sectionArticles || sectionArticles.length === 0) return null;
      return (
        <section id={section}>
          <p class="section-head">{SECTION_LABELS[section]}</p>
          <ul class="row-list">
            {sectionArticles.map((entry, i) => (
              <li>
                <a href={articleHref(entry)} class="row">
                  <span class="row-index">{String(i + 1).padStart(2, '0')}</span>
                  <span class="row-title">{entry.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <section id="lectures">
      <p class="section-head">lectures</p>
      {lectures.length > 0 ? (
        <ul class="row-list">
          {lectures.map((entry, i) => (
            <li>
              <a href={entry.data.video_url ?? '#'} class="row"
                 target="_blank" rel="noopener noreferrer">
                <span class="row-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="row-title">{entry.data.title}</span>
                <span class="row-meta">{entry.data.speaker}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="learn-empty">Recorded talks and workshops. Coming soon.</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .learn-empty {
    font-size: 0.9375rem;
    color: var(--ink-muted);
    margin: 0.75rem 0 3rem;
  }
</style>
