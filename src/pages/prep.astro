---
/**
 * Prep: instant search over the backfiles, for the 25 minutes before a round.
 *
 * Private. The page ships empty: who may see it is decided by the Worker when
 * the browser asks for a search key, and every block arrives from the prep
 * index with that key, so nothing from the files is in this HTML.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/prep.css';
---

<BaseLayout title="Prep | the golden turn" description="" noFooter>
  <div class="prep" id="prep">
    <p class="prep-gate" id="prep-gate" role="status" hidden></p>

    <div class="prep-app" id="prep-app" hidden>
      <section class="prep-left" aria-label="Search">
        <div class="prep-bar">
          <input
            id="prep-q"
            class="prep-q"
            type="search"
            placeholder="two or three words"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="go"
            aria-label="Search prep blocks"
            aria-controls="prep-list"
            aria-activedescendant=""
          />
          <span class="prep-rtt" id="prep-rtt" title="Round trip of the last search"></span>
        </div>

        <div class="prep-filters">
          <div class="seg" role="group" aria-label="Side">
            <button class="chip" type="button" data-side="aff" aria-pressed="false">aff</button>
            <button class="chip" type="button" data-side="neg" aria-pressed="false">neg</button>
          </div>
          <div class="seg" role="group" aria-label="Block type">
            <button class="chip" type="button" data-type="uq" aria-pressed="false">UQ</button>
            <button class="chip" type="button" data-type="link" aria-pressed="false">Link</button>
            <button class="chip" type="button" data-type="il" aria-pressed="false">IL</button>
            <button class="chip" type="button" data-type="impact" aria-pressed="false">Impact</button>
            <button class="chip" type="button" data-type="answer" aria-pressed="false">AT</button>
            <button class="chip" type="button" data-type="other" aria-pressed="false">Other</button>
          </div>
          <select class="prep-file" id="prep-file" aria-label="File">
            <option value="">all files</option>
          </select>
        </div>

        <p class="prep-status" id="prep-status" aria-live="polite"></p>
        <ol class="prep-list" id="prep-list" role="listbox" aria-label="Blocks"></ol>

        <p class="prep-keys" aria-hidden="true">
          <span><kbd>↑↓</kbd>move</span>
          <span><kbd>→</kbd>open</span>
          <span><kbd>←</kbd>up</span>
          <span><kbd>↵</kbd>copy</span>
          <span><kbd>⇧↵</kbd>copy link</span>
          <span><kbd class="js-mod">⌘</kbd><kbd>↵</kbd>open doc</span>
          <span><kbd>/</kbd><kbd>esc</kbd>search</span>
        </p>
      </section>

      <section class="prep-right" id="prep-view" aria-label="Selected block"></section>
    </div>

    <div class="prep-toast" id="prep-toast" role="status" aria-live="polite"></div>
  </div>
</BaseLayout>

<script>
  import { getUser } from '../lib/api';
  import { PrepRefusal, type PrepRefusalReason } from '../lib/prep/access';
  import { PrepSearch, type PrepFilters, type PrepHit } from '../lib/prep/search';
  import { blockHtml, blockText, copyPlain, copyRich } from '../lib/prep/clipboard';
  import {
    escapeHtml, familyHead, fileRowHtml, readView, rowHtml, summarise, tocHtml, viewHref, viewHtml, viewQuery,
    MOD, NO_VIEW, type FileSummary, type PrepView,
  } from '../lib/prep/render';
  import type { PrepRecord, PrepSide, PrepType } from '../lib/prep/types';

  const gate = document.getElementById('prep-gate') as HTMLParagraphElement;
  const app = document.getElementById('prep-app') as HTMLDivElement;
  const input = document.getElementById('prep-q') as HTMLInputElement;
  const rtt = document.getElementById('prep-rtt') as HTMLSpanElement;
  const statusEl = document.getElementById('prep-status') as HTMLParagraphElement;
  const list = document.getElementById('prep-list') as HTMLOListElement;
  const view = document.getElementById('prep-view') as HTMLElement;
  const fileSelect = document.getElementById('prep-file') as HTMLSelectElement;
  const toast = document.getElementById('prep-toast') as HTMLDivElement;

  document.querySelectorAll('.js-mod').forEach(el => { el.textContent = MOD === '⌘' ? '⌘' : 'Ctrl'; });

  // The panes size themselves to the window under the masthead.
  const masthead = document.querySelector('.masthead');
  const setTop = () => document.documentElement.style.setProperty(
    '--prep-top', `${Math.ceil(masthead?.getBoundingClientRect().bottom ?? 64)}px`);
  setTop();
  window.addEventListener('resize', setTop);

  const search = new PrepSearch();
  const filters: PrepFilters = { sides: new Set(), types: new Set(), file: null };

  /** What the list shows: the file index, or blocks (a file's, or a search's). */
  type Item = { kind: 'file'; file: FileSummary } | { kind: 'block'; hit: PrepHit };
  let items: Item[] = [];
  /** The highlighted row; -1 on a file's overview, where no row is picked yet. */
  let selected = 0;
  let files: FileSummary[] = [];
  let seq = 0;
  let offline = false;
  let lastQuery = '';
  /** Where the reader is. The URL always says the same. */
  let cur: PrepView = { ...NO_VIEW };
  /** The block in the right pane when one is open. */
  let openHit: PrepHit | null = null;

  /*
   * Moving around: the index, a search, a file's overview and an open block
   * are each a history entry, so Back returns to the last of them and a URL
   * reopens it. Up and down within a level (the next block, a filter) replace
   * the entry rather than adding one. Each entry remembers the one before it,
   * so going up (← or a link to the parent) can step back when that entry is
   * the parent, which keeps ← and Back the same and history from growing.
   */
  interface Entry { prep: true; prev: string | null }

  function entry(): Entry | null {
    const s = history.state as Entry | null;
    return s?.prep ? s : null;
  }

  function writeHistory(v: PrepView, how: 'push' | 'replace') {
    const url = `${location.pathname}${viewQuery(v)}`;
    if (how === 'push' && viewQuery(v) !== location.search) {
      history.pushState({ prep: true, prev: location.search } satisfies Entry, '', url);
    } else {
      history.replaceState({ prep: true, prev: entry()?.prev ?? null } satisfies Entry, '', url);
    }
  }

  /** 0 the index or a search, 1 a file, 2 a block. */
  const depth = (v: PrepView) => v.block ? 2 : v.file ? 1 : 0;
  const same = (a: PrepView, b: PrepView) => viewQuery(a) === viewQuery(b);

  function prevView(): PrepView | null {
    const prev = entry()?.prev;
    return prev == null ? null : readView(prev);
  }

  function parentOf(v: PrepView): PrepView | null {
    if (v.block) {
      const file = openHit?.objectID === v.block ? openHit.file_slug : v.file;
      return file ? { ...v, q: '', file, block: null } : null;
    }
    if (v.file) return { ...v, file: null };
    return null;
  }

  /**
   * Go to a view. Deeper, or another file, is a new entry; the same level is
   * a replacement. Shallower steps back when the entry before is that view,
   * or, going up, any view at that level of the same file: a block's parent
   * is its file whether the reader came from its overview or a search in it.
   */
  function navigate(t: PrepView, up = false) {
    endTyping();
    const dt = depth(t);
    const dc = depth(cur);
    if (dt < dc) {
      const prev = prevView();
      const isParent = prev && (up ? depth(prev) === dt && prev.file === t.file && !prev.block : same(prev, t));
      if (isParent) history.back();
      else go(t, 'replace');
      return;
    }
    go(t, dt > dc || t.file !== cur.file ? 'push' : 'replace');
  }

  function goUp(): boolean {
    const p = parentOf(cur);
    if (!p) return false;
    navigate(p, true);
    return true;
  }

  function go(t: PrepView, how: 'push' | 'replace' | 'none', opts: RenderOpts = {}) {
    if (how !== 'none') writeHistory(t, how);
    const from = cur;
    cur = t;
    filters.sides = new Set(t.side ? [t.side] : []);
    filters.types = new Set(t.types);
    filters.file = t.file;
    syncControls();
    if (input.value.trim() !== t.q) input.value = t.q;
    void render(from, opts);
  }

  window.addEventListener('popstate', () => {
    if (app.hidden) return;
    endTyping();
    go(readView(location.search), 'none');
  });

  /*
   * Typing: the first key after a pause or a move adds one entry, the rest of
   * that query replace it, so one Back undoes one query however it was typed.
   */
  let typing = false;
  let typingTimer: ReturnType<typeof setTimeout> | undefined;
  function endTyping() {
    typing = false;
    clearTimeout(typingTimer);
  }

  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (q === cur.q && !cur.block) return;
    go({ ...cur, q, block: null }, typing ? 'replace' : 'push');
    typing = true;
    clearTimeout(typingTimer);
    typingTimer = setTimeout(() => { typing = false; }, 1200);
  });

  const GATE: Record<PrepRefusalReason, string> = {
    signed_out: 'Prep is private. <button class="link account-link" type="button" data-signin>Sign in</button> with an account that has access.',
    not_allowed: 'This account does not have prep access. Ask Tejas to add it.',
    not_configured: 'Prep search is not set up yet.',
    offline: 'You are offline. Prep opens when the connection is back.',
    error: 'Prep could not reach the server. Try again in a moment.',
  };

  function showGate(reason: PrepRefusalReason) {
    app.hidden = true;
    gate.hidden = false;
    gate.innerHTML = GATE[reason];
    gate.querySelector('[data-signin]')?.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('gt:open-signin')));
    // Whatever was on screen goes: a revoked key must not leave blocks behind.
    list.innerHTML = '';
    view.innerHTML = '';
    items = [];
    openHit = null;
  }

  async function start() {
    if (!getUser()) return showGate('signed_out');
    try {
      await search.connect();
    } catch (e) {
      return showGate(e instanceof PrepRefusal ? e.reason : 'error');
    }
    gate.hidden = true;
    app.hidden = false;
    setTop();
    input.focus();
    statusEl.textContent = 'Loading the index…';

    try {
      files = summarise(await search.overview());
    } catch (e) {
      if (handleFailure(e)) return;
    }
    fileSelect.innerHTML = '<option value="">all files</option>' +
      files.map(f => `<option value="${escapeHtml(f.slug)}">${escapeHtml(f.title)}</option>`).join('');

    // A reload keeps the entry's link to the one before it.
    const v = readView(location.search);
    writeHistory(v, 'replace');
    go(v, 'none');
  }

  /** True when the failure ended the page (the gate is up). */
  function handleFailure(e: unknown): boolean {
    if (e instanceof PrepRefusal && (e.reason === 'signed_out' || e.reason === 'not_allowed')) {
      showGate(e.reason);
      return true;
    }
    setOffline(true);
    return false;
  }

  function setOffline(on: boolean) {
    offline = on;
    if (on) {
      rtt.textContent = 'no answer';
      rtt.dataset.slow = 'true';
      statusEl.innerHTML = `<span><span data-tone="warn">${navigator.onLine ? 'Search is not answering.' : 'Offline.'}</span> Showing the last results; they refresh when the connection is back.</span>`;
    }
  }

  window.addEventListener('online', () => { if (offline) void render(cur, { keepId: currentId() }); });
  window.addEventListener('offline', () => setOffline(true));

  function currentId(): string | undefined {
    const item = items[selected];
    return item?.kind === 'block' ? item.hit.objectID : undefined;
  }

  interface RenderOpts {
    /** Keep this block picked in a search if it is still there. */
    keepId?: string;
    /** A filter changed: an open block it hides closes rather than being fetched. */
    fromFilter?: boolean;
  }

  /**
   * Draws `cur`. Every keypress runs this with no debounce. Answers can come
   * back out of order, so each carries a sequence number and only the newest
   * is drawn.
   */
  async function render(from: PrepView, opts: RenderOpts = {}) {
    const mine = ++seq;
    const v = cur;
    app.dataset.level = v.block ? 'block' : v.q ? 'results' : v.file ? 'overview' : 'files';

    if (!v.q && !v.file && !v.block) {
      offline = false;
      rtt.textContent = '';
      openHit = null;
      items = files.map(file => ({ kind: 'file', file }));
      // Back out of a file lands on that file, not the top of the index.
      const back = files.findIndex(f => f.slug === from.file);
      selected = back >= 0 ? back : lastQuery ? 0 : Math.max(0, Math.min(selected, items.length - 1));
      const total = files.reduce((n, f) => n + f.blocks.length, 0);
      statusEl.innerHTML = `<span>${files.length} files</span><span>${total} blocks</span><span>type to search, or pick a file</span>`;
      lastQuery = '';
      renderList();
      return;
    }

    try {
      let fetched: PrepHit | null = null;
      // A block's URL from a copied link names no file; its file is its list.
      if (v.block && !v.q && !v.file) {
        fetched = await search.block(v.block);
        if (mine !== seq) return;
        if (!fetched) return missingBlock();
        cur = { ...v, file: fetched.file_slug };
        filters.file = cur.file;
        syncControls();
        writeHistory(cur, 'replace');
      }
      const res = cur.q ? await search.search(cur.q, filters) : await search.file(cur.file!, filters);
      if (mine !== seq) return;
      offline = false;
      const fresh = cur.q !== lastQuery;
      lastQuery = cur.q;
      items = res.hits.map(hit => ({ kind: 'block', hit }));
      openHit = null;

      if (cur.block) {
        const id = cur.block;
        const i = items.findIndex(it => it.kind === 'block' && it.hit.objectID === id);
        if (i >= 0) {
          selected = i;
          openHit = (items[i] as { hit: PrepHit }).hit;
        } else if (opts.fromFilter) {
          cur = { ...cur, block: null };
          writeHistory(cur, 'replace');
          app.dataset.level = cur.q ? 'results' : 'overview';
        } else {
          openHit = fetched ?? await search.block(id);
          if (mine !== seq) return;
          if (!openHit) return missingBlock();
          selected = -1;
        }
      }
      if (!cur.block) {
        if (!cur.q) {
          selected = -1;
        } else {
          const keepId = opts.keepId ?? from.block;
          const keep = keepId ? items.findIndex(it => it.kind === 'block' && it.hit.objectID === keepId) : -1;
          selected = keep >= 0 ? keep : fresh ? 0 : Math.max(0, Math.min(selected, items.length - 1));
        }
      }
      showRtt(res.ms);
      renderStatus(cur.q, res.nbHits);
      renderList();
    } catch (e) {
      if (mine !== seq) return;
      handleFailure(e);
    }
  }

  function missingBlock() {
    flashStatus('That block is no longer in the files.');
    const v: PrepView = { ...cur, block: null };
    writeHistory(v, 'replace');
    go(v, 'none');
  }

  function showRtt(ms: number) {
    // The client answers a repeated query from memory without a request.
    rtt.textContent = ms < 1.5 ? 'cached' : `${Math.round(ms)} ms`;
    rtt.dataset.slow = String(ms > 80);
    rtt.title = ms > 80 ? 'Round trip of the last search: over 80 ms' : 'Round trip of the last search';
  }

  function renderStatus(q: string, n: number) {
    const file = files.find(f => f.slug === cur.file);
    const parts: string[] = [];
    if (file) {
      const up = escapeHtml(viewHref({ ...cur, file: null, block: null }));
      parts.push(`<span class="prep-path"><a href="${up}" data-nav data-up>all files</a><span class="prep-sep">/</span>${escapeHtml(file.title)}</span>`);
    }
    parts.push(`<span>${q ? `${n} block${n === 1 ? '' : 's'}` : `${n} blocks in reading order`}</span>`);
    statusEl.innerHTML = parts.join('');
  }

  function renderList() {
    if (items.length === 0) {
      const q = cur.q;
      const narrowed = filters.sides.size || filters.types.size || filters.file;
      const what = q ? `Nothing for “${escapeHtml(q)}”` : 'No blocks in this file';
      list.innerHTML = `<li class="prep-empty">${what}${narrowed ? ' with these filters' : ''}.
        ${narrowed ? '<br><button class="link account-link" type="button" data-clear-filters>Clear the filters</button>' + (q ? ' or try fewer words.' : '.') : 'Try fewer words, or shorthand like “econ uq” or “a2 heg bad”.'}</li>`;
      list.querySelector('[data-clear-filters]')?.addEventListener('click', clearFilters);
      input.setAttribute('aria-activedescendant', '');
      renderView();
      return;
    }

    const inFile = Boolean(cur.file) && !cur.q;
    let html = '';
    let family = '';
    items.forEach((item, i) => {
      if (item.kind === 'file') {
        html += fileRowHtml(item.file, i, i === selected, cur);
        return;
      }
      if (inFile && item.hit.family !== family) {
        family = item.hit.family;
        html += familyHead(family);
      }
      html += rowHtml(item.hit, i, i === selected, !inFile);
    });
    list.innerHTML = html;
    input.setAttribute('aria-activedescendant', selected >= 0 ? `prep-opt-${selected}` : '');
    list.querySelector<HTMLElement>(`#prep-opt-${selected}`)?.scrollIntoView({ block: 'nearest' });
    renderView();
  }

  function renderView() {
    if (openHit) {
      view.innerHTML = viewHtml(openHit, cur);
    } else if (cur.file && !cur.q) {
      const f = files.find(x => x.slug === cur.file);
      view.innerHTML = f ? tocHtml(f, cur, true) : '';
    } else {
      const item = items[selected];
      if (!item) view.innerHTML = files.length ? hintHtml() : '';
      else view.innerHTML = item.kind === 'file' ? tocHtml(item.file, cur, false) : viewHtml(item.hit, cur);
    }
    view.scrollTop = 0;
  }

  function hintHtml() {
    return `<p class="prep-hint">Type two or three words: <kbd>econ da spending</kbd>, <kbd>a2 heg bad</kbd>, <kbd>tix thumpers</kbd>.
      <kbd>↑</kbd> <kbd>↓</kbd> to move, <kbd>↵</kbd> to copy the block into your doc.</p>`;
  }

  /** Moves the highlight without drawing the list again. */
  function setSelected(i: number, scroll = true) {
    list.querySelector(`#prep-opt-${selected}`)?.setAttribute('aria-selected', 'false');
    selected = i;
    const row = list.querySelector<HTMLElement>(`#prep-opt-${selected}`);
    row?.setAttribute('aria-selected', 'true');
    if (scroll) row?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', row ? `prep-opt-${selected}` : '');
  }

  /** Opens a row: a file as its overview, a block in the pane. */
  function openRow(i: number, how: 'push' | 'replace') {
    const item = items[i];
    if (!item) return;
    if (item.kind === 'file') {
      navigate({ ...cur, q: '', file: item.file.slug, block: null });
      return;
    }
    endTyping();
    cur = { ...cur, block: item.hit.objectID };
    writeHistory(cur, how);
    openHit = item.hit;
    app.dataset.level = 'block';
    setSelected(i);
    renderView();
  }

  function openFirst() {
    const i = items.findIndex(it => it.kind === 'block');
    if (i >= 0) openRow(i, 'push');
  }

  function move(delta: number) {
    if (!items.length) return;
    // From a file's overview, down opens its first block.
    if (selected < 0) {
      if (delta > 0) openFirst();
      return;
    }
    const next = Math.max(0, Math.min(items.length - 1, selected + delta));
    if (next === selected) return;
    if (cur.block) {
      openRow(next, 'replace');
      return;
    }
    setSelected(next);
    renderView();
  }

  let toastTimer: ReturnType<typeof setTimeout> | undefined;
  function flashStatus(html: string) {
    toast.innerHTML = html;
    toast.dataset.show = 'true';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.dataset.show = 'false'; }, 2200);
  }

  function markDone(act: string) {
    const btn = view.querySelector<HTMLElement>(`[data-act="${act}"]`);
    if (btn) {
      const label = btn.firstChild as Text;
      const before = label.textContent;
      btn.dataset.done = 'true';
      label.textContent = act === 'copy' ? 'Copied ' : 'Link copied ';
      setTimeout(() => { btn.dataset.done = 'false'; label.textContent = before; }, 1600);
    }
    const doc = document.getElementById('prep-doc');
    if (doc && act === 'copy') {
      doc.dataset.flash = 'true';
      setTimeout(() => { doc.dataset.flash = 'false'; }, 450);
    }
  }

  function currentBlock(): PrepRecord | null {
    if (openHit) return openHit;
    const item = items[selected];
    return item?.kind === 'block' ? item.hit : null;
  }

  // Both of these are started inside the key press or click, with nothing
  // awaited first, so the browser still counts it as the user's gesture.
  function copyBlock() {
    const rec = currentBlock();
    if (!rec) return;
    copyRich(blockHtml(rec), blockText(rec))
      .then(() => {
        markDone('copy');
        flashStatus(`<b>Copied</b> ${escapeHtml(rec.title)}. Paste it into your doc.`);
      })
      .catch(() => flashStatus('Could not copy. Select the block and copy it by hand.'));
  }

  function copyLink() {
    const rec = currentBlock();
    if (!rec) return;
    const url = `${location.origin}${viewHref({ ...NO_VIEW, file: rec.file_slug, block: rec.objectID })}`;
    copyPlain(url)
      .then(() => {
        markDone('link');
        flashStatus(`<b>Link copied</b> to ${escapeHtml(rec.title)}.`);
      })
      .catch(() => flashStatus('Could not copy the link.'));
  }

  function openDoc() {
    const rec = currentBlock();
    const item = items[selected];
    const file = !rec && item?.kind === 'file' ? item.file : files.find(f => f.slug === cur.file);
    const url = rec ? rec.doc_url : file?.docUrl;
    if (url) window.open(url, '_blank', 'noopener');
    else flashStatus('This file has no Google Doc yet.');
  }

  function syncControls() {
    document.querySelectorAll<HTMLButtonElement>('[data-side]').forEach(b =>
      b.setAttribute('aria-pressed', String(filters.sides.has(b.dataset.side as PrepSide))));
    document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach(b =>
      b.setAttribute('aria-pressed', String(filters.types.has(b.dataset.type as PrepType))));
    fileSelect.value = filters.file ?? '';
    fileSelect.dataset.active = String(Boolean(filters.file));
  }

  /** A filter is part of where the reader is, but a refinement of it: it replaces the entry. */
  function refine(t: PrepView) {
    go(t, 'replace', { fromFilter: true, keepId: currentId() });
    input.focus();
  }

  function clearFilters() {
    navigate({ ...cur, side: null, types: [], file: null, block: null });
    input.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-side]').forEach(b => b.addEventListener('click', () => {
    const side = b.dataset.side as PrepSide;
    // A side is a choice, not a set: picking neg while aff is on swaps them.
    refine({ ...cur, side: cur.side === side ? null : side });
  }));

  document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach(b => b.addEventListener('click', () => {
    const t = b.dataset.type as PrepType;
    const types = cur.types.includes(t) ? cur.types.filter(x => x !== t) : [...cur.types, t];
    refine({ ...cur, types });
  }));

  fileSelect.addEventListener('change', () => {
    navigate({ ...cur, file: fileSelect.value || null, block: null }, !fileSelect.value);
    input.focus();
  });

  // Links the page follows itself. A modified or middle click is left to the
  // browser, so any of them opens in a new tab.
  app.addEventListener('click', e => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-nav]');
    if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    e.stopPropagation();
    navigate(readView(new URL(a.href).search), a.hasAttribute('data-up'));
  }, { capture: true });

  list.addEventListener('click', e => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.prep-row');
    if (!row) return;
    const i = Number(row.dataset.index);
    const item = items[i];
    if (!item) return;
    // A block already open swaps for this one; otherwise this is a step in.
    openRow(i, cur.block ? 'replace' : 'push');
    // One column: the block is under the list, so take the reader to it.
    if (item.kind === 'block' && window.matchMedia('(max-width: 899px)').matches) {
      view.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  view.addEventListener('click', e => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (act === 'copy') copyBlock();
    else if (act === 'link') copyLink();
    else if (act === 'open-file') openRow(selected, 'push');
    else if (act === 'first-block') openFirst();
  });

  /**
   * Keys are caught on the window before anything else sees them, so `/` here
   * means the prep box rather than the site-wide search the layout opens.
   * Only keys this page uses are stopped.
   *
   * ← goes up a level and → opens the picked row. In the search box they
   * still move the caret: ← only acts when the box is empty or the caret is
   * at the start with nothing selected, → when the box is empty or the caret
   * is at the end, where the arrow would do nothing.
   */
  window.addEventListener('keydown', e => {
    if (app.hidden) return;
    const target = e.target as HTMLElement;
    const inBox = target === input;
    const inOther = !inBox && (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable);
    const onControl = !inBox && /^(BUTTON|A)$/.test(target.tagName);
    if (document.querySelector('dialog[open]')) return;
    if (e.isComposing) return;

    const stop = () => { e.preventDefault(); e.stopPropagation(); };
    const plain = !e.metaKey && !e.ctrlKey && !e.altKey && !e.shiftKey;
    const caret = (at: 'start' | 'end') => !inBox || !input.value ||
      (input.selectionStart === input.selectionEnd && input.selectionStart === (at === 'start' ? 0 : input.value.length));

    if (e.key === '/' && !inBox && !inOther) {
      stop();
      input.focus();
      input.select();
      return;
    }
    if (e.key === 'Escape') {
      stop();
      if (!inBox) {
        input.focus();
        input.select();
      } else if (input.value) {
        // First escape selects what was typed, so the next word replaces it.
        if (input.selectionStart === 0 && input.selectionEnd === input.value.length) {
          endTyping();
          go({ ...cur, q: '', block: null }, 'push');
        } else {
          input.select();
        }
      } else {
        goUp();
      }
      return;
    }
    if (inOther) return;

    if (e.key === 'ArrowLeft' && plain && caret('start')) {
      if (goUp()) stop();
      return;
    }
    if (e.key === 'ArrowRight' && plain && caret('end') && !cur.block) {
      stop();
      if (selected < 0) openFirst();
      else openRow(selected, 'push');
      return;
    }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      stop();
      move(e.key === 'ArrowDown' ? 1 : -1);
      return;
    }
    if (e.key === 'PageDown' || e.key === 'PageUp') {
      if (!inBox) return;
      stop();
      move(e.key === 'PageDown' ? 8 : -8);
      return;
    }
    if (e.key === 'Backspace' && inBox && !input.value && cur.file) {
      stop();
      goUp();
      return;
    }
    if (e.key === 'Enter' && !onControl) {
      stop();
      if (e.metaKey || e.ctrlKey) {
        openDoc();
        return;
      }
      if (selected < 0 && !openHit) {
        openFirst();
        return;
      }
      const item = items[selected];
      if (item?.kind === 'file') openRow(selected, 'push');
      else if (e.shiftKey) copyLink();
      else copyBlock();
    }
  }, { capture: true });

  document.addEventListener('gt:signed-in', () => { void start(); });

  void start();
</script>
