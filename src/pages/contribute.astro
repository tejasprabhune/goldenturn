---
import BaseLayout from '../layouts/BaseLayout.astro';

const REPO = 'https://github.com/tejasprabhune/goldenturn';

const sections = [
  {
    label: 'curriculum articles',
    body: `Fork the repo, add an MDX file to src/content/curriculum/[section]/, and submit a pull
      request. Articles use frontmatter for metadata (title, section, order) and MDX for content.`,
  },
];
---

<BaseLayout title="Contribute | the golden turn">
  <div class="shell page-head">
    <h1 class="page-title">contribute</h1>
    <p class="page-lede">
      the golden turn is open source and community maintained. Everything below happens on
      <a href={REPO} target="_blank" rel="noopener noreferrer" class="link">GitHub</a>.
    </p>
  </div>

  <div class="shell page-body">
    {sections.map(section => (
      <section class="block">
        <p class="label label-muted block-label">{section.label}</p>
        <div class="block-body">
          <p class="block-text">{section.body}</p>
        </div>
      </section>
    ))}

    <section class="block">
      <p class="label label-muted block-label">recordings</p>
      <div class="block-body">
        <p class="block-text">
          Use the <a href="/recordings/add" class="link">recording submission form</a> to submit a
          round link. Submissions go through a brief review: a GitHub issue is opened, and once
          approved an admin adds the record to the search index.
        </p>
      </div>
    </section>

    <section class="block">
      <p class="label label-muted block-label">issues</p>
      <div class="block-body">
        <p class="block-text">
          Found a bug or have a suggestion? Open an issue on the
          <a href={REPO} target="_blank" rel="noopener noreferrer" class="link">repo</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .block {
      grid-template-columns: repeat(12, 1fr);
    }

    .block-label {
      grid-column: 1 / span 2;
    }

    .block-body {
      grid-column: 3 / span 8;
    }
  }

  .block-label {
    padding-top: 0.3rem;
  }

  .block-text {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
    margin: 0;
  }
</style>
