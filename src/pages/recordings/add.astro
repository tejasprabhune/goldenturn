---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit a Recording | the golden turn">
  <div class="shell-prose page-head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/recordings">recordings</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">submit</span>
    </nav>
    <h1 class="page-title">submit a recording</h1>
    <p class="page-lede">
      Please try to follow the format as described for maintainability. Your
      round will be available to search immediately. The audio, transcript, and
      speech markers are processed after and will be visible within an hour.
      Email me: <a href="mailto:prabhune@berkeley.edu" class="link">prabhune@berkeley.edu</a>
      if you're having issues.
    </p>
  </div>

  <div class="shell-prose page-body">
    <p class="page-lede add-signin" id="add-signin" hidden style="margin-top: 0;">
      Please <button class="link account-link" id="add-signin-btn">sign in</button>
      to submit a recording, so it can be credited to you.
    </p>

    <form id="submission-form" novalidate hidden>

      <div class="mb-7">
        <label class="form-label" for="field-title">Round title <span class="form-required">required</span></label>
        <p class="form-hint">Stage, then both teams, e.g. Finals - Cal MR vs Rice AL</p>
        <input type="text" id="field-title" name="title" placeholder="Finals - Cal MR vs Rice AL"
          class="form-input" required />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-link">Link <span class="form-required">required</span></label>
        <p class="form-hint">
          A Dropbox, YouTube or Vimeo link to the recording itself, not to a
          folder.
        </p>
        <input type="text" id="field-link" name="link" placeholder="https://..."
          class="form-input" required />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-resolution">Resolution</label>
        <input type="text" id="field-resolution" name="resolution" placeholder="The USFG should..."
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-aff">Aff</label>
        <p class="form-hint">Describe aff strategy</p>
        <input type="text" id="field-aff" name="aff" placeholder="topical (war, econ)"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-neg">Neg</label>
        <p class="form-hint">Lead with N-off, e.g. 2-off</p>
        <input type="text" id="field-neg" name="neg" placeholder="2-off (framework-t, orientalism)"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-tags">Tags</label>
        <p class="form-hint">Comma-separated, each starting with #</p>
        <input type="text" id="field-tags" name="tags" placeholder="#topicality, #mlm"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-decision">Decision</label>
        <p class="form-hint">Aff or Neg for prelims, 3-0 Aff for panels</p>
        <input type="text" id="field-decision" name="decision" placeholder="3-0 Aff"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-7">
        <label class="form-label" for="field-year">Year</label>
        <p class="form-hint">e.g. 2020-21</p>
        <input type="text" id="field-year" name="year" placeholder="2020-21"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="mb-10">
        <label class="form-label" for="field-tournament">Tournament</label>
        <input type="text" id="field-tournament" name="tournament" placeholder="NPDA"
          class="form-input" />
        <p class="validation-hint"></p>
      </div>

      <div class="flex items-center gap-4">
        <button type="submit" id="submit-btn" class="btn submit-btn">
          Submit a recording
        </button>
        <p id="submit-error" class="form-hint hidden" style="margin: 0;"></p>
      </div>

    </form>

    <div id="success-state" class="hidden pt-2">
      <p class="page-lede" style="margin-top: 0;" id="success-line"></p>
      <p class="form-hint" id="success-detail"></p>
      <p style="margin-top: 1rem;">
        <a href="/recordings" class="link">Back to recordings</a>
        <span aria-hidden="true" style="opacity: 0.4; margin: 0 0.5rem;">/</span>
        <a href="#" class="link" id="success-round">Open the round</a>
        <span aria-hidden="true" style="opacity: 0.4; margin: 0 0.5rem;">/</span>
        <button class="link account-link" id="submit-another">Submit another</button>
      </p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .form-label {
    display: block;
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .form-input {
    display: block;
    width: 100%;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: 0.625rem 0.75rem;
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--ink);
    outline: none;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  .form-input::placeholder {
    color: rgba(23, 21, 15, 0.3);
  }
  .form-input:focus {
    border-color: var(--sky-deep);
    box-shadow: inset 0 0 0 1px var(--sky-deep);
  }

  .form-hint {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(23, 21, 15, 0.45);
    margin-bottom: 0.4rem;
    margin-top: 0;
  }

  .validation-hint {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.75rem;
    color: rgba(23, 21, 15, 0.5);
    margin-top: 0.3rem;
    min-height: 1rem;
  }

  /* A hint that is a refusal rather than advice reads as one. */
  .validation-hint[data-error] {
    color: var(--diff-del);
    font-weight: 500;
  }

  .form-required {
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(23, 21, 15, 0.4);
    text-transform: none;
  }

  .add-signin[hidden],
  #submission-form[hidden] {
    display: none;
  }

  .submit-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  // The write key used to live here, which meant anyone reading the bundle
  // could rewrite or empty the index. Submission goes through the Worker now,
  // which holds the key and validates before it writes.
  import { submitRecording, getUser, FieldErrors, NotSignedIn } from '../../lib/api';
  import { recordingHref } from '../../lib/recordings';

  const form = document.getElementById('submission-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitError = document.getElementById('submit-error') as HTMLParagraphElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;

  function getField(name: string): HTMLInputElement {
    return form.querySelector(`[name="${name}"]`) as HTMLInputElement;
  }

  function getHint(name: string): HTMLParagraphElement {
    return getField(name).nextElementSibling as HTMLParagraphElement;
  }

  const validators: Record<string, (v: string) => string | null> = {
    title: (v) => (v.trim() ? null : 'A round title is required'),
    link: (v) => {
      if (!v.trim()) return 'A link to the recording is required';
      if (!/^https?:\/\//i.test(v.trim())) return 'That does not look like a URL';
      // A folder link cannot be played, and the round would arrive empty.
      if (/dropbox\.com\/(home|scl\/fo)\//i.test(v)) return 'That is a folder; link the file itself';
      return null;
    },
    tags: (v) => {
      if (!v.trim()) return null;
      const bad = v.split(',').map(t => t.trim()).filter(t => t && !t.startsWith('#'));
      return bad.length ? 'Each tag should start with #' : null;
    },
    decision: (v) => {
      if (!v.trim()) return null;
      // Prelims are decided by one judge ("Aff"), elims by a panel ("3-0 Aff"),
      // and two-judge panels can split ("1-1 Split"). All three are valid.
      const ok = /^(\d+-\d+\s+(aff|neg)|aff|neg|\d+-\d+\s+split)$/i.test(v.trim());
      return ok ? null : 'Expected: Aff, Neg, 3-0 Aff, or 1-1 Split';
    },
    year: (v) => {
      if (!v.trim()) return null;
      return /^\d{4}-\d{2}$/.test(v.trim()) ? null : 'Expected: 2020-21';
    },
    neg: (v) => {
      if (!v.trim()) return null;
      return /\d+-off|off/i.test(v) ? null : 'Consider leading with N-off, e.g. 2-off (da, cp)';
    },
  };

  for (const [name, validate] of Object.entries(validators)) {
    const field = getField(name);
    const hint = getHint(name);
    field.addEventListener('blur', () => { hint.textContent = validate(field.value) ?? ''; });
    field.addEventListener('input', () => { hint.textContent = validate(field.value) ?? ''; });
  }

  // Signed in or the form is not offered: a submission is credited to whoever
  // made it, and the server will refuse an anonymous one anyway.
  const signinNote = document.getElementById('add-signin')!;

  function renderAuth() {
    const signedIn = Boolean(getUser());
    form.hidden = !signedIn;
    signinNote.hidden = signedIn;
  }

  document.getElementById('add-signin-btn')?.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('gt:open-signin')));
  document.addEventListener('gt:signed-in', renderAuth);
  renderAuth();

  function showFieldErrors(fields: Record<string, string>) {
    for (const [name, message] of Object.entries(fields)) {
      const field = form.querySelector(`[name="${name}"]`) as HTMLInputElement | null;
      if (!field) continue;
      getHint(name).textContent = message;
      getHint(name).dataset.error = '1';
    }
    const first = Object.keys(fields)[0];
    getField(first)?.focus();
  }

  function clearErrors() {
    form.querySelectorAll<HTMLElement>('.validation-hint').forEach(h => {
      if (h.dataset.error) { h.textContent = ''; delete h.dataset.error; }
    });
    submitError.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const value = (name: string) => getField(name).value.trim();
    const tagsRaw = value('tags');
    const payload = {
      title: value('title'),
      link: value('link'),
      resolution: value('resolution'),
      aff: value('aff'),
      neg: value('neg'),
      decision: value('decision'),
      year: value('year'),
      tournament: value('tournament'),
      tags: tagsRaw ? tagsRaw.split(',').map(t => t.trim()).filter(t => t.startsWith('#')) : [],
    };

    // Catch what we can before the round trip; the server checks again.
    const local: Record<string, string> = {};
    for (const [name, validate] of Object.entries(validators)) {
      const message = validate(getField(name).value);
      if (message && (name === 'title' || name === 'link')) local[name] = message;
    }
    if (Object.keys(local).length) { showFieldErrors(local); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Checking the link...';

    try {
      const res = await submitRecording(payload);
      form.classList.add('hidden');
      successState.classList.remove('hidden');
      document.getElementById('success-line')!.textContent =
        `${payload.title} is in search.`;
      document.getElementById('success-detail')!.textContent =
        'Its audio, transcript and speech markers are being processed and '
        + 'should be on the page within an hour.';
      const open = document.getElementById('success-round') as HTMLAnchorElement;
      open.href = recordingHref({ title: payload.title, objectID: res.objectID });
    } catch (err) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit a recording';
      if (err instanceof FieldErrors) {
        showFieldErrors(err.fields);
      } else if (err instanceof NotSignedIn) {
        renderAuth();
        document.dispatchEvent(new CustomEvent('gt:open-signin'));
      } else {
        submitError.textContent = (err as Error).message ?? 'Submission failed. Please try again.';
        submitError.classList.remove('hidden');
      }
    }
  });

  document.getElementById('submit-another')?.addEventListener('click', () => {
    form.reset();
    clearErrors();
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit a recording';
    successState.classList.add('hidden');
    form.classList.remove('hidden');
    getField('title').focus();
  });
</script>
