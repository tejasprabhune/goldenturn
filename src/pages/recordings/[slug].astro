---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordingPlayer from '../../components/RecordingPlayer.astro';
import AccountBar from '../../components/AccountBar.astro';
import Transcript from '../../components/Transcript.astro';
import {
  fetchAllRecordings,
  fetchMediaIndex,
  recordingSlug,
  tagLabel,
  mediaKind,
  youtubeId,
  vimeoId,
  directMediaUrl,
  type Recording,
} from '../../lib/recordings';

export async function getStaticPaths() {
  const [recordings, media] = await Promise.all([fetchAllRecordings(), fetchMediaIndex()]);
  return recordings.map(entry => {
    const slug = recordingSlug(entry);
    return {
      params: { slug },
      props: {
        entry, slug,
        hasMedia: media.playable.has(slug),
      },
    };
  });
}

interface Props {
  entry: Recording;
  slug: string;
  hasMedia: boolean;
}

const { entry, slug, hasMedia } = Astro.props;

const kind = mediaKind(entry.link);
const ytId = kind === 'youtube' ? youtubeId(entry.link) : null;
const vimId = kind === 'vimeo' ? vimeoId(entry.link) : null;
const videoEmbed = ytId
  ? { kind: 'youtube' as const, id: ytId }
  : vimId
    ? { kind: 'vimeo' as const, id: vimId }
    : null;

// A third of the parli rounds were recorded as video and only ever had their
// audio pulled, so the picture is sitting at the original link unwatched. Half
// those links are dead, which is known already rather than discovered here.
const videoFile = kind === 'video' && entry.video_ok ? directMediaUrl(entry.link) : null;

const meta = [entry.year, entry.tournament].filter(Boolean).join(', ');
const tags = (entry._tags ?? []).filter(t => t.startsWith('#'));

// aff_type and neg_strategy_count are derived from the aff and neg text, so
// showing them here just repeats what the reader already has.
const facts: Array<[string, string]> = [];
if (entry.aff) facts.push(['aff', entry.aff]);
if (entry.neg) facts.push(['neg', entry.neg]);
---

<BaseLayout
  title={`${entry.title} | Recordings | the golden turn`}
  description={entry.resolution ?? 'A recorded parliamentary debate round.'}
>
  <!-- Compact is the layout unless a reader has asked for the reading one, and
       that choice is stamped on the root before paint so they never see compact
       flash first. The root attribute is the single source of truth; the module
       script below only toggles it. -->
  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem('gt:rec-layout') === 'reading') {
          document.documentElement.dataset.recLayout = 'reading';
        }
      } catch {}
    })();
  </script>

  <div class="rec-page" id="rec-page">
    <div class="shell page-head rec-page-head">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/recordings">recordings</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{entry.title}</span>
        </nav>

        <h1 class="page-title rec-title">{entry.title}</h1>
        <!-- Filled in by the client: the average is a live number, and this
             page is built once and served to everyone. -->
        <div class="rec-rating" id="rec-rating" data-slug={slug}></div>
        {meta && <p class="page-lede">{meta}</p>}
      </div>

      <div class="rec-head-actions">
        <button class="chip" id="account-fav" aria-pressed="false" hidden>Save round</button>
        <button class="chip rec-layout-toggle" id="rec-layout-toggle" aria-pressed="true">
          Reading layout
        </button>
      </div>
    </div>

    <div class="shell page-body rec-grid">
      <!--
        The player and the round's facts sit in one column in compact and in
        separate ones in the reading layout, so they are wrapped. The wrapper is
        display:contents outside compact, which hands its children back to the
        grid to be placed by their own areas.
      -->
      <div class="rec-area-left">
        <div class="rec-area-play">
          {entry.resolution && (
            <section class="rec-block">
              <p class="label label-muted">resolution</p>
              <p class="rec-resolution">{entry.resolution}</p>
            </section>
          )}

          <section class="rec-block">
            <p class="label label-muted">player</p>
            <RecordingPlayer
              slug={slug}
              title={entry.title}
              hasMedia={hasMedia}
              videoEmbed={videoEmbed}
              videoFile={videoFile}
              sourceLink={entry.link}
            />
            <p class="rec-original">
              <a href={entry.link} target="_blank" rel="noopener noreferrer" class="link">open original source</a>
            </p>
          </section>
        </div>

        <aside class="rec-area-meta rec-side">
          {facts.length > 0 && (
            <section class="rec-block">
              <p class="label label-muted">strategy</p>
              <dl class="rec-facts">
                {facts.map(([term, value]) => (
                  <>
                    <dt class="label label-muted">{term}</dt>
                    <dd>{value}</dd>
                  </>
                ))}
              </dl>
            </section>
          )}

          {entry.decision && (
            <section class="rec-block">
              <p class="label label-muted">decision</p>
              <p>
                <button id="decision" class="rec-decision" data-revealed="false" aria-label="Reveal decision">
                  {entry.decision}
                </button>
              </p>
            </section>
          )}

          {tags.length > 0 && (
            <section class="rec-block">
              <p class="label label-muted">tags</p>
              <div class="tag-list">
                {tags.map(tag => (
                  <a class="tag" href={`/recordings?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>
                ))}
              </div>
            </section>
          )}
        </aside>
      </div>

      <div class="rec-area-right">
        <div class="rec-area-tx">
          <Transcript slug={slug} />
        </div>

        <div class="rec-area-notes">
          <AccountBar slug={slug} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* The same face as the recordings list, a few sizes up. A round title is a
     string of team codes and abbreviations, which the display serif sets
     poorly and lowercasing makes worse. */
  .rec-title {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-transform: none;
  }

  .rec-page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .rec-head-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    margin-top: 0.35rem;
  }

  .rec-head-actions [hidden] {
    display: none;
  }

  /* One grid for the whole round, so the two layouts are the same content in
     different places rather than two markups kept in step by hand. */
  .rec-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 3rem;
    grid-template-areas:
      'play'
      'notes'
      'tx'
      'meta';
  }

  .rec-area-left,
  .rec-area-right { display: contents; }
  .rec-area-play { grid-area: play; }
  .rec-area-notes { grid-area: notes; }
  .rec-area-tx { grid-area: tx; }
  .rec-area-meta { grid-area: meta; }

  /* Reading layout: the round down the page, its facts in a side column. */
  @media (min-width: 900px) {
    :root[data-rec-layout='reading'] .rec-grid {
      grid-template-columns: minmax(0, 1fr) 16rem;
      grid-template-areas:
        'play  meta'
        'notes meta'
        'tx    tx';
    }
  }

  /*
   * Compact: the player on the left with the round's facts under it, the
   * transcript beside them rather than a screen below, notes under the
   * transcript. Everything that was on the page is still on it, and the
   * reading measure is traded for width, since the point is to see the player
   * and the words at once.
   */
  @media (min-width: 1000px) {
    :root:not([data-rec-layout='reading']) .shell {
      max-width: none;
    }

    /*
     * Two columns, one row. Each side stacks inside its own box rather than
     * sharing grid rows, so the transcript's fold is set by the viewport alone
     * and cannot be pushed down by however far the strategy text happens to
     * wrap on the other side.
     */
    :root:not([data-rec-layout='reading']) .rec-grid {
      grid-template-columns: minmax(28rem, 5fr) minmax(0, 6fr);
      grid-template-areas: 'left right';
      align-items: start;
    }

    :root:not([data-rec-layout='reading']) .rec-area-left {
      display: block;
      grid-area: left;
    }

    :root:not([data-rec-layout='reading']) .rec-area-right {
      display: block;
      grid-area: right;
    }

    /* The strategy, decision and tags read as columns under the player, which
       is wider than the sidebar they occupy otherwise. Strategy takes the most
       room because it is the only one with paragraphs in it. */
    :root:not([data-rec-layout='reading']) .rec-area-meta {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 0 2rem;
      align-items: start;
    }

    :root:not([data-rec-layout='reading']) .rec-area-meta > :first-child {
      grid-row: span 2;
    }

    /* The facts are reference, not reading: set smaller so the round's own
       words keep the space. */
    :root:not([data-rec-layout='reading']) .rec-facts dd {
      font-size: 0.8125rem;
      line-height: 1.45;
      margin-bottom: 0.7rem;
    }

    /* The transcript sets the fold: it takes what the viewport has left after
       the masthead, the title and the notes beneath it. Measured against the
       signed-out notes line, which is the common case; a signed-in reader's
       note forms are taller and do scroll. Crosses into the component, hence
       :global. */
    :root:not([data-rec-layout='reading']) :global(.transcript) {
      --tx-height: calc(100vh - 31rem);
      margin-top: 0;
      border-top: none;
      padding-top: 0;
    }

    :root:not([data-rec-layout='reading']) .rec-block {
      margin-bottom: 1rem;
      padding-top: 0.9rem;
    }

    :root:not([data-rec-layout='reading']) .rec-original {
      margin-top: 0.9rem;
    }

    :root:not([data-rec-layout='reading']) .rec-area-notes :global(.account) {
      margin-top: 1.25rem;
    }

    /* The reading layout's footer gap is dead space when the point is to fit
       the round on one screen. */
    :root:not([data-rec-layout='reading']) .page-body {
      padding-bottom: 2rem;
    }

    :root:not([data-rec-layout='reading']) .page-head {
      padding-top: 2rem;
      padding-bottom: 1.25rem;
    }
  }

  /* Below the compact breakpoint the button would toggle a preference that
     changes nothing, so it is not offered. */
  @media (max-width: 999px) {
    .rec-layout-toggle {
      display: none;
    }
  }

  .rec-block {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    margin-bottom: 2rem;
  }

  .rec-block > .label {
    margin-bottom: 0.75rem;
  }

  .rec-resolution {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    line-height: 1.4;
    margin: 0;
    max-width: 52ch;
  }

  .rec-player :is(iframe, video, audio) {
    width: 100%;
    display: block;
    border: none;
  }

  .rec-player :is(iframe, video) {
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .rec-player-note {
    margin: 1rem 0 0;
  }

  .rec-original {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }

  .rec-facts {
    margin: 0;
  }

  .rec-facts dt {
    margin-bottom: 0.3rem;
  }

  .rec-facts dd {
    margin: 0 0 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .rec-decision {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    background: var(--gold);
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    filter: blur(9px);
    transition: filter 80ms linear;
  }

  .rec-decision[data-revealed='true'] {
    filter: none;
  }

  .tag-list a.tag {
    text-decoration: none;
  }

  .tag-list a.tag:hover {
    background: var(--gold);
    border-color: var(--ink);
  }
</style>

<script>
  import { mountRating } from '../../lib/stars';

  const ratingHost = document.getElementById('rec-rating');
  if (ratingHost?.dataset.slug) mountRating(ratingHost, ratingHost.dataset.slug);

  // Reveal and re-blur, matching the decisions on the recordings list. Reading
  // a result and hiding it again is the normal way to use this.
  const decision = document.getElementById('decision');
  decision?.addEventListener('click', () => {
    const shown = decision.dataset.revealed === 'true';
    decision.dataset.revealed = String(!shown);
    decision.setAttribute('aria-label', shown ? 'Reveal decision' : 'Hide decision');
    decision.setAttribute('aria-pressed', String(!shown));
  });

  /**
   * The layout is a reading preference, not a property of one round, so it is
   * remembered and applied to every round page. The inline script in the head
   * sets it before paint; this only handles the toggle.
   */
  const LAYOUT_KEY = 'gt:rec-layout';
  const root = document.documentElement;
  const layoutBtn = document.getElementById('rec-layout-toggle');

  function isCompact() {
    return root.dataset.recLayout !== 'reading';
  }

  function setLayout(compact: boolean, remember = true) {
    if (compact) delete root.dataset.recLayout;
    else root.dataset.recLayout = 'reading';

    layoutBtn?.setAttribute('aria-pressed', String(compact));
    if (layoutBtn) layoutBtn.textContent = compact ? 'Reading layout' : 'Compact layout';
    if (remember) {
      try { localStorage.setItem(LAYOUT_KEY, compact ? 'compact' : 'reading'); } catch {}
    }
    // The waveform and the transcript both measure themselves, and the columns
    // just changed width underneath them.
    window.dispatchEvent(new Event('resize'));
  }

  // The inline script already set the root; this only syncs the button.
  setLayout(isCompact(), false);

  layoutBtn?.addEventListener('click', () => setLayout(!isCompact()));
</script>
