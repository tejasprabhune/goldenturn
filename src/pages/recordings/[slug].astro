---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordingPlayer from '../../components/RecordingPlayer.astro';
import AccountBar from '../../components/AccountBar.astro';
import Transcript from '../../components/Transcript.astro';
import {
  fetchAllRecordings,
  fetchMediaIndex,
  recordingSlug,
  tagLabel,
  mediaKind,
  youtubeId,
  vimeoId,
  type Recording,
} from '../../lib/recordings';

export async function getStaticPaths() {
  const [recordings, media] = await Promise.all([fetchAllRecordings(), fetchMediaIndex()]);
  return recordings.map(entry => {
    const slug = recordingSlug(entry);
    return {
      params: { slug },
      props: {
        entry, slug,
        hasMedia: media.playable.has(slug),
      },
    };
  });
}

interface Props {
  entry: Recording;
  slug: string;
  hasMedia: boolean;
}

const { entry, slug, hasMedia } = Astro.props;

const kind = mediaKind(entry.link);
const ytId = kind === 'youtube' ? youtubeId(entry.link) : null;
const vimId = kind === 'vimeo' ? vimeoId(entry.link) : null;
const videoEmbed = ytId
  ? { kind: 'youtube' as const, id: ytId }
  : vimId
    ? { kind: 'vimeo' as const, id: vimId }
    : null;

const meta = [entry.year, entry.tournament].filter(Boolean).join(', ');
const tags = (entry._tags ?? []).filter(t => t.startsWith('#'));

// aff_type and neg_strategy_count are derived from the aff and neg text, so
// showing them here just repeats what the reader already has.
const facts: Array<[string, string]> = [];
if (entry.aff) facts.push(['aff', entry.aff]);
if (entry.neg) facts.push(['neg', entry.neg]);
---

<BaseLayout
  title={`${entry.title} | Recordings | the golden turn`}
  description={entry.resolution ?? 'A recorded parliamentary debate round.'}
>
  <div class="shell page-head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/recordings">recordings</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{entry.title}</span>
    </nav>

    <h1 class="page-title rec-title">{entry.title}</h1>
    {meta && <p class="page-lede">{meta}</p>}
  </div>

  <div class="shell page-body rec-layout">
    <div class="rec-main">
      {entry.resolution && (
        <section class="rec-block">
          <p class="label label-muted">resolution</p>
          <p class="rec-resolution">{entry.resolution}</p>
        </section>
      )}

      <section class="rec-block">
        <p class="label label-muted">player</p>
        <RecordingPlayer
          slug={slug}
          title={entry.title}
          hasMedia={hasMedia}
          videoEmbed={videoEmbed}
          sourceLink={entry.link}
        />
        <p class="rec-original">
          <a href={entry.link} target="_blank" rel="noopener noreferrer" class="link">open original source</a>
        </p>

        <AccountBar slug={slug} />
      </section>


    </div>

    <aside class="rec-side">
      {facts.length > 0 && (
        <section class="rec-block">
          <p class="label label-muted">strategy</p>
          <dl class="rec-facts">
            {facts.map(([term, value]) => (
              <>
                <dt class="label label-muted">{term}</dt>
                <dd>{value}</dd>
              </>
            ))}
          </dl>
        </section>
      )}

      {entry.decision && (
        <section class="rec-block">
          <p class="label label-muted">decision</p>
          <p>
            <button id="decision" class="rec-decision" data-revealed="false" aria-label="Reveal decision">
              {entry.decision}
            </button>
          </p>
        </section>
      )}

      {tags.length > 0 && (
        <section class="rec-block">
          <p class="label label-muted">tags</p>
          <div class="tag-list">
            {tags.map(tag => (
              <a class="tag" href={`/recordings?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>
            ))}
          </div>
        </section>
      )}
    </aside>
  </div>

  <div class="shell page-body">
    <Transcript slug={slug} />
  </div>
</BaseLayout>

<style>
  /* The same face as the recordings list, a few sizes up. A round title is a
     string of team codes and abbreviations, which the display serif sets
     poorly and lowercasing makes worse. */
  .rec-title {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-transform: none;
  }

  .rec-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .rec-layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 3rem;
    }
  }

  .rec-block {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    margin-bottom: 2rem;
  }

  .rec-block > .label {
    margin-bottom: 0.75rem;
  }

  .rec-resolution {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-weight: 400;
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    line-height: 1.4;
    margin: 0;
    max-width: 52ch;
  }

  .rec-player :is(iframe, video, audio) {
    width: 100%;
    display: block;
    border: none;
  }

  .rec-player :is(iframe, video) {
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .rec-player-note {
    margin: 1rem 0 0;
  }

  .rec-original {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }

  .rec-facts {
    margin: 0;
  }

  .rec-facts dt {
    margin-bottom: 0.3rem;
  }

  .rec-facts dd {
    margin: 0 0 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .rec-decision {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    background: var(--gold);
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    filter: blur(9px);
    transition: filter 80ms linear;
  }

  .rec-decision[data-revealed='true'] {
    filter: none;
  }

  .tag-list a.tag {
    text-decoration: none;
  }

  .tag-list a.tag:hover {
    background: var(--gold);
    border-color: var(--ink);
  }
</style>

<script>
  // Reveal and re-blur, matching the decisions on the recordings list. Reading
  // a result and hiding it again is the normal way to use this.
  const decision = document.getElementById('decision');
  decision?.addEventListener('click', () => {
    const shown = decision.dataset.revealed === 'true';
    decision.dataset.revealed = String(!shown);
    decision.setAttribute('aria-label', shown ? 'Reveal decision' : 'Hide decision');
    decision.setAttribute('aria-pressed', String(!shown));
  });
</script>
