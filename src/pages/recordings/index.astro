---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/reccard.css';
---

<BaseLayout title="Recordings | the golden turn">
  <div class="shell page-head rec-head">
    <h1 class="page-title">recordings</h1>
    <a href="/recordings/add" class="label label-muted rec-submit">submit a recording</a>
  </div>

  <div class="shell page-body">
    <input id="search-input" type="search" aria-label="Search recordings"
      placeholder="Search rounds, teams, resolutions"
      class="field" style="width: 100%; margin-bottom: 1rem;" />

    <!--
      Format and level come before the rest because they decide what kind of
      thing the list is, and the others only narrow within it. Both groups keep
      at least one choice: an empty group would mean a list of nothing, which
      is never what anyone meant by unticking a box.
    -->
    <div class="toolbar toolbar-kinds">
      <div class="seg" role="group" aria-label="Debate format" id="filter-format">
        <button type="button" class="chip" data-value="parli" aria-pressed="true">parli</button>
        <button type="button" class="chip" data-value="policy" aria-pressed="false">policy</button>
      </div>
      <div class="seg" role="group" aria-label="Level" id="filter-level">
        <button type="button" class="chip" data-value="college" aria-pressed="true">college</button>
        <button type="button" class="chip" data-value="hs" aria-pressed="true">high school</button>
      </div>
      <p class="kinds-tip" id="kinds-tip" hidden>
        <button class="link account-link" id="kinds-tip-signin">Sign in</button>
        to keep this choice on any device.
        <button class="kinds-tip-close" id="kinds-tip-close" aria-label="Dismiss">&times;</button>
      </p>
    </div>

    <div class="toolbar">
      <select id="filter-year" class="field" aria-label="Filter by year">
        <option value="">All years</option>
      </select>
      <select id="filter-aff-type" class="field" aria-label="Filter by aff type">
        <option value="">All aff types</option>
        <option value="topical">Topical</option>
        <option value="k-aff">K-aff</option>
        <option value="performance">Performance</option>
        <option value="other">Other</option>
      </select>
      <select id="filter-tournament" class="field" aria-label="Filter by tournament">
        <option value="">All tournaments</option>
      </select>
      <select id="sort-by" class="field" aria-label="Sort results">
        <option value="">Best match</option>
        <option value="year-desc">Newest first</option>
        <option value="year-asc">Oldest first</option>
        <option value="title-asc">Title A to Z</option>
        <option value="title-desc">Title Z to A</option>
        <option value="tournament-asc">Tournament A to Z</option>
      </select>
      <button id="toggle-blur" aria-pressed="true" class="chip blur-toggle">Blur decisions</button>
    </div>

    <div id="active-filters" class="active-filters" style="display:none;"></div>

    <p id="results-count" class="label label-muted" style="margin-bottom: 1.25rem;"></p>

    <div id="results" class="rec-results"></div>

    <div style="margin-top: 2.5rem;">
      <button id="load-more" class="chip hidden">Load more</button>
    </div>
  </div>
</BaseLayout>

<script>
  import { algoliasearch } from 'algoliasearch';
  import { track } from '../../lib/api';
  import { renderRecordingCard, createCardList, hydrateRatings, escapeHtml } from '../../lib/reccard';
  import {
    DEFAULT_PREFS, FORMATS, LEVELS, clean, loadPrefs, prefsFilter, readLocal,
    savePrefs, shouldOfferToRemember, type ViewPrefs,
  } from '../../lib/prefs';

  const APP_ID = import.meta.env.PUBLIC_ALGOLIA_APP_ID as string;
  const SEARCH_KEY = import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY as string;
  const INDEX_NAME = import.meta.env.PUBLIC_ALGOLIA_INDEX_NAME as string;

  const client = algoliasearch(APP_ID, SEARCH_KEY);

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterYear = document.getElementById('filter-year') as HTMLSelectElement;
  const filterAffType = document.getElementById('filter-aff-type') as HTMLSelectElement;
  const filterTournament = document.getElementById('filter-tournament') as HTMLSelectElement;
  const sortBy = document.getElementById('sort-by') as HTMLSelectElement;
  const resultsEl = document.getElementById('results') as HTMLDivElement;
  const resultsCount = document.getElementById('results-count') as HTMLParagraphElement;
  const loadMoreBtn = document.getElementById('load-more') as HTMLButtonElement;
  const activeFiltersEl = document.getElementById('active-filters') as HTMLDivElement;
  const toggleBlurBtn = document.getElementById('toggle-blur') as HTMLButtonElement;
  const formatGroup = document.getElementById('filter-format') as HTMLDivElement;
  const levelGroup = document.getElementById('filter-level') as HTMLDivElement;
  const kindsTip = document.getElementById('kinds-tip') as HTMLParagraphElement;

  const PAGE_SIZE = 20;

  let currentPage = 0;
  let currentQuery = '';
  let currentYear = '';
  let currentAffType = '';
  let currentTournament = '';
  let currentSort = '';
  let totalPages = 0;
  let facetsPopulated = false;
  let activeTags: string[] = [];
  let prefs: ViewPrefs = { ...DEFAULT_PREFS };
  /** The whole sorted result set, held only while a sort is active. */
  let sorted: Record<string, unknown>[] = [];

  // Cards render and behave the same here and in search; only what a tag click
  // means differs, since this is the page a tag filters.
  const cards = createCardList(resultsEl, {
    onTag(tag) {
      activeTags = activeTags.includes(tag)
        ? activeTags.filter(t => t !== tag)
        : [...activeTags, tag];
      updateURL();
      renderActiveFilters();
      search(0, false);
    },
    onExpandChange() { updateURL(); },
  });

  let decisionsBlurred = true;
  toggleBlurBtn.addEventListener('click', () => {
    decisionsBlurred = !decisionsBlurred;
    toggleBlurBtn.setAttribute('aria-pressed', String(decisionsBlurred));
    cards.setDecisionsBlurred(decisionsBlurred);
  });

  function buildFilters(year: string, affType: string, tournament: string, tags: string[]): string {
    const parts: string[] = [...prefsFilter(prefs)];
    if (year) parts.push(`year:"${year}"`);
    if (affType) parts.push(`aff_type:"${affType}"`);
    if (tournament) parts.push(`tournament:"${tournament}"`);
    if (tags.length > 0) {
      const tagFilter = tags.map(t => `_tags:"${t}"`).join(' AND ');
      parts.push(tagFilter);
    }
    return parts.join(' AND ');
  }

  /**
   * Algolia orders by relevance, and ordering by a field instead would mean a
   * replica index per order. The whole collection is under three hundred
   * rounds, so a sorted view is one request for everything that matches and
   * then a comparison here.
   */
  const SORTS: Record<string, (a: any, b: any) => number> = {
    'year-desc': (a, b) => str(b.year).localeCompare(str(a.year)) || str(a.title).localeCompare(str(b.title)),
    'year-asc': (a, b) => str(a.year).localeCompare(str(b.year)) || str(a.title).localeCompare(str(b.title)),
    'title-asc': (a, b) => str(a.title).localeCompare(str(b.title)),
    'title-desc': (a, b) => str(b.title).localeCompare(str(a.title)),
    'tournament-asc': (a, b) =>
      str(a.tournament).localeCompare(str(b.tournament))
      || str(b.year).localeCompare(str(a.year))
      || str(a.title).localeCompare(str(b.title)),
  };

  function str(v: unknown): string {
    return typeof v === 'string' ? v : '';
  }

  function shuffleArray<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  /**
   * Draws a group from the preference. A group is never empty, so the pressed
   * state is always readable as "these, and not the others".
   */
  function paintKinds() {
    for (const [group, chosen] of [[formatGroup, prefs.formats], [levelGroup, prefs.levels]] as const) {
      group.querySelectorAll<HTMLButtonElement>('[data-value]').forEach(btn => {
        btn.setAttribute('aria-pressed', String(chosen.includes(btn.dataset.value!)));
      });
    }
  }

  /**
   * Ticking the last remaining choice in a group would ask for a list of
   * nothing, which nobody means by narrowing, so the group keeps it.
   */
  function onKindClick(group: HTMLElement, key: 'formats' | 'levels', e: Event) {
    const btn = (e.target as Element).closest('[data-value]') as HTMLElement | null;
    if (!btn || !group.contains(btn)) return;
    const value = btn.dataset.value!;
    const chosen = prefs[key];
    const next = chosen.includes(value) ? chosen.filter(v => v !== value) : [...chosen, value];
    if (next.length === 0) return;

    prefs = clean({ ...prefs, [key]: next });
    paintKinds();
    savePrefs(prefs);
    if (shouldOfferToRemember()) kindsTip.hidden = false;
    track('recordings.kinds', undefined, { formats: prefs.formats, levels: prefs.levels });
    updateURL();
    search(0, false);
  }

  formatGroup.addEventListener('click', e => onKindClick(formatGroup, 'formats', e));
  levelGroup.addEventListener('click', e => onKindClick(levelGroup, 'levels', e));
  document.getElementById('kinds-tip-close')?.addEventListener('click', () => { kindsTip.hidden = true; });
  document.getElementById('kinds-tip-signin')?.addEventListener('click', () =>
    document.dispatchEvent(new CustomEvent('gt:open-signin')));

  function updateURL() {
    const params = new URLSearchParams();
    // Only when they say something the reader's own preference would not, so
    // an ordinary browse keeps a clean address and a shared one is explicit.
    if (prefs.formats.length !== FORMATS.length) prefs.formats.forEach(f => params.append('format', f));
    if (prefs.levels.length !== LEVELS.length) prefs.levels.forEach(l => params.append('level', l));
    if (currentQuery) params.set('q', currentQuery);
    if (currentYear) params.set('year', currentYear);
    if (currentAffType) params.set('affType', currentAffType);
    if (currentTournament) params.set('tournament', currentTournament);
    if (currentSort) params.set('sort', currentSort);
    activeTags.forEach(t => params.append('tag', t));
    if (cards.expandedObjectID) params.set('expand', cards.expandedObjectID);
    const url = params.toString() ? `/recordings?${params}` : '/recordings';
    history.pushState({}, '', url);
  }

  function renderActiveFilters() {
    if (activeTags.length === 0) {
      activeFiltersEl.style.display = 'none';
      activeFiltersEl.innerHTML = '';
      return;
    }
    activeFiltersEl.style.display = 'flex';
    const chips = activeTags.map(tag => `
      <button class="active-filter-chip" data-remove-tag="${escapeHtml(tag)}">
        ${escapeHtml(tag)}
        <span aria-hidden="true">x</span>
      </button>
    `).join('');
    activeFiltersEl.innerHTML = `${chips}<button class="clear-filters">clear all</button>`;

    activeFiltersEl.querySelectorAll('[data-remove-tag]').forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.removeTag!;
        activeTags = activeTags.filter(t => t !== tag);
        updateURL();
        renderActiveFilters();
        search(0, false);
      });
    });

    const clearBtn = activeFiltersEl.querySelector('.clear-filters');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        activeTags = [];
        updateURL();
        renderActiveFilters();
        search(0, false);
      });
    }
  }

  /**
   * The filter options come from one unfiltered facet query rather than from
   * whatever the current search returned, so narrowing by year never removes
   * the other years from the dropdown.
   */
  async function loadFilterOptions() {
    const r = await client.searchSingleIndex({
      indexName: INDEX_NAME,
      searchParams: { query: '', hitsPerPage: 0, facets: ['year', 'tournament'], maxValuesPerFacet: 200 },
    }).catch(() => null);
    const facets = r?.facets as Record<string, Record<string, number>> | undefined;
    if (facets) populateFacetDropdowns(facets['year'] ?? {}, facets['tournament'] ?? {});
  }

  function populateFacetDropdowns(
    facetYears: Record<string, number>,
    facetTournaments: Record<string, number>,
  ) {
    if (facetsPopulated) return;
    facetsPopulated = true;

    for (const yr of Object.keys(facetYears).sort().reverse()) {
      const opt = document.createElement('option');
      opt.value = yr;
      opt.textContent = yr;
      filterYear.appendChild(opt);
    }

    for (const name of Object.keys(facetTournaments).sort()) {
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      filterTournament.appendChild(opt);
    }

    // The selection may have come from the URL before the options existed.
    filterYear.value = currentYear;
    filterTournament.value = currentTournament;
  }

  async function search(page: number, append: boolean) {
    const filters = buildFilters(currentYear, currentAffType, currentTournament, activeTags);
    const filtered = Boolean(currentYear || currentAffType || currentTournament || activeTags.length);
    // Browse is the bare landing state: a random slice, so the archive does not
    // always open on the same rounds. A chosen order replaces that.
    const isBrowse = !currentQuery && !filtered && !currentSort && page === 0;
    try {
      // A sorted view pages through the sorted array rather than through
      // Algolia, so it only fetches once.
      if (currentSort && append && sorted.length) {
        currentPage = page;
        renderPage(sorted.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE), true);
        loadMoreBtn.classList.toggle('hidden', (page + 1) * PAGE_SIZE >= sorted.length);
        return;
      }

      let effectivePage = page;
      if (isBrowse) {
        // Asking for no hits returns no page count either, so this asked for a
        // random page out of zero and opened on the first one every time; the
        // shuffle below was doing all the work. It also has to see the same
        // rounds the real request will, or it counts pages of an archive
        // including formats this reader has switched off and lands past the
        // end of what they can see.
        const probe = await client.searchSingleIndex({
          indexName: INDEX_NAME,
          searchParams: { query: '', hitsPerPage: PAGE_SIZE, page: 0, ...(filters ? { filters } : {}) },
        });
        const nbPages = probe.nbPages ?? 1;
        effectivePage = nbPages > 0 ? Math.floor(Math.random() * nbPages) : 0;
      }

      const result = await client.searchSingleIndex({
        indexName: INDEX_NAME,
        searchParams: {
          query: currentQuery,
          hitsPerPage: currentSort ? 1000 : PAGE_SIZE,
          page: currentSort ? 0 : effectivePage,
          ...(filters ? { filters } : {}),
        },
      });

      const rawHits = result.hits as Record<string, unknown>[];
      const nbHits = result.nbHits ?? 0;

      let hits: Record<string, unknown>[];
      if (currentSort) {
        sorted = [...rawHits].sort(SORTS[currentSort]);
        totalPages = Math.ceil(sorted.length / PAGE_SIZE);
        hits = sorted.slice(0, PAGE_SIZE);
      } else {
        sorted = [];
        totalPages = result.nbPages ?? 0;
        hits = isBrowse ? shuffleArray(rawHits) : rawHits;
      }
      currentPage = page;

      let countLabel = `${nbHits} round${nbHits === 1 ? '' : 's'}`;
      if (filtered) countLabel += ' matching filters';
      resultsCount.textContent = countLabel;

      renderPage(hits, append);
      loadMoreBtn.classList.toggle('hidden', currentPage + 1 >= totalPages);
    } catch (err) {
      resultsCount.textContent = 'Search unavailable.';
      console.error('Algolia search error:', err);
    }
  }

  function renderPage(hits: Record<string, unknown>[], append: boolean) {
    if (!append) resultsEl.innerHTML = '';
    for (const hit of hits) {
      resultsEl.insertAdjacentHTML('beforeend', renderRecordingCard(hit, activeTags));
    }
    void hydrateRatings(resultsEl);
    if (initExpandID && !append) {
      const card = resultsEl.querySelector(`[data-objectid="${CSS.escape(initExpandID)}"]`) as HTMLElement | null;
      if (card) {
        cards.expandedObjectID = initExpandID;
        cards.expandCard(card);
      }
    }
  }

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;

  function runSearch() {
    clearTimeout(debounceTimer);
    currentQuery = searchInput.value.trim();
    if (currentQuery.length > 2) track('search', undefined, { q: currentQuery, source: 'recordings' });
    updateURL();
    search(0, false);
  }

  function onSearchInput() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runSearch, 150);
  }

  function onFilterChange() {
    currentYear = filterYear.value;
    currentAffType = filterAffType.value;
    currentTournament = filterTournament.value;
    currentSort = sortBy.value;
    updateURL();
    search(0, false);
  }

  loadMoreBtn.addEventListener('click', () => {
    search(currentPage + 1, true);
  });

  searchInput.addEventListener('input', onSearchInput);
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') runSearch();
  });
  filterYear.addEventListener('change', onFilterChange);
  filterAffType.addEventListener('change', onFilterChange);
  filterTournament.addEventListener('change', onFilterChange);
  sortBy.addEventListener('change', () => {
    track('recordings.sort', undefined, { sort: sortBy.value || 'relevance' });
    onFilterChange();
  });

  function readParams(p: URLSearchParams) {
    // A link that names formats is an explicit request from whoever shared it
    // and outranks the reader's standing preference for as long as they are on
    // it. A link that names none leaves the preference alone.
    const urlFormats = p.getAll('format');
    const urlLevels = p.getAll('level');
    if (urlFormats.length || urlLevels.length) {
      prefs = clean({
        formats: urlFormats.length ? urlFormats : [...FORMATS],
        levels: urlLevels.length ? urlLevels : [...LEVELS],
      });
      paintKinds();
    }
    currentQuery = p.get('q') || '';
    currentYear = p.get('year') || '';
    currentAffType = p.get('affType') || '';
    currentTournament = p.get('tournament') || '';
    currentSort = SORTS[p.get('sort') || ''] ? p.get('sort')! : '';
    activeTags = p.getAll('tag');
    cards.expandedObjectID = p.get('expand') || '';
    searchInput.value = currentQuery;
    filterYear.value = currentYear;
    filterAffType.value = currentAffType;
    filterTournament.value = currentTournament;
    sortBy.value = currentSort;
  }

  window.addEventListener('popstate', () => {
    readParams(new URLSearchParams(window.location.search));
    renderActiveFilters();
    search(0, false);
  });

  const initParams = new URLSearchParams(window.location.search);
  // The browser's copy is available now; the account's may take a request, and
  // waiting on it would leave the list blank for anyone signed in.
  prefs = readLocal();
  paintKinds();
  readParams(initParams);
  const initExpandID = initParams.get('expand') || '';
  renderActiveFilters();

  void loadFilterOptions();
  search(0, false);

  /** Reconciles with the account, and only redraws if it disagrees. */
  async function syncPrefs() {
    if (initParams.getAll('format').length || initParams.getAll('level').length) return;
    const stored = await loadPrefs();
    if (JSON.stringify(stored) === JSON.stringify(prefs)) return;
    prefs = stored;
    paintKinds();
    search(0, false);
  }

  void syncPrefs();
  document.addEventListener('gt:signed-in', () => { void syncPrefs(); });
</script>

<style is:global>
  .rec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .rec-submit {
    text-decoration: none;
  }

  .rec-submit:hover {
    color: var(--ink);
  }

  /* Its own row: these two decide what the list is, the rest narrow it. */
  .toolbar-kinds {
    padding-bottom: 1rem;
    gap: 0.75rem 1.25rem;
  }

  .kinds-tip {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .kinds-tip[hidden] {
    display: none;
  }

  .kinds-tip-close {
    background: none;
    border: none;
    padding: 0 0 0 0.25rem;
    cursor: pointer;
    color: rgba(23, 21, 15, 0.35);
    font-size: 1rem;
    line-height: 1;
  }

  .kinds-tip-close:hover {
    color: var(--ink);
  }
</style>
