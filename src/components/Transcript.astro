---
/**
 * Time-synced transcript with speech tinting, a minimap, and inline corrections.
 *
 * The machine transcript is immutable in R2; accepted community revisions are
 * fetched separately and applied over it at read time, so nothing is ever
 * destructively overwritten and an edit can be traced back to its proposal.
 *
 * Whether a transcript exists is probed at runtime rather than baked in at
 * build time, so a round transcribed after the last deploy shows up without
 * needing the site rebuilt.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="transcript" data-slug={slug}>
  <div class="transcript-head">
    <p class="label label-muted">Transcript</p>
    <div class="transcript-tools">
      <input class="field transcript-search" id="tx-search" type="search"
             placeholder="Search this round" aria-label="Search transcript" />
      <span class="label label-muted" id="tx-hits"></span>
      <button class="chip" id="tx-follow" aria-pressed="true">Follow</button>
      <button class="chip" id="tx-edits-toggle" aria-expanded="false" hidden>Edits</button>
      <button class="chip" id="tx-expand" aria-pressed="false">Expand</button>
    </div>
  </div>

  <div class="transcript-body" id="tx-body" hidden>
    <div class="transcript-lines" id="tx-lines" aria-busy="true"></div>
    <div class="minimap" id="tx-minimap" aria-hidden="true">
      <div class="minimap-view" id="tx-minimap-view"></div>
    </div>
    <aside class="transcript-edits" id="tx-edits" hidden aria-label="Proposed edits">
      <p class="label label-muted">Public edits</p>
      <p class="label label-muted" id="tx-edits-empty">None yet</p>
      <ul class="proposal-list" id="tx-proposals"></ul>
    </aside>
  </div>

  <p class="page-lede transcript-pending" id="tx-pending">Checking for a transcript</p>
</section>

<div class="tx-tip" id="tx-tip" hidden>
  <button class="tx-tip-btn" id="tx-propose">Suggest an edit</button>
  <button class="tx-tip-btn" id="tx-note">Take a note</button>
</div>

<dialog class="tx-dialog" id="tx-dialog">
  <form class="tx-form" id="tx-form" method="dialog">
    <p class="label label-muted">Suggest a correction</p>
    <p class="tx-original" id="tx-original"></p>
    <label class="signin-label" for="tx-proposed">Corrected text</label>
    <textarea class="field" id="tx-proposed" rows="3" maxlength="4000"></textarea>
    <label class="signin-label" for="tx-note-input">Note (optional)</label>
    <input class="field" id="tx-note-input" maxlength="200" placeholder="Why this is right" />
    <p class="signin-error" id="tx-error" hidden></p>
    <!-- Cancel is a plain button: as the first submit button it would become
         the default, and Enter in the note field would discard the edit. -->
    <div class="signin-actions">
      <button type="button" class="chip" id="tx-cancel">Cancel</button>
      <button type="submit" class="btn" value="ok" id="tx-submit">Submit</button>
    </div>
  </form>
</dialog>

<style>
  .transcript {
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
    margin-top: 2.5rem;
  }

  .transcript-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .transcript-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .transcript-search {
    width: 14rem;
    max-width: 100%;
    min-width: 0;
    flex: 1 1 8rem;
  }

  /* Lines take the full measure; the minimap is a narrow rail beside them and
     the edits panel only claims a column once it is opened. */
  .transcript-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14px;
    gap: 0 0.75rem;
    align-items: start;
  }

  .transcript-body[data-edits='open'] {
    grid-template-columns: minmax(0, 1fr) 14px 16rem;
    gap: 0 1.25rem;
  }

  .transcript-body[hidden] {
    display: none;
  }

  /* The lines box and the minimap are the same height by construction, so the
     rail always maps onto what is scrollable. Layouts override the one value. */
  .transcript {
    --tx-height: 46rem;
  }

  .transcript-lines {
    max-height: var(--tx-height);
    overflow-y: auto;
    padding-right: 0.5rem;
    scrollbar-width: thin;
  }

  /* Expanded drops the cap entirely so the round reads as one document. */
  .transcript-body[data-expanded='1'] .transcript-lines {
    max-height: none;
  }

  .transcript-body[data-expanded='1'] .minimap {
    position: sticky;
    top: 1rem;
  }

  .minimap {
    position: relative;
    height: var(--tx-height);
    background: var(--paper-raised);
    border: 1px solid var(--rule-soft);
    cursor: pointer;
  }

  .minimap-view {
    position: absolute;
    left: 0;
    right: 0;
    background: var(--ink);
    pointer-events: none;
  }

  .transcript-edits[hidden] {
    display: none;
  }

  .tx-tip {
    position: absolute;
    z-index: 40;
    transform: translate(-50%, -100%);
    display: flex;
    gap: 1px;
    background: var(--ink);
    padding: 1px;
  }

  .tx-tip[hidden] {
    display: none;
  }

  .tx-dialog {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 1.5rem;
    max-width: 32rem;
    width: calc(100vw - 2rem);
    color: var(--ink);
  }

  .tx-dialog::backdrop {
    background: rgba(23, 21, 15, 0.4);
  }

  .tx-form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* The passage being corrected. The words either side are context, so they
     read quieter than the selection. The mark itself is built in the browser
     and so is styled in global.css. */
  .tx-original {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    padding: 0.6rem;
    margin: 0.5rem 0;
  }

  .transcript-pending {
    margin-top: 0;
  }
</style>

<script>
  import { formatTime } from '../lib/waveform';
  import {
    listProposals, listRevisions, propose, vote, getUser, isAdmin, NotSignedIn,
    addNote, track, updateProposal, deleteProposal, adminResolve,
    type Proposal, type Revision,
  } from '../lib/api';
  import { AFF, usable, applyBoundaries, type Speech } from '../lib/speeches';
  import { windowAround } from '../lib/textdiff';
  import { renderDiff } from '../lib/diffview';

  interface Word { w: string; s: number | null; e: number | null; p: number | null }
  interface Segment {
    start: number; end: number; text: string;
    speaker: string | null; words: Word[];
  }

  const MEDIA = 'https://media.goldenturn.org';

  const root = document.querySelector<HTMLElement>('.transcript');
  if (root) {
    const slug = root.dataset.slug!;
    const linesEl = document.getElementById('tx-lines')!;
    const bodyEl = document.getElementById('tx-body')!;
    const audio = () => document.getElementById('audio') as HTMLAudioElement | null;

    interface Para { start: number; end: number; label: string | null; words: Word[]; text: string; idx: number }
    let segments: Segment[] = [];
    let paras: Para[] = [];
    let speeches: Speech[] = [];
    const revisions = new Map<string, string>();
    let follow = true;
    let programmatic = false;
    let currentIndex = -1;
    let duration = 0;

    const segId = (i: number) => `seg-${i}`;
    const speechAt = (t: number) => speeches.find(s => t >= s.start && t < s.end) ?? null;

    async function load() {
      const [txRes, revRes, spRes] = await Promise.allSettled([
        fetch(`${MEDIA}/${(window as any).__TX_PREFIX__ ?? 'transcripts'}/${slug}.json`)
          .then(r => (r.ok ? r.json() : Promise.reject(new Error(String(r.status))))),
        listRevisions(slug),
        fetch(`${MEDIA}/speeches/${slug}.json`).then(r => (r.ok ? r.json() : null)),
      ]);

      const pending = document.getElementById('tx-pending')!;
      if (txRes.status !== 'fulfilled' || !txRes.value?.segments) {
        pending.textContent =
          'Not transcribed yet. This round is queued; the transcript and speech '
          + 'markers appear here once it runs.';
        return;
      }
      pending.hidden = true;
      bodyEl.hidden = false;
      segments = txRes.value.segments ?? [];
      duration = txRes.value.duration ?? segments[segments.length - 1]?.end ?? 0;
      if (spRes.status === 'fulfilled' && spRes.value) {
        speeches = usable(spRes.value.speeches ?? []);
      }
      if (revRes.status === 'fulfilled') {
        takeRevisions(revRes.value.revisions);
      }
      render();
      buildMinimap();
      void loadProposals();
    }

    /**
     * The player owns the fit once it has loaded; this keeps the two in step
     * whichever finishes first, and re-syncs if the player revises its list.
     */
    document.addEventListener('gt:speeches', e => {
      const detail = (e as CustomEvent).detail;
      if (!detail || detail.slug !== slug) return;
      const next: Speech[] = detail.speeches ?? [];
      if (sameSpeeches(next, speeches)) return;
      speeches = next;
      if (segments.length === 0) return;
      render();
      buildMinimap();
    });

    function sameSpeeches(a: Speech[], b: Speech[]): boolean {
      if (a.length !== b.length) return false;
      return a.every((s, i) =>
        s.label === b[i].label
        && Math.round(s.start) === Math.round(b[i].start)
        && Math.round(s.end) === Math.round(b[i].end));
    }

    /**
     * Utterances are merged into reading-sized paragraphs, breaking on a speech
     * change or a long pause. One row per utterance produced a stack of
     * three-word fragments that was painful to read.
     */
    function groupParagraphs(): Para[] {
      const out: Para[] = [];
      const TARGET_WORDS = 55;
      let cur: Para | null = null;

      segments.forEach(seg => {
        const label = speechAt(seg.start)?.label ?? null;
        const gap = cur ? seg.start - cur.end : 0;
        const wordCount = cur ? cur.words.length : 0;
        const breakHere = !cur || label !== cur.label || gap > 4 || wordCount >= TARGET_WORDS;

        if (breakHere) {
          cur = { start: seg.start, end: seg.end, label, words: [], text: '', idx: out.length };
          out.push(cur);
        }
        cur!.end = seg.end;
        cur!.text += (cur!.text ? ' ' : '') + (seg.text ?? '');
        if (seg.words?.length) cur!.words.push(...seg.words);
      });
      return out;
    }

    function render() {
      linesEl.innerHTML = '';
      linesEl.removeAttribute('aria-busy');
      paras = groupParagraphs();
      let currentSpeech: string | null | undefined;

      paras.forEach(para => {
        if (para.label !== currentSpeech) {
          currentSpeech = para.label;
          const divider = document.createElement('div');
          divider.className = 'tx-divider';
          divider.dataset.side = para.label ? (AFF.has(para.label) ? 'aff' : 'neg') : 'none';
          divider.textContent = para.label ?? 'Between speeches';
          linesEl.appendChild(divider);
        }

        const el = document.createElement('p');
        el.className = 'tx-para';
        el.id = segId(para.idx);
        el.dataset.index = String(para.idx);
        el.dataset.at = String(para.start);
        if (para.label) el.dataset.side = AFF.has(para.label) ? 'aff' : 'neg';

        const at = document.createElement('span');
        at.className = 'tx-at';
        at.textContent = formatTime(para.start);
        el.appendChild(at);

        const revised = revisions.get(segId(para.idx));
        if (revised !== undefined) {
          el.classList.add('is-revised');
          el.title = 'Includes an accepted community correction';
          el.appendChild(document.createTextNode(revised));
        } else if (para.words.length) {
          for (const w of para.words) {
            const span = document.createElement('span');
            span.className = 'tx-word';
            span.textContent = (w.w ?? '') + ' ';
            // WhisperX scores are alignment fit, not ASR confidence, and sit low
            // even on correct words; 0.15 flags roughly the worst tenth.
            if (typeof w.p === 'number' && w.p < 0.15) span.dataset.low = '1';
            el.appendChild(span);
          }
        } else {
          el.appendChild(document.createTextNode(para.text));
        }

        linesEl.appendChild(el);
      });
    }

    // Clicking a paragraph seeks to it, but never while text is being selected.
    linesEl.addEventListener('click', e => {
      if (!document.getSelection()?.isCollapsed) return;
      const para = (e.target as Element).closest('.tx-para') as HTMLElement | null;
      if (!para) return;
      const a = audio();
      if (a) { a.currentTime = Number(para.dataset.at); void a.play(); }
    });

    function buildMinimap() {
      const map = document.getElementById('tx-minimap')!;
      map.querySelectorAll('.minimap-seg').forEach(n => n.remove());
      if (!duration) return;
      for (const sp of speeches) {
        const el = document.createElement('div');
        el.className = 'minimap-seg';
        el.dataset.side = AFF.has(sp.label) ? 'aff' : 'neg';
        el.style.top = `${(sp.start / duration) * 100}%`;
        el.style.height = `${((sp.end - sp.start) / duration) * 100}%`;
        el.title = sp.label;

        // A grab line at the top of each speech jumps to its beginning; the
        // rest of the band scrolls to whatever line sits at that point.
        const handle = document.createElement('button');
        handle.className = 'minimap-handle';
        handle.title = `Go to the start of ${sp.label}`;
        handle.setAttribute('aria-label', `Go to the start of ${sp.label}`);
        handle.addEventListener('click', ev => {
          ev.stopPropagation();
          scrollTranscriptTo(sp.start, 'top');
        });
        el.appendChild(handle);
        map.appendChild(el);
      }

      // The minimap navigates the transcript only. Moving the recording is the
      // transcript's job, so scrubbing here never disturbs playback.
      map.addEventListener('click', e => {
        const rect = map.getBoundingClientRect();
        const frac = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
        scrollTranscriptTo(frac * duration, 'nearest');
      });
    }

    /**
     * Scrolls the transcript to an element. Expanded, the lines box is not a
     * scroll container any more, so the page has to move instead.
     */
    function scrollLinesTo(el: HTMLElement, mode: 'nearest' | 'top' | 'center' = 'nearest') {
      const boxScrolls = linesEl.scrollHeight > linesEl.clientHeight + 4;
      programmatic = true;

      if (!boxScrolls) {
        const rect = el.getBoundingClientRect();
        const target = window.scrollY + rect.top
          - (mode === 'top' ? 90 : window.innerHeight / 2 - rect.height / 2);
        window.scrollTo({ top: Math.max(0, target), behavior: 'auto' });
      } else {
        const top = el.offsetTop - linesEl.offsetTop;
        if (mode === 'top') {
          linesEl.scrollTop = top - 8;
        } else if (mode === 'center') {
          linesEl.scrollTop = top - linesEl.clientHeight / 2 + el.offsetHeight / 2;
        } else {
          const viewTop = linesEl.scrollTop;
          const viewBottom = viewTop + linesEl.clientHeight;
          if (top < viewTop || top + el.offsetHeight > viewBottom) {
            linesEl.scrollTop = top - linesEl.clientHeight / 3;
          }
        }
      }
      // Released on the next frame so the scroll this caused is not read back
      // as the reader taking over.
      requestAnimationFrame(() => requestAnimationFrame(() => { programmatic = false; }));
    }

    function setFollow(on: boolean) {
      follow = on;
      const btn = document.getElementById('tx-follow');
      btn?.setAttribute('aria-pressed', String(on));
    }

    /**
     * Follow yields only to a scroll of whatever it drives: the lines box while
     * that box scrolls, the page once the transcript is expanded and the box no
     * longer does. Scrolling the rest of the page to read around the transcript
     * leaves following alone.
     */
    function onManualScroll(source: 'lines' | 'window') {
      if (programmatic || !follow) return;
      const boxScrolls = linesEl.scrollHeight > linesEl.clientHeight + 4;
      if (source === 'lines' ? boxScrolls : !boxScrolls) setFollow(false);
    }

    /** Scrolls the transcript to whatever paragraph covers this time. */
    function scrollTranscriptTo(t: number, mode: 'nearest' | 'top') {
      if (!paras.length) return;
      let idx = 0;
      for (let i = 0; i < paras.length; i++) {
        if (paras[i].start <= t) idx = i; else break;
      }
      const el = linesEl.querySelector<HTMLElement>(`#${CSS.escape(segId(idx))}`);
      if (el) scrollLinesTo(el, mode);
    }

    function syncTo(t: number) {
      if (!paras.length) return;
      let lo = 0, hi = paras.length - 1, found = -1;
      while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (paras[mid].start <= t) { found = mid; lo = mid + 1; } else { hi = mid - 1; }
      }
      if (found !== currentIndex && found >= 0) {
        linesEl.querySelector('.is-current')?.classList.remove('is-current');
        currentIndex = found;
        const el = linesEl.querySelector<HTMLElement>(`#${CSS.escape(segId(found))}`);
        if (el) {
          el.classList.add('is-current');
          if (follow) scrollLinesTo(el, 'center');
        }
      }
      if (duration) {
        const view = document.getElementById('tx-minimap-view')!;
        view.style.top = `${(t / duration) * 100}%`;
        view.style.height = '2px';
      }
    }

    const a = audio();
    a?.addEventListener('timeupdate', () => syncTo(a.currentTime));

    document.getElementById('tx-follow')?.addEventListener('click', () => {
      setFollow(!follow);
      if (follow && currentIndex >= 0) {
        const el = linesEl.querySelector<HTMLElement>(`#${CSS.escape(segId(currentIndex))}`);
        if (el) scrollLinesTo(el, 'center');
      }
    });

    linesEl.addEventListener('scroll', () => onManualScroll('lines'), { passive: true });
    window.addEventListener('scroll', () => onManualScroll('window'), { passive: true });
    linesEl.addEventListener('wheel', () => setFollow(false), { passive: true });

    document.getElementById('tx-expand')?.addEventListener('click', e => {
      const btn = e.currentTarget as HTMLElement;
      const on = bodyEl.dataset.expanded !== '1';
      bodyEl.dataset.expanded = on ? '1' : '';
      btn.setAttribute('aria-pressed', String(on));
      btn.textContent = on ? 'Collapse' : 'Expand';
      // The lines box stops being the scroll container when expanded, so any
      // pending scroll position has to be re-resolved against the page.
      if (currentIndex >= 0 && follow) {
        const el = linesEl.querySelector<HTMLElement>(`#${CSS.escape(segId(currentIndex))}`);
        if (el) requestAnimationFrame(() => scrollLinesTo(el, 'center'));
      }
    });

    document.getElementById('tx-edits-toggle')?.addEventListener('click', e => {
      const panel = document.getElementById('tx-edits')!;
      const open = panel.hidden;
      panel.hidden = !open;
      bodyEl.dataset.edits = open ? 'open' : '';
      (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(open));
    });

    let searchTrack: ReturnType<typeof setTimeout> | undefined;
    const search = document.getElementById('tx-search') as HTMLInputElement;
    const hits = document.getElementById('tx-hits')!;
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let n = 0;
      linesEl.querySelectorAll<HTMLElement>('.tx-word').forEach(w => {
        const on = q.length > 1 && w.textContent!.toLowerCase().includes(q);
        w.classList.toggle('is-hit', on);
        if (on) n++;
      });
      hits.textContent = q.length > 1 ? `${n} hit${n === 1 ? '' : 's'}` : '';
      if (q.length > 2) {
        clearTimeout(searchTrack);
        searchTrack = setTimeout(() => track('transcript.search', slug, { q, hits: n }), 600);
      }
      const hit = linesEl.querySelector<HTMLElement>('.is-hit');
      if (hit) scrollLinesTo(hit);
    });

    const tip = document.getElementById('tx-tip')!;
    /**
     * A correction is written against a passage: the selection plus a little
     * either side. What gets stored is still the whole paragraph, with that
     * passage spliced back in, so an accepted edit applies without having to
     * find its window again later.
     */
    interface PendingSel {
      anchor: string;
      /** The paragraph as it currently reads. */
      paraText: string;
      /** The passage shown for editing, as offsets into paraText. */
      winStart: number;
      winEnd: number;
      /** Where the selection sits inside the passage. */
      selStart: number;
      selEnd: number;
      at: number;
    }
    let pendingSel: PendingSel | null = null;

    /**
     * Reads a paragraph as one string and locates a range inside it. The
     * timestamp is skipped so offsets line up with the words a reader sees.
     */
    function offsetsIn(para: HTMLElement, range: Range) {
      const walker = document.createTreeWalker(para, NodeFilter.SHOW_TEXT, {
        acceptNode: n =>
          (n.parentElement?.closest('.tx-at')
            ? NodeFilter.FILTER_REJECT
            : NodeFilter.FILTER_ACCEPT),
      });
      let text = '';
      let start: number | null = null;
      let end: number | null = null;
      let node: Node | null;
      while ((node = walker.nextNode())) {
        if (node === range.startContainer) start = text.length + range.startOffset;
        if (node === range.endContainer) end = text.length + range.endOffset;
        text += node.nodeValue ?? '';
      }
      return { text, start, end };
    }

    document.addEventListener('selectionchange', () => {
      const sel = document.getSelection();
      if (!sel || sel.isCollapsed || !sel.rangeCount) { tip.hidden = true; return; }
      const node = sel.anchorNode;
      const para = (node instanceof Element ? node : node?.parentElement)?.closest('.tx-para');
      if (!para || !linesEl.contains(para)) { tip.hidden = true; return; }

      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      if (!rect.width) { tip.hidden = true; return; }
      tip.style.left = `${rect.left + rect.width / 2 + window.scrollX}px`;
      tip.style.top = `${rect.top + window.scrollY - 6}px`;
      tip.hidden = false;
      setFollow(false);

      const { text, start, end } = offsetsIn(para as HTMLElement, range);
      // A selection reaching past this paragraph has no offset inside it, so
      // fall back to the whole thing rather than guess at a window.
      const from = Math.min(start ?? 0, end ?? text.length);
      const to = Math.max(start ?? 0, end ?? text.length);
      const win = windowAround(text, from, to);

      pendingSel = {
        anchor: segId(Number((para as HTMLElement).dataset.index)),
        paraText: text,
        winStart: win.start,
        winEnd: win.end,
        selStart: from - win.start,
        selEnd: to - win.start,
        at: Number((para as HTMLElement).dataset.at),
      };
    });

    const dialog = document.getElementById('tx-dialog') as HTMLDialogElement;
    document.getElementById('tx-propose')?.addEventListener('click', () => {
      if (!pendingSel) return;
      if (!getUser()) { document.getElementById('account-signin')?.click(); return; }
      const { paraText, winStart, winEnd, selStart, selEnd } = pendingSel;
      const passage = paraText.slice(winStart, winEnd);

      // Show the passage with the selected words marked, so it is obvious which
      // part is the edit and which is only there for context.
      const orig = document.getElementById('tx-original') as HTMLElement;
      orig.textContent = '';
      const picked = document.createElement('span');
      picked.className = 'tx-original-sel';
      picked.textContent = passage.slice(selStart, selEnd);
      orig.append(passage.slice(0, selStart), picked, passage.slice(selEnd));

      const box = document.getElementById('tx-proposed') as HTMLTextAreaElement;
      box.value = passage;
      tip.hidden = true;
      dialog.showModal();
      // The caret starts where the highlight did, not at the end of the box.
      box.focus();
      box.setSelectionRange(selStart, selStart);
    });

    // Selecting text and taking a note anchors it to that moment in the round.
    document.getElementById('tx-note')?.addEventListener('click', async () => {
      if (!pendingSel) return;
      if (!getUser()) { document.getElementById('account-signin')?.click(); return; }
      const quote = document.getSelection()?.toString().trim().slice(0, 300) ?? '';
      try {
        await addNote(slug, pendingSel.at, quote);
        tip.hidden = true;
        document.dispatchEvent(new CustomEvent('gt:notes-changed'));
        document.querySelector('.account')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (e) {
        if (e instanceof NotSignedIn) document.getElementById('account-signin')?.click();
      }
    });

    document.getElementById('tx-cancel')?.addEventListener('click', () => dialog.close());

    document.getElementById('tx-form')?.addEventListener('submit', async e => {
      const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if ((submitter && submitter.value !== 'ok') || !pendingSel) return;
      e.preventDefault();
      const { paraText, winStart, winEnd } = pendingSel;
      const passage = (document.getElementById('tx-proposed') as HTMLTextAreaElement).value.trim();
      // The corrected passage goes back into its paragraph before it is sent:
      // a revision replaces the paragraph, so it has to carry the whole thing.
      const proposed = paraText.slice(0, winStart) + passage + paraText.slice(winEnd);
      const note = (document.getElementById('tx-note-input') as HTMLInputElement).value.trim();
      const err = document.getElementById('tx-error')!;
      try {
        const res = await propose(slug, {
          kind: 'transcript', anchor: pendingSel.anchor,
          original: paraText, proposed, note: note || undefined,
          // The moment the passage is spoken, so a reviewer can hear it
          // without having to find it first.
          startS: Math.round(pendingSel.at),
        });
        err.hidden = true;
        dialog.close();
        // An admin's edit is accepted on submit, so the passage has to redraw
        // rather than wait for the next visit.
        if (res.accepted) await refreshRevisions();
        void loadProposals();
      } catch (ex: any) {
        err.textContent = ex instanceof NotSignedIn ? 'Sign in first' : (ex.message ?? 'Failed');
        err.hidden = false;
      }
    });

    /**
     * Transcript revisions replace their paragraph; boundary revisions move the
     * dividers, the tinting and the minimap with them.
     */
    function takeRevisions(list: Revision[]) {
      revisions.clear();
      for (const r of list) {
        if (r.kind === 'transcript') revisions.set(r.anchor, r.value);
      }
      speeches = applyBoundaries(speeches, list);
    }

    async function refreshRevisions() {
      const res = await listRevisions(slug).catch(() => null);
      if (!res) return;
      takeRevisions(res.revisions);
      render();
      buildMinimap();
    }

    async function loadProposals() {
      const list = document.getElementById('tx-proposals');
      const empty = document.getElementById('tx-edits-empty');
      const toggle = document.getElementById('tx-edits-toggle')!;
      if (!list) return;
      const all = await listProposals(slug).catch(() => ({ proposals: [] as Proposal[] }));
      // Timing corrections anchor to a speech label, not a paragraph, so they
      // belong to the player rather than this margin.
      const proposals = all.proposals.filter(p => p.kind === 'transcript');

      // The panel is only offered when there is something in it.
      toggle.hidden = proposals.length === 0;
      if (proposals.length) toggle.textContent = `Edits (${proposals.length})`;
      if (empty) empty.hidden = proposals.length > 0;

      list.innerHTML = '';
      const me = getUser();
      for (const p of proposals) {
        // Mark the affected paragraph so a reader can see it was touched.
        linesEl.querySelector(`#${CSS.escape(p.anchor)}`)?.classList.add('has-proposal');

        const li = document.createElement('li');
        li.className = p.status === 'accepted' ? 'proposal is-accepted' : 'proposal';

        // Hovering an edit points at the passage it changes.
        const target = () => linesEl.querySelector<HTMLElement>(`#${CSS.escape(p.anchor)}`);
        li.addEventListener('pointerenter', () => {
          const el = target();
          if (!el) return;
          el.classList.add('is-targeted');
          scrollLinesTo(el);
        });
        li.addEventListener('pointerleave', () => target()?.classList.remove('is-targeted'));
        li.addEventListener('click', e => {
          if ((e.target as Element).closest('button')) return;
          const el = target();
          if (el) scrollLinesTo(el, 'top');
        });
        li.append(renderDiff(p.original, p.proposed));

        // The round's own audio is right here, so hearing the passage is a
        // seek rather than a second stream.
        const at = p.start_s ?? paras[Number(p.anchor.replace('seg-', ''))]?.start ?? null;
        if (at !== null && audio()) {
          const listen = document.createElement('button');
          listen.className = 'chip proposal-listen';
          listen.textContent = `Listen at ${formatTime(at)}`;
          listen.addEventListener('click', e => {
            e.stopPropagation();
            const a = audio()!;
            a.currentTime = Math.max(0, at - 2);
            void a.play().catch(() => {});
          });
          li.append(listen);
        }

        const meta = document.createElement('div');
        meta.className = 'proposal-meta';
        const up = document.createElement('button');
        up.className = 'vote'; up.textContent = '+';
        const score = document.createElement('span');
        score.className = 'proposal-score'; score.textContent = String(p.score);
        const down = document.createElement('button');
        down.className = 'vote'; down.textContent = '−';
        const who = document.createElement('span');
        who.textContent = p.status === 'accepted' ? 'accepted' : p.author;

        const cast = async (value: 1 | -1) => {
          try {
            const r = await vote(p.id, value);
            score.textContent = String(r.score);
            if (r.accepted) void location.reload();
          } catch (ex) {
            if (ex instanceof NotSignedIn) document.getElementById('account-signin')?.click();
          }
        };
        up.addEventListener('click', () => cast(1));
        down.addEventListener('click', () => cast(-1));
        meta.append(up, score, down, who);
        li.append(meta);

        // An admin settles an edit where it is read rather than having to find
        // it again in the dashboard. Accepting applies it to the transcript at
        // once, which is the point of doing it here.
        if (isAdmin() && p.status === 'open') {
          const resolve = document.createElement('div');
          resolve.className = 'proposal-own';

          for (const action of ['accept', 'reject'] as const) {
            const b = document.createElement('button');
            b.className = 'chip';
            b.textContent = action === 'accept' ? 'Accept' : 'Reject';
            b.addEventListener('click', async e => {
              e.stopPropagation();
              b.disabled = true;
              try {
                await adminResolve(p.id, action);
                if (action === 'accept') await refreshRevisions();
                else target()?.classList.remove('has-proposal');
                void loadProposals();
              } catch { b.disabled = false; }
            });
            resolve.appendChild(b);
          }
          li.appendChild(resolve);
        }

        // An author can revise or withdraw their own edit while it is open.
        if (me && p.author_id === me.id && p.status === 'open') {
          const own = document.createElement('div');
          own.className = 'proposal-own';

          const edit = document.createElement('button');
          edit.className = 'chip';
          edit.textContent = 'Edit';
          edit.addEventListener('click', async () => {
            const next = window.prompt('Update your correction', p.proposed);
            if (next === null || !next.trim() || next === p.proposed) return;
            try { await updateProposal(p.id, next.trim()); void loadProposals(); }
            catch { /* surfaced by the reload */ }
          });

          const remove = document.createElement('button');
          remove.className = 'chip';
          remove.textContent = 'Delete';
          remove.addEventListener('click', async () => {
            if (!window.confirm('Withdraw this correction?')) return;
            try {
              await deleteProposal(p.id);
              target()?.classList.remove('has-proposal');
              void loadProposals();
            } catch { /* surfaced by the reload */ }
          });

          own.append(edit, remove);
          li.appendChild(own);
        }

        list.appendChild(li);
      }
    }

    void load();
  }
</script>
