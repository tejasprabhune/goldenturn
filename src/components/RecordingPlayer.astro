---
import { formatTime } from '../lib/waveform';

interface Props {
  slug: string;
  title: string;
  /** Present when the round has media in R2; absent for embed-only rounds. */
  hasMedia: boolean;
  videoEmbed?: { kind: 'youtube' | 'vimeo'; id: string } | null;
  sourceLink: string;
}

const { slug, title, hasMedia, videoEmbed = null, sourceLink } = Astro.props;
const MEDIA = 'https://media.goldenturn.org';
const SPEEDS = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
---

<section
  class="player"
  data-slug={slug}
  data-media={hasMedia ? `${MEDIA}/audio/${slug}.m4a` : ''}
  data-peaks={hasMedia ? `${MEDIA}/peaks/${slug}.json` : ''}
>
  {videoEmbed && (
    <div class="player-video" id="player-video">
      <iframe
        id="player-iframe"
        src={videoEmbed.kind === 'youtube'
          ? `https://www.youtube.com/embed/${videoEmbed.id}`
          : `https://player.vimeo.com/video/${videoEmbed.id}`}
        title={`Video of ${title}`}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  )}

  {hasMedia ? (
    <>
      <div class="wave-wrap">
        <canvas
          id="wave"
          class="wave"
          tabindex="0"
          role="slider"
          aria-label={`Seek within ${title}`}
          aria-valuemin="0"
          aria-valuenow="0"
          aria-valuetext="0:00"
        ></canvas>
        <div class="wave-tip" id="wave-tip" hidden></div>
        <p class="wave-loading label label-muted" id="wave-loading">loading waveform</p>
      </div>

      <div class="transport">
        <button id="play" class="transport-play" aria-label="Play">
          <span id="play-icon">play</span>
        </button>

        <span class="transport-time" id="time">0:00</span>
        <span class="transport-sep" aria-hidden="true">/</span>
        <span class="transport-time transport-total" id="total">0:00</span>

        <div class="transport-right">
          {videoEmbed && (
            <button id="toggle-video" class="chip" aria-pressed="true">video on</button>
          )}
          <label class="speed">
            <span class="label label-muted">speed</span>
            <select id="speed" class="field speed-select" aria-label="Playback speed">
              {SPEEDS.map(s => <option value={s} selected={s === 1}>{s}x</option>)}
            </select>
          </label>
          <a class="chip" href={`${MEDIA}/audio/${slug}.m4a`} download>download</a>
        </div>
      </div>

      <div class="loop" id="loop" hidden>
        <span class="label label-muted">loop</span>
        <span class="loop-range" id="loop-range"></span>
        <button class="chip" id="loop-clear">clear</button>
      </div>

      <div class="speeches-row">
        <div class="speeches" id="speeches" hidden></div>
        <button class="chip" id="fix-speeches" aria-pressed="false" hidden>Fix timings</button>
        <button class="chip" id="toggle-proposed" aria-expanded="false" hidden></button>
      </div>

      <div class="timing-votes" id="timing-votes" hidden>
        <ul class="timing-list" id="timing-list"></ul>
        <p class="label label-muted timing-conflict" id="timing-conflict" hidden></p>
      </div>

      <div class="fixer" id="fixer" hidden>
        <p class="label label-muted">
          Drag the edges of a speech on the waveform, or scrub and use the
          buttons. Corrections are proposed and go live once others agree.
        </p>
        <div class="fixer-rows" id="fixer-rows"></div>
        <div class="fixer-actions">
          <button class="btn" id="fixer-submit">Propose these timings</button>
          <button class="chip" id="fixer-cancel">Cancel</button>
          <span class="label label-muted" id="fixer-status"></span>
        </div>
      </div>

      <dl class="keys">
        <div class="key-row"><dt>Play</dt><dd><kbd>Space</kbd></dd></div>
        <div class="key-row"><dt>Seek</dt><dd><kbd>&larr;</kbd><kbd>&rarr;</kbd></dd></div>
        <div class="key-row"><dt>Seek 30s</dt><dd><kbd>Shift</kbd><kbd>&larr;</kbd></dd></div>
        <div class="key-row"><dt>Speech</dt><dd><kbd>1</kbd><span>&ndash;</span><kbd>6</kbd></dd></div>
        <div class="key-row"><dt>Loop</dt><dd><kbd>Shift</kbd><kbd>drag</kbd></dd></div>
        <div class="key-row"><dt>2x</dt><dd><kbd>hold</kbd></dd></div>
      </dl>

      <audio id="audio" preload="metadata" src={`${MEDIA}/audio/${slug}.m4a`}></audio>
    </>
  ) : (
    <p class="page-lede" style="margin-top: 0;">
      No hosted audio for this round.
      <a href={sourceLink} target="_blank" rel="noopener noreferrer" class="link">Open the original source</a>.
    </p>
  )}
</section>

<style>
  .player {
    margin-bottom: 2rem;
  }

  .player-video {
    margin-bottom: 1.25rem;
  }

  .player-video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    display: block;
    background: var(--ink);
  }

  .player-video[hidden] {
    display: none;
  }

  .wave-wrap {
    position: relative;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  /* A long press on touch is the 2x gesture, so the browser must not read it as
     a text selection or callout. */
  .wave-wrap,
  .wave {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .wave {
    display: block;
    width: 100%;
    height: 132px;
    cursor: crosshair;
    touch-action: none;
  }

  /* Edges are grab targets while fixing. */
  .player[data-fixing='1'] .wave {
    cursor: ew-resize;
  }

  .wave:focus-visible {
    outline: 2px solid var(--sky-deep);
    outline-offset: -2px;
  }

  .wave-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    pointer-events: none;
  }

  .wave-loading[hidden] {
    display: none;
  }

  .wave-tip {
    position: absolute;
    top: 0.4rem;
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--paper);
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    padding: 0.1rem 0.35rem;
    pointer-events: none;
    white-space: nowrap;
  }

  .wave-tip[hidden] {
    display: none;
  }

  .transport {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.9rem;
    flex-wrap: wrap;
  }

  .transport-play {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    background: var(--gold);
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    min-width: 6rem;
    transition: background-color 60ms linear;
  }

  .transport-play:hover {
    background: var(--sky);
  }

  .transport-time {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .transport-total {
    color: rgba(23, 21, 15, 0.45);
  }

  .transport-sep {
    color: rgba(23, 21, 15, 0.3);
  }

  .transport-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .speed {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .speed-select {
    padding: 0.3rem 0.4rem;
    font-size: 0.8125rem;
  }

  .loop {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 0.75rem;
  }

  .loop[hidden] {
    display: none;
  }

  .loop-range {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }


  /* One quiet line of shortcuts under the speech row. */
  .keys {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.1rem;
    padding-top: 0.85rem;
  }

  @media (max-width: 720px) {
    .keys {
      display: none;
    }
  }

  .key-row {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .keys dt {
    font-size: 0.75rem;
    color: rgba(23, 21, 15, 0.5);
    white-space: nowrap;
  }

  .keys dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .keys kbd {
    font-family: 'Neue Montreal', system-ui, sans-serif;
    font-size: 0.6875rem;
    border: 1px solid var(--rule);
    padding: 0.1rem 0.35rem;
    min-width: 1.3rem;
    text-align: center;
    color: var(--ink);
    background: var(--paper-raised);
  }

  .keys dd span {
    font-size: 0.6875rem;
    color: rgba(23, 21, 15, 0.4);
  }

  .speeches-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
  }

  .speeches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fixer {
    border-top: 1px solid var(--rule);
    margin-top: 1rem;
    padding-top: 0.9rem;
  }

  .fixer[hidden] {
    display: none;
  }

  /* Columns are chosen from the space the player actually has, not from the
     viewport: in the compact layout the player sits in a half-width column, and
     a viewport query put three columns in it and wrapped "End here" onto its
     own line. A row needs about 23rem to stay on one line. */
  .fixer-rows {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(23rem, 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0.9rem 0;
  }

  @media (max-width: 560px) {
    .fixer-rows {
      grid-template-columns: 1fr;
    }
  }

  .fixer-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* Pending timing corrections, hidden until asked for. Rows are built in the
     browser, so their styles live in global.css. */
  /* The last row drops its rule and the panel pads both ends equally, so the
     gap above the first timing matches the gap below the last. */
  .timing-votes {
    border-top: 1px solid var(--rule);
    margin-top: 1rem;
    padding-block: 0.35rem;
  }

  .timing-votes .timing-list {
    margin: 0;
  }

  .timing-votes[hidden] {
    display: none;
  }

  .timing-conflict {
    margin: 0.6rem 0 0;
    color: var(--gold-deep);
  }

  .timing-conflict[hidden] {
    display: none;
  }

  .speeches[hidden] {
    display: none;
  }

  audio {
    display: none;
  }

  @media (max-width: 640px) {
    .wave {
      height: 96px;
    }

    .transport-right {
      margin-left: 0;
      width: 100%;
      padding-top: 0.5rem;
    }
  }
</style>

<script>
  import { Waveform, formatTime, type PeaksFile } from '../lib/waveform';
  import {
    track, propose, listRevisions, listProposals, vote, getUser, NotSignedIn,
    type Proposal,
  } from '../lib/api';
  import {
    sideOf, usable, applyBoundaries, parseSpan, withSpans, conflicts,
    type Speech, type Span,
  } from '../lib/speeches';

  // The frontmatter MEDIA constant is server-side only; the client needs its own.
  const MEDIA = 'https://media.goldenturn.org';

  const root = document.querySelector<HTMLElement>('.player');
  const audio = document.getElementById('audio') as HTMLAudioElement | null;
  const canvas = document.getElementById('wave') as HTMLCanvasElement | null;

  if (root && audio && canvas) {
    const slug = root.dataset.slug!;
    const peaksUrl = root.dataset.peaks!;
    const wave = new Waveform(canvas);
    const playBtn = document.getElementById('play')!;
    const playIcon = document.getElementById('play-icon')!;
    const timeEl = document.getElementById('time')!;
    const totalEl = document.getElementById('total')!;
    const tip = document.getElementById('wave-tip') as HTMLElement;
    const loading = document.getElementById('wave-loading') as HTMLElement;
    const loopBar = document.getElementById('loop') as HTMLElement;
    const loopRange = document.getElementById('loop-range')!;
    const speed = document.getElementById('speed') as HTMLSelectElement;
    const videoWrap = document.getElementById('player-video');
    const iframe = document.getElementById('player-iframe') as HTMLIFrameElement | null;
    const toggleVideo = document.getElementById('toggle-video');

    const positionKey = `gt:pos:${slug}`;
    track('round.view', slug);

    fetch(peaksUrl)
      .then(r => r.ok ? r.json() : Promise.reject(new Error(String(r.status))))
      .then((file: PeaksFile) => {
        wave.setData(file);
        totalEl.textContent = formatTime(file.duration);
        loading.hidden = true;
        applyDeepLink(file.duration);
      })
      .catch(() => { loading.textContent = 'waveform unavailable'; });

    function applyDeepLink(duration: number) {
      const t = Number(new URLSearchParams(location.search).get('t'));
      const saved = Number(localStorage.getItem(positionKey) ?? '0');
      const start = Number.isFinite(t) && t > 0 ? t : saved;
      if (start > 0 && start < duration - 5) {
        audio!.currentTime = start;
        wave.position = start;
        wave.draw();
        timeEl.textContent = formatTime(start);
      }
    }

    function setPlaying(playing: boolean) {
      playIcon.textContent = playing ? 'pause' : 'play';
      playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    }

    playBtn.addEventListener('click', () => {
      if (audio.paused) audio.play(); else audio.pause();
    });
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('loadedmetadata', () => {
      if (isFinite(audio.duration)) {
        totalEl.textContent = formatTime(audio.duration);
        canvas.setAttribute('aria-valuemax', String(Math.floor(audio.duration)));
      }
    });

    let lastSaved = 0;
    audio.addEventListener('timeupdate', () => {
      const t = audio.currentTime;
      wave.position = t;
      timeEl.textContent = formatTime(t);
      // The canvas is the seek control, so assistive tech needs its position.
      canvas.setAttribute('aria-valuenow', String(Math.floor(t)));
      canvas.setAttribute('aria-valuetext', formatTime(t));
      wave.draw();

      if (wave.selection && t >= wave.selection.end) {
        audio.currentTime = wave.selection.start;
      }
      if (t - lastSaved > 5 || lastSaved - t > 5) {
        lastSaved = t;
        localStorage.setItem(positionKey, String(Math.floor(t)));
      }
    });

    speed?.addEventListener('change', () => { audio.playbackRate = Number(speed.value); });

    // Video is an embed we cannot drive, so audio-only simply hides it and
    // leaves the audio element as the single source of truth.
    toggleVideo?.addEventListener('click', () => {
      const on = toggleVideo.getAttribute('aria-pressed') === 'true';
      toggleVideo.setAttribute('aria-pressed', String(!on));
      toggleVideo.textContent = on ? 'video off' : 'video on';
      if (videoWrap) videoWrap.hidden = on;
      if (on && iframe) iframe.src = iframe.src; // stop playback when hidden
    });

    function seekFromEvent(e: PointerEvent) {
      const rect = canvas!.getBoundingClientRect();
      return wave.xToTime(e.clientX - rect.left);
    }

    let dragging = false;
    let selecting = false;
    let selectStart = 0;
    let fixing = false;
    let grabbed: { label: string; edge: 'start' | 'end' } | null = null;

    canvas.addEventListener('pointerdown', e => {
      canvas.setPointerCapture(e.pointerId);
      // pointerdown is default-prevented for the hold gesture, so focus the
      // seek control by hand.
      canvas.focus({ preventScroll: true });
      if (fixing) {
        const rect = canvas.getBoundingClientRect();
        const hit = edgeAt(wave.xToTime(e.clientX - rect.left));
        if (hit) { grabbed = hit; return; }
      }
      if (e.shiftKey) {
        selecting = true;
        selectStart = seekFromEvent(e);
        wave.selection = { start: selectStart, end: selectStart };
      } else {
        dragging = true;
        audio.currentTime = seekFromEvent(e);
      }
      wave.draw();
    });

    canvas.addEventListener('pointermove', e => {
      const t = seekFromEvent(e);
      if (grabbed) {
        const d = draft[grabbed.label];
        // Keep at least ten seconds of speech so an edge cannot cross itself.
        if (grabbed.edge === 'start') d.start = Math.min(Math.round(t), d.end - 10);
        else d.end = Math.max(Math.round(t), d.start + 10);
        renderFixerRows();
        previewDraft();
        return;
      }
      wave.hover = t;
      const rect = canvas.getBoundingClientRect();
      tip.hidden = false;
      tip.style.left = `${e.clientX - rect.left}px`;
      tip.textContent = formatTime(t);

      if (selecting) {
        wave.selection = { start: Math.min(selectStart, t), end: Math.max(selectStart, t) };
      } else if (dragging && !holding) {
        audio.currentTime = t;
      }
      wave.draw();
    });

    // Press and hold plays at double speed; releasing restores the chosen rate.
    // On touch the press must not double as a scrub, so a finger that drifts
    // more than a few pixels cancels the hold and goes back to seeking.
    let holdTimer: ReturnType<typeof setTimeout> | undefined;
    let holding = false;
    let holdOrigin: { x: number; y: number } | null = null;
    const HOLD_SLOP = 10;

    canvas.addEventListener('pointerdown', e => {
      // Suppress the native long-press selection and magnifier.
      e.preventDefault();
      holdOrigin = { x: e.clientX, y: e.clientY };
      holdTimer = setTimeout(() => {
        holding = true;
        audio.playbackRate = 2;
        if (audio.paused) void audio.play().catch(() => {});
      }, 350);
    });

    canvas.addEventListener('pointermove', e => {
      if (holding || !holdOrigin) return;
      if (Math.abs(e.clientX - holdOrigin.x) > HOLD_SLOP ||
          Math.abs(e.clientY - holdOrigin.y) > HOLD_SLOP) {
        clearTimeout(holdTimer);
        holdOrigin = null;
      }
    });

    const releaseHold = () => {
      clearTimeout(holdTimer);
      holdOrigin = null;
      if (holding) {
        holding = false;
        audio.playbackRate = Number(speed?.value ?? 1);
      }
    };
    canvas.addEventListener('pointerup', releaseHold);
    canvas.addEventListener('pointercancel', releaseHold);
    canvas.addEventListener('pointerleave', releaseHold);
    canvas.addEventListener('contextmenu', e => e.preventDefault());

    canvas.addEventListener('pointerup', () => {
      if (grabbed) { grabbed = null; return; }
      if (selecting && wave.selection && wave.selection.end - wave.selection.start > 1) {
        loopBar.hidden = false;
        loopRange.textContent = `${formatTime(wave.selection.start)} to ${formatTime(wave.selection.end)}`;
        audio.currentTime = wave.selection.start;
      } else if (selecting) {
        wave.selection = null;
      }
      dragging = false;
      selecting = false;
      wave.draw();
    });

    canvas.addEventListener('pointerleave', () => {
      wave.hover = null;
      tip.hidden = true;
      wave.draw();
    });

    document.getElementById('loop-clear')?.addEventListener('click', () => {
      wave.selection = null;
      loopBar.hidden = true;
      wave.draw();
    });

    document.addEventListener('keydown', e => {
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.key === ' ') {
        e.preventDefault();
        if (audio.paused) audio.play(); else audio.pause();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        audio.currentTime = Math.min(audio.duration || 1e9, audio.currentTime + (e.shiftKey ? 30 : 5));
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        audio.currentTime = Math.max(0, audio.currentTime - (e.shiftKey ? 30 : 5));
      }
    });

    // Speech regions shade the waveform and give keyboard jumps 1-6.
    let speechStarts: number[] = [];
    function applyFitted(found: Speech[], trying = false) {
      wave.setSegments(found.map(s => ({
        label: s.label, start: s.start, end: s.end, confidence: s.confidence,
        side: sideOf(s.label),
      })));
      root!.dataset.trying = trying ? '1' : '';

      // The transcript tints its paragraphs and draws its minimap from the same
      // fit, so it has to hear about corrections the player has applied.
      document.dispatchEvent(new CustomEvent('gt:speeches', {
        detail: { slug, speeches: found },
      }));

      const box = document.getElementById('speeches')!;
      box.innerHTML = '';
      box.hidden = found.length === 0;
      speechStarts = found.map(s => s.start);
      found.forEach(s => {
        const b = document.createElement('button');
        b.className = 'speech-jump';
        if (s.confidence < 0.6) {
          b.dataset.unsure = '1';
          b.title = 'Timing is uncertain; corrections welcome';
        }
        b.append(s.label);
        const at = document.createElement('span');
        at.className = 'speech-jump-at';
        at.textContent = formatTime(s.start);
        b.appendChild(at);
        b.addEventListener('click', () => {
          audio.currentTime = s.start;
          void audio.play();
          track('speech.jump', slug, { label: s.label });
        });
        box.appendChild(b);
      });
    }

    Promise.allSettled([
      fetch(`${MEDIA}/speeches/${slug}.json`).then(r => (r.ok ? r.json() : null)),
      listRevisions(slug),
    ]).then(([fitRes, revRes]) => {
      const fit = fitRes.status === 'fulfilled' ? fitRes.value : null;
      if (!fit) return;
      let found = usable(fit.speeches ?? []);
      if (!found.length) return;

      if (revRes.status === 'fulfilled') {
        found = applyBoundaries(found, revRes.value.revisions);
      }

      fitted = found;
      applyFitted(found);
      const fix = document.getElementById('fix-speeches');
      if (fix) fix.hidden = false;
      void loadTimingProposals();
    });

    canvas.addEventListener('keydown', e => {
      if (e.key === 'Home') { e.preventDefault(); audio.currentTime = 0; }
      else if (e.key === 'End') { e.preventDefault(); audio.currentTime = Math.max(0, audio.duration - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); if (audio.paused) void audio.play(); else audio.pause(); }
    });

    document.addEventListener('keydown', e => {
      const tag = document.activeElement?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      const n = Number(e.key);
      if (n >= 1 && n <= 6 && speechStarts[n - 1] !== undefined) {
        e.preventDefault();
        audio.currentTime = speechStarts[n - 1];
        void audio.play();
      }
    });

    // Timing corrections. Boundaries are proposed, not written directly, so
    // they go through the same review as transcript edits.
    let fitted: Speech[] = [];
    let draft: Record<string, { start: number; end: number }> = {};

    function openFixer() {
      if (!getUser()) { document.dispatchEvent(new CustomEvent('gt:open-signin')); return; }
      // Fixing works against the round's accepted timings, so a set of
      // proposals being tried out is put away first.
      setProposedPanel(false);
      draft = {};
      for (const s of fitted) draft[s.label] = { start: s.start, end: s.end };
      renderFixerRows();
      document.getElementById('fixer')!.hidden = false;
      document.getElementById('fix-speeches')?.setAttribute('aria-pressed', 'true');
      fixing = true;
      root!.dataset.fixing = '1';
      previewDraft();
    }

    function renderFixerRows() {
      const rows = document.getElementById('fixer-rows')!;
      rows.innerHTML = '';
      for (const s of fitted) {
        const d = draft[s.label];
        const row = document.createElement('div');
        row.className = 'fixer-row';

        const label = document.createElement('span');
        label.className = 'fixer-label';
        label.textContent = s.label;

        const times = document.createElement('span');
        times.className = 'fixer-at';
        times.textContent = `${formatTime(d.start)} to ${formatTime(d.end)}`;

        const len = document.createElement('span');
        len.className = 'fixer-len';
        len.textContent = `${((d.end - d.start) / 60).toFixed(1)}m`;

        const setStart = document.createElement('button');
        setStart.className = 'chip';
        setStart.textContent = 'Start here';
        setStart.addEventListener('click', () => {
          draft[s.label].start = Math.round(audio.currentTime);
          renderFixerRows();
          previewDraft();
        });

        const setEnd = document.createElement('button');
        setEnd.className = 'chip';
        setEnd.textContent = 'End here';
        setEnd.addEventListener('click', () => {
          draft[s.label].end = Math.round(audio.currentTime);
          renderFixerRows();
          previewDraft();
        });

        row.append(label, times, len, setStart, setEnd);
        rows.appendChild(row);
      }
    }

    // Dragging repaints the waveform only. The transcript follows accepted
    // timings, not an in-progress draft, so it is left alone until cancel or
    // the next load.
    function previewDraft() {
      wave.setSegments(fitted.map(s => ({
        label: s.label,
        start: draft[s.label]?.start ?? s.start,
        end: draft[s.label]?.end ?? s.end,
        confidence: s.confidence,
        side: sideOf(s.label),
      })));
    }

    /**
     * While fixing, the waveform edges become drag handles. Seeking is
     * suppressed for a grab so a drag never doubles as a scrub.
     */
    function edgeAt(t: number): { label: string; edge: 'start' | 'end' } | null {
      const tolerance = (wave.xToTime(12) - wave.xToTime(0)) || 5;
      for (const s of fitted) {
        const d = draft[s.label];
        if (!d) continue;
        if (Math.abs(t - d.start) <= tolerance) return { label: s.label, edge: 'start' };
        if (Math.abs(t - d.end) <= tolerance) return { label: s.label, edge: 'end' };
      }
      return null;
    }

    // A second press puts the fixer away rather than leaving it open with no
    // way back except Cancel.
    document.getElementById('fix-speeches')?.addEventListener('click', () => {
      if (fixing) {
        closeFixer();
        applyFitted(fitted);
      } else {
        openFixer();
      }
    });

    document.getElementById('fixer-cancel')?.addEventListener('click', () => {
      closeFixer();
      applyFitted(fitted);
    });

    function closeFixer() {
      document.getElementById('fixer')!.hidden = true;
      document.getElementById('fix-speeches')?.setAttribute('aria-pressed', 'false');
      fixing = false;
      root!.dataset.fixing = '';
    }

    document.getElementById('fixer-submit')?.addEventListener('click', async e => {
      const btn = e.currentTarget as HTMLButtonElement;
      const status = document.getElementById('fixer-status')!;
      const changed = fitted.filter(s => {
        const d = draft[s.label];
        return d && (Math.abs(d.start - s.start) > 2 || Math.abs(d.end - s.end) > 2);
      });
      if (!changed.length) { status.textContent = 'No changes to propose'; return; }
      btn.disabled = true;
      try {
        let allAccepted = true;
        for (const s of changed) {
          const d = draft[s.label];
          const res = await propose(slug, {
            kind: 'boundary',
            anchor: s.label,
            original: JSON.stringify({ start: Math.round(s.start), end: Math.round(s.end) }),
            proposed: JSON.stringify({ start: d.start, end: d.end }),
            startS: d.start,
            endS: d.end,
          });
          if (!res.accepted) allAccepted = false;
        }
        track('boundary.propose', slug, { count: changed.length });

        // An accepted correction is the live timing, so the waveform, the jump
        // buttons and the transcript all move to it now rather than on reload.
        // A pending one shows up in the proposals panel instead.
        if (allAccepted) {
          fitted = fitted
            .map(s => (draft[s.label]
              ? { ...s, start: draft[s.label].start, end: draft[s.label].end, confidence: 1 }
              : s))
            .sort((a, b) => a.start - b.start);
        }
        applyFitted(fitted);
        status.textContent = '';
        closeFixer();
        await loadTimingProposals();
        if (!allAccepted) openProposedPanel();
      } catch (ex) {
        status.textContent = ex instanceof NotSignedIn ? 'Sign in first' : 'Could not submit';
        if (ex instanceof NotSignedIn) document.dispatchEvent(new CustomEvent('gt:open-signin'));
      } finally {
        btn.disabled = false;
      }
    });

    /**
     * Open timing corrections, with the same up and down votes the transcript
     * margin gives text corrections. Timings are the part of a round people
     * most often need to fix, so they need a way to settle them between
     * themselves rather than waiting on an admin.
     *
     * Ticking one applies it here and now, which is the only honest way to
     * judge a timing: you have to hear it. That is a local try, not a vote, so
     * it changes nothing for anyone else.
     */
    let openProposals: Proposal[] = [];
    const tried = new Set<string>();

    async function loadTimingProposals() {
      const box = document.getElementById('timing-votes');
      const list = document.getElementById('timing-list');
      const toggle = document.getElementById('toggle-proposed');
      if (!box || !list || !toggle) return;

      const all = await listProposals(slug).catch(() => ({ proposals: [] as Proposal[] }));
      openProposals = all.proposals.filter(p => p.kind === 'boundary' && p.status === 'open');

      const n = openProposals.length;
      toggle.hidden = n === 0;
      toggle.textContent = `Proposed timings (${n})`;
      if (n === 0) {
        box.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        tried.clear();
      }

      // A proposal that was accepted or withdrawn while being tried stops
      // counting towards what is drawn.
      for (const id of [...tried]) {
        if (!openProposals.some(p => p.id === id)) tried.delete(id);
      }

      renderTimingRows();
      applyTried();
    }

    function spanOf(p: Proposal): { from: Span; to: Span } | null {
      const current = fitted.find(s => s.label === p.anchor);
      const from = parseSpan(p.original, current) ?? (current ? { start: current.start, end: current.end } : null);
      const to = parseSpan(p.proposed, current);
      return from && to ? { from, to } : null;
    }

    /**
     * The ticked spans that can actually be applied, plus the ones that cannot.
     * Resolution follows tick order and keeps what already fits, so ticking a
     * timing that clashes refuses that one rather than throwing out the
     * selection someone has already built up. A Set iterates in insertion
     * order, which is what makes that possible.
     */
    function triedMoves(): { applied: Map<string, Span>; refused: string[] } {
      const applied = new Map<string, Span>();
      const refused: string[] = [];

      for (const id of tried) {
        const p = openProposals.find(x => x.id === id);
        const span = p ? spanOf(p) : null;
        if (!p || !span) continue;

        const candidate = new Map(applied);
        candidate.set(p.anchor, span.to);
        if (conflicts(fitted, candidate).size > 0) refused.push(p.anchor);
        else applied.set(p.anchor, span.to);
      }
      return { applied, refused };
    }

    function renderTimingRows() {
      const list = document.getElementById('timing-list');
      if (!list) return;
      const refused = new Set(triedMoves().refused);
      list.innerHTML = '';

      for (const p of openProposals) {
        const span = spanOf(p);
        const li = document.createElement('li');
        li.className = 'timing-row';
        if (refused.has(p.anchor)) li.dataset.clashes = '1';

        const tick = document.createElement('input');
        tick.type = 'checkbox';
        tick.className = 'timing-tick';
        tick.checked = tried.has(p.id);
        tick.disabled = !span;
        tick.id = `try-${p.id}`;
        tick.addEventListener('change', () => {
          if (tick.checked) tried.add(p.id); else tried.delete(p.id);
          renderTimingRows();
          applyTried();
        });

        const label = document.createElement('label');
        label.className = 'timing-label';
        label.htmlFor = tick.id;
        label.textContent = p.anchor;

        const move = document.createElement('span');
        move.className = 'timing-move';
        move.textContent = span
          ? `${describe(span.from)} to ${describe(span.to)}`
          : 'unreadable timing';

        const up = document.createElement('button');
        up.className = 'vote'; up.textContent = '+';
        up.setAttribute('aria-label', `Agree with the ${p.anchor} timing`);
        const score = document.createElement('span');
        score.className = 'proposal-score'; score.textContent = String(p.score);
        const down = document.createElement('button');
        down.className = 'vote'; down.textContent = '−';
        down.setAttribute('aria-label', `Disagree with the ${p.anchor} timing`);
        const who = document.createElement('span');
        who.className = 'timing-author';
        who.textContent = p.author;

        const cast = async (value: 1 | -1) => {
          try {
            const r = await vote(p.id, value);
            score.textContent = String(r.score);
            if (r.accepted) await adoptRevisions();
          } catch (ex) {
            if (ex instanceof NotSignedIn) document.dispatchEvent(new CustomEvent('gt:open-signin'));
          }
        };
        up.addEventListener('click', () => cast(1));
        down.addEventListener('click', () => cast(-1));

        // Hovering shows where the speech would move, against where it is now.
        if (span) {
          li.addEventListener('pointerenter', () => wave.setPreview({
            label: p.anchor, from: span.from, to: span.to,
          }));
          li.addEventListener('pointerleave', () => wave.setPreview(null));
        }

        li.append(tick, label, move, up, score, down, who);
        list.appendChild(li);
      }
    }

    /**
     * Draws the ticked timings over the accepted ones, here and in the
     * transcript. A set that would overlap or invert a speech is refused: it
     * would produce a round that could not have happened.
     */
    function applyTried() {
      const note = document.getElementById('timing-conflict')!;
      const { applied, refused } = triedMoves();

      note.hidden = refused.length === 0;
      if (refused.length) {
        note.textContent = `${refused.join(', ')} would overlap another speech, `
          + `so ${refused.length === 1 ? 'it is' : 'they are'} not applied.`;
      }

      applyFitted(withSpans(fitted, applied), applied.size > 0);
    }

    /** Re-reads accepted timings and repaints everything that shows them. */
    async function adoptRevisions() {
      const res = await listRevisions(slug).catch(() => null);
      if (!res) return;
      fitted = applyBoundaries(fitted, res.revisions);
      await loadTimingProposals();
    }

    function describe(span: Span): string {
      return `${formatTime(span.start)}–${formatTime(span.end)}`;
    }

    function setProposedPanel(open: boolean) {
      const btn = document.getElementById('toggle-proposed');
      const box = document.getElementById('timing-votes')!;
      box.hidden = !open;
      btn?.setAttribute('aria-expanded', String(open));
      if (!open) {
        // Closing puts the round back on its accepted timings.
        tried.clear();
        wave.setPreview(null);
        renderTimingRows();
        applyTried();
      }
    }

    function openProposedPanel() {
      if (!document.getElementById('toggle-proposed')?.hidden) setProposedPanel(true);
    }

    document.getElementById('toggle-proposed')?.addEventListener('click', () => {
      setProposedPanel(document.getElementById('timing-votes')!.hidden);
    });

    const ro = new ResizeObserver(() => wave.resize());
    ro.observe(canvas);
  }
</script>
