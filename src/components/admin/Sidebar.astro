---
/**
 * The console's sidebar: the mark, the sections in quiet groups, and the
 * signed-in account at the foot. Below 720 px it is a bar with a Menu button
 * that opens the same list over the page.
 *
 * Links are hashes so a section can be bookmarked and sent (`/admin/#users`);
 * the counts beside a section are filled in by the console once it knows them.
 */
import { SECTIONS } from '../../lib/admin/sections';

const groups: Array<{ name: string | null; items: typeof SECTIONS }> = [];
for (const s of SECTIONS) {
  const last = groups[groups.length - 1];
  if (last && last.name === s.group) last.items.push(s);
  else groups.push({ name: s.group, items: [s] });
}
---

<nav class="adm-side" aria-label="Admin console">
  <div class="adm-side-top">
    <a class="adm-logo" href="/">
      <span class="wordmark wordmark-sm">the golden turn</span>
    </a>
    <button class="adm-side-menu" type="button" aria-expanded="false" aria-controls="adm-side-list">
      Menu
    </button>
  </div>
  <div class="adm-side-list" id="adm-side-list">
    {groups.map(g => (
      <div class="adm-side-group">
        {g.name && <h2>{g.name}</h2>}
        {g.items.map(s => (
          <a href={`#${s.id}`} data-nav={s.id}>
            <span>{s.label}</span>
            <span class="adm-side-count" data-count={s.id}></span>
          </a>
        ))}
      </div>
    ))}
    <div class="adm-side-group">
      <h2>Site</h2>
      <a href="/recordings">Recordings</a>
      <a href="/me">Your account</a>
    </div>
  </div>
  <div class="adm-side-foot">
    <span class="adm-side-user" id="adm-user"></span>
    <button type="button" id="adm-signout" hidden>Sign out</button>
  </div>
</nav>
